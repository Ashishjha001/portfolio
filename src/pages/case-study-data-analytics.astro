      <div class="eyebrow">Case Study &middot; Data &amp; Analytics</div>
      <h1>Supply Chain Visibility &amp; Demand Intelligence</h1>
      <div class="cs-meta">
        <div class="cs-meta-item"><div class="cs-meta-label">Industry</div><div class="cs-meta-value">Manufacturing &amp; Distribution</div></div>
        <div class="cs-meta-item"><div class="cs-meta-label">Area</div><div class="cs-meta-value">Data Architecture, Demand Analytics</div></div>
