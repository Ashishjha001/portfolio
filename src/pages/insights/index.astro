---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const insights = (await getCollection('insights')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
const measurementClusterName = 'Measurement & Lead-Source Truth';
const measurementClusterEntries = insights.filter(
  (entry) => entry.data.cluster === measurementClusterName,
);
const measurementPillar = measurementClusterEntries.find((entry) => entry.data.pillar);
const measurementSupporting = measurementClusterEntries
  .filter((entry) => !entry.data.pillar)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const demoClusterName = 'B2B SaaS Demo-Funnel Diagnosis';
const demoClusterEntries = insights.filter((entry) => entry.data.cluster === demoClusterName);
const demoPillar = demoClusterEntries.find((entry) => entry.data.pillar);
const demoSupporting = demoClusterEntries
  .filter((entry) => !entry.data.pillar)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const clusteredNames = new Set([measurementClusterName, demoClusterName]);
const otherInsights = insights.filter((entry) => !clusteredNames.has(entry.data.cluster ?? ''));
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(
    date,
  );
---

<BaseLayout
  title="Measurement and AI-search insights — DataDecision"
  description="Practical DataDecision guides for reconciling GA4, CRM and revenue data, governing campaign sources and measuring AI-search visibility."
  path="/insights/"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Insights' }]} />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy">
      <p class="eyebrow">Insights</p>
      <h1>Practical guidance for decisions your dashboards cannot settle.</h1>
      <p class="lede">
        Concise, sourced guides for reconciling lead data, measuring discovery and repairing the
        path into pipeline.
      </p>
    </div>
    <aside class="page-hero__aside">
      <div class="folio">
        <span>Published library</span><span
          >{insights.length.toString().padStart(2, '0')} complete</span
        >
      </div>
      <div class="caveat">
        <span class="evidence-label">Editorial standard</span>
        Each note answers one operational question, names its evidence boundary and links to the source
        documentation.
      </div>
    </aside>
  </header>

  <section class="section">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">{measurementClusterName}</p>
        <h2>Start with the reconciliation problem.</h2>
        <p class="small">
          One foundational guide and five focused checks connect website activity to CRM records,
          opportunity and revenue.
        </p>
      </div>
      <div>
        {
          measurementPillar && (
            <a class="cluster-pillar" href={`/insights/${measurementPillar.id}/`}>
              <span class="evidence-label">Foundational guide / 01</span>
              <h2>{measurementPillar.data.title}</h2>
              <p>{measurementPillar.data.description}</p>
              <span class="cluster-pillar__meta">
                Published {formatDate(measurementPillar.data.publishedDate)} ·{' '}
                {measurementPillar.data.readingMinutes} min read
              </span>
            </a>
          )
        }
        <div
          class="insight-index cluster-support-list"
          aria-label="Measurement and Lead-Source Truth supporting insights"
        >
          {
            measurementSupporting.map((entry, index) => (
              <a class="insight-row" href={`/insights/${entry.id}/`}>
                <span class="mono">{String(index + 2).padStart(2, '0')} / Supporting insight</span>
                <div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </div>
                <span class="small">
                  {formatDate(entry.data.publishedDate)}
                  <br />
                  {entry.data.readingMinutes} min read
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bright">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">{demoClusterName}</p>
        <h2>Find the first break between demand and a held meeting.</h2>
        <p class="small">
          One diagnostic framework and five focused checks connect qualified visits to requests,
          routing, booked meetings and pipeline.
        </p>
      </div>
      <div>
        {
          demoPillar && (
            <a class="cluster-pillar" href={`/insights/${demoPillar.id}/`}>
              <span class="evidence-label">Foundational guide / 01</span>
              <h2>{demoPillar.data.title}</h2>
              <p>{demoPillar.data.description}</p>
              <span class="cluster-pillar__meta">
                Published {formatDate(demoPillar.data.publishedDate)} ·{' '}
                {demoPillar.data.readingMinutes} min read
              </span>
            </a>
          )
        }
        <div
          class="insight-index cluster-support-list"
          aria-label="B2B SaaS Demo-Funnel Diagnosis supporting insights"
        >
          {
            demoSupporting.map((entry, index) => (
              <a class="insight-row" href={`/insights/${entry.id}/`}>
                <span class="mono">{String(index + 2).padStart(2, '0')} / Supporting insight</span>
                <div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </div>
                <span class="small">
                  {formatDate(entry.data.publishedDate)}
                  <br />
                  {entry.data.readingMinutes} min read
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    otherInsights.length > 0 && (
      <section class="section">
        <div class="shell editorial-grid">
          <div class="section-intro">
            <p class="eyebrow">More research notes</p>
            <h2>AI discovery, access and implementation.</h2>
            <p class="small">
              Additional DataDecision guidance remains available in the same library.
            </p>
          </div>
          <div class="insight-index">
            {otherInsights.map((entry, index) => (
              <a class="insight-row" href={`/insights/${entry.id}/`}>
                <span class="mono">
                  {String(index + 1).padStart(2, '0')} / {entry.data.category}
                </span>
                <div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </div>
                <span class="small">
                  Updated {formatDate(entry.data.updatedDate)}
                  <br />
                  {entry.data.readingMinutes} min read
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">Templates</p>
        <h2>Use the method with your own data.</h2>
      </div>
      <div>
        <p class="lede">
          Download the baseline template to frame buyer questions, record observations and keep the
          comparison consistent across dates.
        </p>
        <div class="button-row">
          <a
            class="button"
            href="/downloads/ai-visibility-baseline-template.csv"
            data-event="template_download">Download baseline template</a
          >
          <a class="text-link" href="/methodology/">Read the method</a>
        </div>
      </div>
    </div>
  </section>
  <FinalCTA heading="Turn a measurement question into a scoped brief." />
</BaseLayout>
