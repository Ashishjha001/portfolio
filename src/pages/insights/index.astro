---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import StrategicAreas from '../../components/StrategicAreas.astro';
import InsightCard from '../../components/InsightCard.astro';
import FeaturedInsightCard from '../../components/FeaturedInsightCard.astro';
import { getInsightImage } from '../../data/insightImages';

const insights = (await getCollection('insights')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);

const measurementClusterName = 'Measurement & Lead-Source Truth';
const demoClusterName = 'B2B SaaS Demo-Funnel Diagnosis';
const playbooksClusterName = 'Service Playbooks';

const clusters = [
  {
    id: 'cluster-measurement',
    index: '01',
    name: measurementClusterName,
    heading: 'Start with the reconciliation problem.',
    note: 'One foundational guide and focused checks connect website activity to CRM records, opportunity and revenue.',
  },
  {
    id: 'cluster-demo',
    index: '02',
    name: demoClusterName,
    heading: 'Find the first break between demand and a held meeting.',
    note: 'A diagnostic framework and focused checks connect qualified visits to requests, routing, booked meetings and pipeline.',
  },
  {
    id: 'cluster-playbooks',
    index: '03',
    name: playbooksClusterName,
    heading: 'How Data Decision Consulting implements every service, step by step.',
    note: 'Complete implementation playbooks for each pillar: what the team builds, in what order, with the artifacts and limits stated.',
  },
];

function clusterEntries(name: string) {
  const entries = insights.filter((entry) => entry.data.cluster === name);
  const pillar = entries.find((entry) => entry.data.pillar);
  const supporting = entries
    .filter((entry) => !entry.data.pillar)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
  return { pillar, supporting };
}

const measurement = clusterEntries(measurementClusterName);
const demo = clusterEntries(demoClusterName);
const playbooks = clusterEntries(playbooksClusterName);
const clusterMap = new Map([
  [measurementClusterName, measurement],
  [demoClusterName, demo],
  [playbooksClusterName, playbooks],
]);
const clusteredNames = new Set([measurementClusterName, demoClusterName, playbooksClusterName]);
const otherInsights = insights.filter((entry) => !clusteredNames.has(entry.data.cluster ?? ''));

const orderedClusterEntries = clusters.flatMap(({ name }) => {
  const { pillar, supporting } = clusterMap.get(name)!;
  return [...(pillar ? [pillar] : []), ...supporting];
});
const orderedEntries = [...orderedClusterEntries, ...otherInsights];
const imageIndexById = new Map(orderedEntries.map((entry, index) => [entry.id, index]));
const imageForEntry = (id: string) => getInsightImage(imageIndexById.get(id) ?? 0);
---

<BaseLayout
  title="Measurement and AI-search insights | Data Decision Consulting"
  description="Practical Data Decision Consulting guides for reconciling GA4, CRM and revenue data, governing campaign sources and measuring AI-search visibility."
  path="/insights/"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Insights' }]} />
  <header class="shell page-hero page-hero--compact page-hero--single insights-hero">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">Insights</p>
      <h1>Practical guidance for decisions your dashboards cannot settle.</h1>
      <p class="lede">
        Concise, sourced guides for reconciling lead data, measuring discovery and repairing the
        path into pipeline.
      </p>
    </div>
  </header>

  <StrategicAreas heading="Explore the library through the decision you are trying to make." />

  <!-- Cluster browse chips: anchor navigation (crawlable, JS-free) -->
  <nav class="shell insight-browse" aria-label="Browse insights by strategic area">
    <a class="insight-browse__chip" href="#cluster-measurement">Measurement &amp; attribution</a>
    <a class="insight-browse__chip" href="#cluster-demo">Demo-funnel diagnosis</a>
    <a class="insight-browse__chip" href="#cluster-playbooks">Service playbooks</a>
    <a class="insight-browse__chip" href="#cluster-more">Strategic &amp; technical guides</a>
    <span class="insight-browse__count mono" aria-label="Total published insights">
      {insights.length} insights · 4 areas
    </span>
  </nav>

  {
    clusters.map((cluster) => {
      const { pillar, supporting } = clusterMap.get(cluster.name)!;
      return (
        <section
          class="section insights-section"
          aria-labelledby={`${cluster.id}-heading`}
          id={cluster.id}
        >
          <span class="chapter-mark" aria-hidden="true">
            {cluster.index}
          </span>
          <div class="shell">
            <div class="section-intro insights-section__intro" data-reveal>
              <p class="cluster-index">Cluster {cluster.index}</p>
              <p class="eyebrow">{cluster.name}</p>
              <h2 id={`${cluster.id}-heading`}>{cluster.heading}</h2>
              <p class="small">{cluster.note}</p>
              <p class="mono insight-cluster-count">
                {supporting.length + (pillar ? 1 : 0)} insights in this cluster
              </p>
            </div>
            <div class="insight-cards">
              {pillar &&
                (() => {
                  const image = imageForEntry(pillar.id);
                  return (
                    <FeaturedInsightCard
                      href={`/insights/${pillar.id}/`}
                      category={pillar.data.category}
                      typeLabel="Foundational guide"
                      title={pillar.data.title}
                      excerpt={pillar.data.description}
                      date={pillar.data.publishedDate}
                      dateLabel="Published"
                      readingMinutes={pillar.data.readingMinutes}
                      image={image.src}
                      imagePosition={image.position}
                    />
                  );
                })()}
              {supporting.map((entry, i) => {
                const image = imageForEntry(entry.id);
                return (
                  <InsightCard
                    href={`/insights/${entry.id}/`}
                    category={entry.data.category}
                    typeLabel="Supporting insight"
                    title={entry.data.title}
                    excerpt={entry.data.description}
                    date={entry.data.publishedDate}
                    dateLabel="Published"
                    readingMinutes={entry.data.readingMinutes}
                    index={i % 3}
                    image={image.src}
                    imagePosition={image.position}
                  />
                );
              })}
            </div>
          </div>
        </section>
      );
    })
  }

  {
    otherInsights.length > 0 && (
      <section
        class="section section--bright insights-section"
        aria-labelledby="more-heading"
        id="cluster-more"
      >
        <span class="chapter-mark" aria-hidden="true">
          04
        </span>
        <div class="shell">
          <div class="section-intro insights-section__intro" data-reveal>
            <p class="cluster-index">Cluster 04</p>
            <p class="eyebrow">Strategic and technical guides</p>
            <h2 id="more-heading">Growth, performance, SEO and AI-search guidance.</h2>
            <p class="small">
              Additional Data Decision Consulting guidance remains available in the same published
              library.
            </p>
            <p class="mono insight-cluster-count">{otherInsights.length} insights in this area</p>
          </div>
          <div class="insight-cards">
            {otherInsights.map((entry, i) => {
              const image = imageForEntry(entry.id);
              return (
                <InsightCard
                  href={`/insights/${entry.id}/`}
                  category={entry.data.category}
                  typeLabel={entry.data.featured ? 'Featured guide' : 'Insight'}
                  title={entry.data.title}
                  excerpt={entry.data.description}
                  date={entry.data.updatedDate}
                  dateLabel="Updated"
                  readingMinutes={entry.data.readingMinutes}
                  index={i % 3}
                  image={image.src}
                  imagePosition={image.position}
                />
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--bright" aria-labelledby="templates-heading">
    <span class="chapter-mark" aria-hidden="true">05</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Templates</p>
        <h2 id="templates-heading">Use the method with your own data.</h2>
      </div>
      <div data-reveal style="--reveal-delay:110ms">
        <p class="lede">
          Download the baseline template to frame buyer questions, record observations and keep the
          comparison consistent across dates.
        </p>
        <div class="button-row">
          <a
            class="button button--primary"
            href="/downloads/ai-visibility-baseline-template.csv"
            data-event="template_download">Download baseline template</a
          >
          <a class="text-link" href="/methodology/">Read the method</a>
        </div>
      </div>
    </div>
  </section>
  <FinalCTA heading="Turn a measurement question into a scoped brief." />
</BaseLayout>

<style>
  .insights-hero {
    padding-block: clamp(2.8rem, 5vw, 5rem);
  }

  .insights-hero .page-hero__copy h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 5.4vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .insights-hero .lede {
    max-width: 58ch;
  }

  .insight-browse {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    padding-block: 1.15rem;
    border-block: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }

  .insight-browse__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.55em 1em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  .insight-browse__chip:hover,
  .insight-browse__chip:focus-visible {
    background: var(--green);
    color: var(--paper);
    border-color: var(--green);
  }

  .insight-browse__chip:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 2px;
  }

  .insight-browse__count {
    margin-left: auto;
    color: var(--faint);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .insight-browse__count {
      margin-left: 0;
      width: 100%;
    }
  }

  .insight-cluster-count {
    color: var(--faint);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.8rem;
  }

  .insights-section {
    padding-block: clamp(3.4rem, 5.5vw, 5.5rem);
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  .insights-section__intro {
    position: static;
    max-width: 62rem;
    padding-bottom: clamp(0.4rem, 1.5vw, 1rem);
  }

  .insights-section__intro h2 {
    max-width: 21ch;
    font-size: clamp(2rem, 3.8vw, 3.7rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .insights-section__intro .small {
    max-width: 62ch;
    font-size: clamp(0.94rem, 1.15vw, 1.05rem);
  }

  @media (max-width: 767px) {
    .insights-hero {
      padding-block: 2.6rem 3.4rem;
    }

    .insights-hero .page-hero__copy h1 {
      font-size: clamp(2.55rem, 12vw, 4rem);
      line-height: 1;
    }

    .insight-browse {
      gap: 0.5rem;
      padding-block: 1rem;
    }

    .insight-browse__chip {
      padding: 0.62em 0.82em;
      font-size: 0.6rem;
    }

    .insights-section {
      padding-block: 3.2rem;
    }

    .insights-section__intro h2 {
      font-size: clamp(2rem, 9vw, 2.8rem);
    }
  }
</style>
