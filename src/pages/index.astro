                    <h4>Decide</h4>
                    <p>Translate evidence into clear strategic options and actionable recommendations.</p>
                </div>
                <div class="step-item" data-index="3">
                    <span class="step-num">04</span>
                    <h4>Execute</h4>
                    <p>Turn recommendations into practical systems, dashboards, workflows, and actions.</p>
                </div>
                <div class="step-item" data-index="4">
                    <span class="step-num">05</span>
                    <h4>Measure</h4>
                    <p>Track outcomes against baseline metrics and continuously improve.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Industries & About -->
<section id="industries" class="py-section border-bottom">
    <div class="container grid-2">
        <!-- Industries -->
