                <button class="flow-btn" data-index="1">Insight</button>
                <span class="flow-arrow">→</span>
                <button class="flow-btn" data-index="2">Decision</button>
                <span class="flow-arrow">→</span>
                <button class="flow-btn" data-index="3">Action</button>
