---
import BaseLayout from '../layouts/BaseLayout.astro';
import MethodBadge from '../components/MethodBadge.astro';
import DecisionBoard from '../components/DecisionBoard.astro';
import HomepageDecisionMap from '../components/HomepageDecisionMap.astro';
import FAQList from '../components/FAQList.astro';
import FinalCTA from '../components/FinalCTA.astro';

const faqs = [
  {
    question: 'Can you guarantee placement or citations in AI answers?',
    answer:
      'No. AI answers are nondeterministic and change with the engine, query, session and time. We document what appeared within the sampled window, repeat runs where the method calls for it, and never sell a ranking promise.',
  },
  {
    question: 'Which surfaces does the diagnostic cover?',
    answer:
      'The default scope covers up to four approved search and AI surfaces where access permits. The final engine set, access conditions and observation protocol are written into the methodology record before collection begins.',
  },
  {
    question: 'Is this SEO with a new name?',
    answer:
      'Some foundations overlap: crawl access, useful content, technical clarity and external authority still matter. The additional work is a sampled answer-layer baseline, source observation, prompt-frame design and a measurement path into conversion and pipeline.',
  },
  {
    question: 'What is included in the standard scope?',
    answer:
      'Fifty buying-intent queries, one market, one language, up to four surfaces where access permits, two documented runs where methodologically appropriate, a technical access review, measurement-gap review and prioritized 90-day action plan.',
  },
  {
    question: 'How long does it take?',
    answer:
      'The standard delivery window is 15 business days after the required inputs are complete and the written scope is confirmed.',
  },
  {
    question: 'Do you manage paid media?',
    answer:
      'The launch focus is AI-search visibility, measurement foundations and tightly scoped post-diagnostic implementation. Paid channels may appear in a recommendation when the evidence makes them relevant, but paid-media management is outside the current service scope.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="DataDecision — Measurement-first AI-search visibility for B2B SaaS"
  description="DataDecision helps B2B SaaS teams measure how they appear across search and AI answers, identify measurement gaps and decide what to improve next."
  path="/"
  schema={schema}
>
  <div class="shell">
    <section class="page-hero">
      <div class="page-hero__copy">
        <p class="eyebrow">For B2B SaaS growth teams</p>
        <h1>See how your SaaS appears across search and AI answers.</h1>
        <p class="lede">
          Build a repeatable visibility baseline, repair the measurement gaps between discovery and
          pipeline, and decide what to improve next.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="/contact/" data-event="cta_primary_click">
            Request a visibility diagnostic
          </a>
          <a class="text-link" href="/methodology/" data-event="methodology_cta_click">
            See how we measure
          </a>
        </div>
      </div>
      <aside class="page-hero__aside" aria-label="Default diagnostic scope">
        <div class="folio"><span>Diagnostic / default scope</span><span>01—04</span></div>
        <dl class="evidence-list">
          <div class="evidence-line">
            <dt class="evidence-line__number">50</dt>
            <dd>
              <strong>Buying-intent queries</strong><small
                >One market · one language · dated observations</small
              >
            </dd>
          </div>
          <div class="evidence-line">
            <dt class="evidence-line__number">04</dt>
            <dd>
              <strong>Approved answer surfaces</strong><small
                >Where access permits; collection conditions recorded</small
              >
            </dd>
          </div>
          <div class="evidence-line">
            <dt class="evidence-line__number">02</dt>
            <dd>
              <strong>Documented runs</strong><small
                >Where repetition is methodologically appropriate</small
              >
            </dd>
          </div>
        </dl>
        <div class="caveat">
          <span class="evidence-label">How to read it</span>
          The findings describe the agreed query set, surfaces and observation window.
        </div>
      </aside>
    </section>

    <section class="credibility-strip" aria-label="How DataDecision establishes credibility">
      <div class="credibility-strip__item">
        <strong>Evidence that can be inspected.</strong>
        <span>The method carries the argument.</span>
      </div>
      <div class="credibility-strip__item">
        <span class="evidence-label">Published method</span>
        <span>Versioned, linked and explicit about limitations.</span>
      </div>
      <div class="credibility-strip__item">
        <span class="evidence-label">Clear evidence labels</span>
        <span>Demonstration research stays separate from client work.</span>
      </div>
    </section>
  </div>

  <section class="section">
    <div class="shell">
      <div class="editorial-grid">
        <div class="section-intro">
          <p class="eyebrow">The measurement gap</p>
          <h2>Search visibility is no longer one dashboard.</h2>
        </div>
        <p class="lede">
          Conventional search remains important. Discovery now spans more surfaces than most
          reporting systems were designed to observe.
        </p>
      </div>

      <div class="visual-inset">
        <HomepageDecisionMap />
      </div>

      <div class="comparison visual-followup">
        <div>
          <span class="evidence-label">What teams can usually see</span>
          <h3>Rankings, sessions, forms and CRM stages.</h3>
          <ul>
            <li>Useful records, but often separated by scope and ownership.</li>
            <li>Referral detail can be incomplete or grouped too broadly.</li>
            <li>Attribution models describe the assumptions behind each reported total.</li>
          </ul>
        </div>
        <div class="comparison__rule" aria-hidden="true"></div>
        <div>
          <span class="evidence-label">What needs a separate baseline</span>
          <h3>How products appear inside generated answers.</h3>
          <ul>
            <li>Which sampled questions produced a mention or citation.</li>
            <li>Which sources were visible during the observation window.</li>
            <li>Whether a resulting visit can survive the path into pipeline.</li>
          </ul>
        </div>
      </div>
      <div class="annotation" style="margin-top: 2.5rem;">
        <span class="evidence-label">Evidence rule</span>
        <p>
          A single answer is one observation. A baseline is a documented frame that can be repeated
          without quietly changing the question.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--bright">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">The Ledger method</p>
        <h2>Four steps from question to action.</h2>
        <MethodBadge />
      </div>
      <div class="rule-list">
        <div class="rule-row">
          <span class="mono">01</span>
          <div>
            <h3>Frame the query set</h3><p>
              Define buying intent, market, language, competitors and collection conditions before
              checking any result.
            </p>
          </div>
          <span class="rule-row__meta">Inputs locked</span>
        </div>
        <div class="rule-row">
          <span class="mono">02</span>
          <div>
            <h3>Observe the surfaces</h3><p>
              Record dated answers, mentions and sources across the approved engine set inside a
              clearly defined sample.
            </p>
          </div>
          <span class="rule-row__meta">Windowed</span>
        </div>
        <div class="rule-row">
          <span class="mono">03</span>
          <div>
            <h3>Audit the measurement path</h3><p>
              Test whether referral, conversion and CRM records can connect discovery to pipeline.
            </p>
          </div>
          <span class="rule-row__meta">Assumptions shown</span>
        </div>
        <div class="rule-row">
          <span class="mono">04</span>
          <div>
            <h3>Rank the next decisions</h3><p>
              Attach an owner, effort, expected signal, confidence label and stopping rule to each
              recommended action.
            </p>
          </div>
          <span class="rule-row__meta">90-day horizon</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow" style="color:#9fd2bc;">Launch capabilities</p>
        <h2>Focused enough to show the work.</h2>
        <p class="small" style="color:#c8cac5;">
          The launch scope covers AI-search visibility, measurement foundations and defined
          implementation work.
        </p>
      </div>
      <div class="rule-list">
        <div class="rule-row">
          <span class="mono">A</span>
          <div>
            <h3>AI-search visibility diagnostic</h3><p>
              A dated, sampled baseline across approved surfaces, with a source map, competitor
              comparison and prioritized actions.
            </p>
          </div>
          <a class="rule-row__meta" href="/services/ai-search-visibility/">Read capability ↗</a>
        </div>
        <div class="rule-row">
          <span class="mono">B</span>
          <div>
            <h3>Measurement foundation</h3><p>
              Tracking plan, referral visibility, CRM linkage and an assumption register that makes
              reporting easier to challenge.
            </p>
          </div>
          <a class="rule-row__meta" href="/services/measurement-foundation/">Read capability ↗</a>
        </div>
        <div class="rule-row">
          <span class="mono">C</span>
          <div>
            <h3>Conversion and visibility recommendations</h3><p>
              Audit-grade recommendations inside every engagement, ordered by evidence, effort and
              expected signal.
            </p>
          </div>
          <span class="rule-row__meta">Diagnostic output</span>
        </div>
        <div class="rule-row">
          <span class="mono">D</span>
          <div>
            <h3>Scoped implementation sprint</h3><p>
              A fixed post-diagnostic sprint for a defined measurement or answer-readiness problem,
              with its own boundaries and acceptance criteria.
            </p>
          </div>
          <span class="rule-row__meta">Post-diagnostic only</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">Evidence format</p>
        <h2>Every recommendation answers four questions.</h2>
        <p class="small">
          What did we observe? What did the data miss? What should happen next? What can the
          evidence not prove?
        </p>
      </div>
      <div>
        <DecisionBoard />
        <div class="button-row">
          <a class="text-link" href="/work/" data-event="benchmark_view">Open the work ledger</a>
          <a class="text-link" href="/methodology/">Read the evidence standard</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="editorial-grid editorial-grid--balanced" style="margin-bottom: 3.25rem;">
        <div class="section-intro">
          <p class="eyebrow">Process and scope</p>
          <h2>A defined scope before kickoff.</h2>
        </div>
        <div>
          <p class="lede">
            The default diagnostic is deliberately narrow enough to repeat. Additions such as larger
            query sets, more markets, more languages or more runs require a written scope change.
          </p>
        </div>
      </div>
      <div class="process-rail">
        <div class="process-rail__step">
          <span class="mono">01 / 15 business days</span><h3>Diagnostic</h3><p>
            Begins after required inputs and the written scope are complete.
          </p>
        </div>
        <div class="process-rail__step">
          <span class="mono">02 / optional</span><h3>Implementation sprint</h3><p>
            Fixed scope selected from the diagnostic, with additions agreed separately.
          </p>
        </div>
        <div class="process-rail__step">
          <span class="mono">03 / optional</span><h3>Measurement cadence</h3><p>
            Repeat observation and decision review only when the signal warrants it.
          </p>
        </div>
      </div>
      <div class="scope-wrap" style="margin-top: 3rem;">
        <table class="scope-table">
          <thead
            ><tr
              ><th>Scope item</th><th>Default</th><th>Boundary</th><th>Commercial treatment</th></tr
            ></thead
          >
          <tbody>
            <tr
              ><td>Query frame</td><td>50 buying-intent queries</td><td
                >One market · one language</td
              ><td>Written fixed fee before kickoff</td></tr
            >
            <tr
              ><td>Observation</td><td>Up to four surfaces; two runs where appropriate</td><td
                >Access and methodology can narrow the final set</td
              ><td>Additional markets, languages or repetitions are add-ons</td></tr
            >
            <tr
              ><td>Outputs</td><td
                >Baseline, source map, comparison, technical review, gaps, 90-day plan</td
              ><td>Recommendations stay within the sampled evidence</td><td
                >Exact fee and any add-ons are stated in the written scope</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="homepage-founder">
    <div class="shell editorial-grid editorial-grid--reverse">
      <div class="section-intro">
        <p class="eyebrow">Founder</p>
        <h2 id="homepage-founder">Accountability has a name.</h2>
      </div>
      <div>
        <p class="lede">
          Ashish Jha founded DataDecision. He is a graduate of NIT Surat and leads the firm’s
          AI-search visibility and measurement work.
        </p>
        <p class="measure">
          Ashish defines the observation frame, reviews the evidence and turns the findings into a
          practical next-step plan. The NIT Surat reference identifies his education and does not
          imply institutional endorsement.
        </p>
        <a class="text-link" href="/about/">Read about Ashish and the operating principles</a>
      </div>
    </div>
  </section>

  <section class="section section--bright">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">Essential questions</p><h2>What a cautious buyer should ask.</h2>
      </div>
      <FAQList items={faqs} />
    </div>
  </section>

  <FinalCTA />
  <div class="mobile-cta" data-mobile-cta hidden>
    <a class="button button--primary" href="/contact/">Request a visibility diagnostic</a>
  </div>
</BaseLayout>
