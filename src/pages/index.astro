---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MethodStory from '../components/MethodStory.astro';
import MethodBadge from '../components/MethodBadge.astro';
import FAQList from '../components/FAQList.astro';
import FinalCTA from '../components/FinalCTA.astro';
import FounderSocialLinks from '../components/FounderSocialLinks.astro';
import LearnArrow from '../components/LearnArrow.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { Search, Sparkles, BarChart3, Megaphone, Globe, Bot } from 'lucide-astro';

const measurementCluster = (await getCollection('insights'))
  .filter((entry) => entry.data.cluster === 'Measurement & Lead-Source Truth')
  .sort((a, b) => {
    if (a.data.pillar !== b.data.pillar) return a.data.pillar ? -1 : 1;
    return a.data.title.localeCompare(b.data.title);
  });
const featuredMeasurementInsights = measurementCluster.slice(0, 3);

const faqs = [
  {
    question: 'Can you guarantee placement or citations in AI answers?',
    answer:
      'No. AI answers are nondeterministic and change with the engine, query, session and time. We document what appeared within the sampled window, repeat runs where the method calls for it, and never sell a ranking promise.',
  },
  {
    question: 'Which surfaces does the diagnostic cover?',
    answer:
      'The default scope covers up to four approved search and AI surfaces where access permits. The final engine set, access conditions and observation protocol are written into the methodology record before collection begins.',
  },
  {
    question: 'What is included in the standard scope?',
    answer:
      'Fifty buying-intent queries, one market, one language, up to four surfaces where access permits, two documented runs where methodologically appropriate, a technical access review, measurement-gap review and prioritized 90-day action plan.',
  },
  {
    question: 'How long does it take?',
    answer:
      'The standard delivery window is 15 business days after the required inputs are complete and the written scope is confirmed.',
  },
];

const methodSteps = [
  {
    index: '01',
    title: 'Frame the question',
    body: 'Define the market, buyer and decision.',
  },
  {
    index: '02',
    title: 'Capture evidence',
    body: 'Record dated answers, sources and signals.',
  },
  {
    index: '03',
    title: 'Connect the data',
    body: 'Trace discovery through CRM and pipeline.',
  },
  {
    index: '04',
    title: 'Prioritize action',
    body: 'Choose the next move, owner and success signal.',
  },
];

const showcaseServices = [
  {
    index: '01',
    href: '/services/seo/',
    icon: Search,
    title: 'SEO Services',
    body: 'Technical SEO, intent-led architecture and topical depth that turn rankings into qualified pipeline.',
    label: 'SEO services',
    tone: 'search',
  },
  {
    index: '02',
    href: '/services/ai-search-visibility/',
    icon: Sparkles,
    title: 'AI Search Visibility',
    body: 'Get recommended by ChatGPT, Gemini and AI Overviews: measured baselines, no placement guarantees.',
    label: 'AEO & GEO',
    tone: 'visibility',
  },
  {
    index: '03',
    href: '/services/measurement-foundation/',
    icon: BarChart3,
    title: 'GA4 & Attribution',
    body: 'Reconcile GA4 with your CRM, repair source capture and end the dashboard disagreements.',
    label: 'Measurement',
    tone: 'measurement',
  },
  {
    index: '04',
    href: '/services/#paid-acquisition-performance',
    icon: Megaphone,
    title: 'Paid Media & Demand',
    body: 'Google, Meta and LinkedIn campaigns built around qualified pipeline, creative testing and clear CAC targets.',
    label: 'Paid acquisition',
    tone: 'paid',
  },
  {
    index: '05',
    href: '/services/#ai-agent-development',
    icon: Bot,
    title: 'Custom AI Agents',
    body: 'Purpose-built agents for research, qualification, reporting and internal workflows, with human review and guardrails.',
    label: 'AI automation',
    tone: 'agents',
  },
  {
    index: '06',
    href: '/services/website-development-seo/',
    icon: Globe,
    title: 'Website Development',
    body: 'Complete websites with SEO, schema and measurement built in from day one: like this one.',
    label: 'Build + SEO',
    tone: 'build',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="B2B SaaS Growth & SEO Consultancy | Data Decision Consulting"
  description="Founder-led growth and SEO consultancy for B2B SaaS: SEO and AI-search visibility services, GA4 measurement and attribution consulting, paid acquisition and conversion: evidence-first, no guarantees."
  path="/"
  schema={schema}
>
  <!-- Chapter 01: Opening statement -->
  <section class="hero" data-chapter aria-label="Introduction">
    <span class="chapter-mark" aria-hidden="true">01</span>
    <HeroMedia />
    <div class="shell hero__layout">
      <div class="hero__copy">
        <p class="eyebrow t-stagger">
          <span class="t-stagger-line t-stagger-line--1">AI Search × SEO × Growth</span>
        </p>
        <h1 class="hero__title hero__title--rotator">
          <span class="sr-only">
            Growth you can prove: SEO, AI-search visibility and measurement consulting for B2B SaaS.
            Data Decision Consulting builds complete growth engines for B2B SaaS.
          </span>
          <span aria-hidden="true">
            <span class="line" style="--line:0"><span>Get Recommended by</span></span>
            <span class="line rotator" style="--line:1" data-rotator data-platform="chatgpt">
              <span class="rotator__word is-current" data-platform="chatgpt">ChatGPT</span>
              <span class="rotator__word" data-platform="overviews" hidden>AI Overviews</span>
              <span class="rotator__word" data-platform="gemini" hidden>Gemini</span>
              <span class="rotator__word" data-platform="claude" hidden>Claude</span>
              <span class="rotator__word" data-platform="grok" hidden>Grok</span>
            </span>
          </span>
        </h1>
        <div class="button-row hero__actions" data-reveal style="--reveal-delay:220ms">
          <a
            class="button button--primary"
            href="/contact/?service=web-seo-ai-visibility#request-a-brief"
            data-event="cta_primary_click"
          >
            Get Your Free AI Visibility Audit
          </a>
          <a class="text-link" href="/methodology/" data-event="methodology_cta_click">
            See How It Works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 01b: Services showcase -->
  <section class="showcase" aria-labelledby="showcase-heading">
    <div class="shell">
      <div class="showcase__head">
        <p class="eyebrow">What we build</p>
        <h2 id="showcase-heading" class="t-stagger">
          <span class="t-stagger-line t-stagger-line--1">One growth engine.</span>
          <span class="t-stagger-line t-stagger-line--2">Six ways it compounds.</span>
        </h2>
      </div>
      <div class="showcase__grid">
        {
          showcaseServices.map((service) => (
            <ShowcaseCard
              href={service.href}
              index={service.index}
              title={service.title}
              body={service.body}
              label={service.label}
              tone={service.tone}
            >
              <service.icon strokeWidth={1.75} aria-hidden="true" />
            </ShowcaseCard>
          ))
        }
      </div>
      <div style="text-align: center; margin-top: clamp(1.6rem, 3vw, 2.4rem);">
        <a class="button button--primary" href="/services/" data-event="showcase_all_services">
          Compare all six services
        </a>
      </div>
    </div>
  </section>

  <!-- Chapter 02: Method -->
  <section
    class="section section--ink home-method"
    data-chapter
    aria-labelledby="home-method-heading"
  >
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell home-method__layout">
      <div class="home-method__head">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">The method</p>
          <h2 id="home-method-heading">Four steps. One clear decision.</h2>
        </div>
        <div class="home-method__actions" data-reveal style="--reveal-delay:90ms">
          <MethodBadge />
          <a class="text-link" href="/methodology/">See the complete method</a>
        </div>
      </div>
      <MethodStory steps={methodSteps} />
    </div>
  </section>

  <!-- Free tools card -->
  <section class="section section--compact tools-card-section" aria-labelledby="tools-card-heading">
    <div class="shell">
      <a class="tools-card" href="/tools/" data-event="tools_card_click" data-reveal>
        <span class="tools-card__rule" aria-hidden="true"></span>
        <div class="tools-card__main">
          <span class="tools-card__label mono">
            <span class="tools-card__dot" aria-hidden="true"></span>
            Free tools · No signup · Run in your browser
          </span>
          <h2 id="tools-card-heading">Run our checks yourself. Right now.</h2>
        </div>
        <span class="tools-card__cta" aria-hidden="true">
          Use the free tools
          <LearnArrow />
        </span>
      </a>
    </div>
  </section>

  <!-- Chapter 03: Insights -->
  <section
    class="section section--compact section--bright home-insights-section"
    data-chapter
    aria-labelledby="home-insights-heading"
  >
    <span class="chapter-mark" aria-hidden="true">03</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Measurement &amp; Lead-Source Truth</p>
        <h2 id="home-insights-heading">Resolve the questions between analytics and revenue.</h2>
        <a class="text-link" href="/insights/">Browse all measurement insights</a>
      </div>
      <div class="home-insights">
        {
          featuredMeasurementInsights.map((entry, index) => (
            <a
              class:list={['home-insight', { 'home-insight--featured': entry.data.pillar }]}
              href={`/insights/${entry.id}/`}
              data-reveal
              style={`--reveal-delay:${index * 110}ms`}
            >
              <span class="mono">
                {String(index + 1).padStart(2, '0')} /{' '}
                {entry.data.pillar ? 'Foundational guide' : 'Supporting insight'}
              </span>
              <h3>{entry.data.title}</h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Chapter 04: Process and scope -->
  <section
    class="section section--compact section--ink"
    data-chapter
    aria-labelledby="home-process-heading"
  >
    <span class="chapter-mark" aria-hidden="true">04</span>
    <div class="shell">
      <div class="editorial-grid editorial-grid--balanced" style="margin-bottom: 2rem;">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Process and scope</p>
          <h2 id="home-process-heading">A defined scope before kickoff.</h2>
        </div>
      </div>
      <div class="process-rail">
        <div class="process-rail__step" data-process-step data-reveal>
          <span class="mono">01 / 15 business days</span><h3>Diagnostic</h3><p>
            Written scope and required inputs confirmed.
          </p>
        </div>
        <div class="process-rail__step" data-process-step data-reveal style="--reveal-delay:110ms">
          <span class="mono">02 / optional</span><h3>Implementation sprint</h3><p>
            Fixed scope selected from the findings.
          </p>
        </div>
        <div class="process-rail__step" data-process-step data-reveal style="--reveal-delay:220ms">
          <span class="mono">03 / optional</span><h3>Measurement cadence</h3><p>
            Repeat only when the signal warrants it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 05: Founder -->
  <section
    class="section section--compact section--bright home-founder"
    data-chapter
    aria-labelledby="homepage-founder"
  >
    <span class="chapter-mark" aria-hidden="true">05</span>
    <div class="shell editorial-grid editorial-grid--reverse">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Founder</p>
        <h2 id="homepage-founder">Accountability has a name.</h2>
      </div>
      <div class="founder-band" data-reveal style="--reveal-delay:120ms">
        <div>
          <p class="lede">
            Ashish Jha founded Data Decision Consulting. He is a graduate of NIT Surat and leads the
            firm’s AI-search visibility and measurement work.
          </p>
          <a class="text-link" href="/about/">About Ashish and Data Decision Consulting</a>
          <FounderSocialLinks />
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 06: Questions -->
  <section
    class="section section--compact home-faq"
    data-chapter
    aria-labelledby="home-faq-heading"
  >
    <span class="chapter-mark" aria-hidden="true">06</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Essential questions</p><h2 id="home-faq-heading">
          What a cautious buyer should ask.
        </h2>
      </div>
      <div data-reveal style="--reveal-delay:100ms"><FAQList items={faqs} /></div>
    </div>
  </section>

  <FinalCTA />
  <script>
    /* Hero platform rotator: pauses off-screen, on hidden tab and under reduced motion */
    (function () {
      const rotator = document.querySelector<HTMLElement>('[data-rotator]');
      if (!rotator) return;
      const words = Array.from(rotator.querySelectorAll<HTMLElement>('.rotator__word'));
      if (!words.length) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0;
      let timer: number | null = null;
      let inView = true;

      words.forEach((word) => {
        word.hidden = false;
      });

      const show = (index: number) => {
        const previousWord = words[current];
        const nextWord = words[index];
        if (!previousWord || !nextWord) return;
        previousWord.classList.remove('is-current');
        current = index;
        nextWord.classList.add('is-current');
        rotator.dataset.platform = nextWord.dataset.platform || 'chatgpt';
      };

      if (reduced.matches) {
        show(0);
        return;
      }

      const start = () => {
        if (timer !== null || reduced.matches || !inView || document.hidden) return;
        timer = window.setInterval(() => show((current + 1) % words.length), 2200);
      };
      const stop = () => {
        if (timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      const io = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry) return;
        inView = entry.isIntersecting;
        if (inView) start();
        else stop();
      });
      io.observe(rotator);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });
      show(0);
      start();
    })();

    /* Process rail activation */
    const processSteps = document.querySelectorAll<HTMLElement>('[data-process-step]');
    if (processSteps.length && 'IntersectionObserver' in window) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches) {
        processSteps.forEach((step) => step.classList.add('is-active'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-active');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        processSteps.forEach((step) => observer.observe(step));
      }
    }
  </script>
</BaseLayout>
