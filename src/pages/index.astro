<script>
(function() {
    const video = document.getElementById('hero-video');
    if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.removeAttribute('autoplay');
        video.pause();
    }
})();

(function() {
    const flowBtns = document.querySelectorAll('.meth-flow-btn');
    const stepRows = document.querySelectorAll('.step-row');
    const progress = document.getElementById('step-progress');
    const rail = document.getElementById('step-rail');
    let cur = 0, timer;
    function setStep(i) {
        flowBtns.forEach(b => b.classList.remove('active'));
        stepRows.forEach(s => s.classList.remove('active'));
        if (flowBtns[i]) flowBtns[i].classList.add('active');
        if (stepRows[i]) stepRows[i].classList.add('active');
        if (progress && rail) {
            const totalH = rail.offsetHeight;
            const stepH = totalH / stepRows.length;
            progress.style.height = (i * stepH + stepH * 0.5) + 'px';
        }
        cur = i;
    }
    function play() { timer = setInterval(() => setStep((cur+1)%5), 4000); }
    function stop() { clearInterval(timer); }
    flowBtns.forEach(b => {
        b.addEventListener('click', () => { stop(); setStep(+b.dataset.idx); });
        b.addEventListener('mouseenter', () => { stop(); setStep(+b.dataset.idx); });
        b.addEventListener('mouseleave', play);
    });
    stepRows.forEach(r => {
        r.addEventListener('mouseenter', () => { stop(); setStep(+r.dataset.idx); });
        r.addEventListener('mouseleave', play);
    });
    setStep(0); play();
})();

(function() {
    const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
})();

(function() {
    const nav = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });
})();

(function() {
    const btn = document.getElementById('menu-btn');
    const nav = document.getElementById('mobile-nav');
    btn.addEventListener('click', () => {
        nav.classList.toggle('open');
        document.body.style.overflow = nav.classList.contains('open') ? 'hidden' : '';
    });
    document.querySelectorAll('.mob-link').forEach(l => {
        l.addEventListener('click', () => {
            nav.classList.remove('open');
            document.body.style.overflow = '';
        });
    });
})();

(function() {
    const form = document.getElementById('contact-form');
    const msg = document.getElementById('form-msg');
    if (!form) return;
    form.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = form.querySelector('[type="submit"]');
        btn.textContent = 'Sending...';
        btn.disabled = true;
        try {
            const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) });
            const data = await res.json();
            msg.textContent = data.success ? 'Inquiry received. We will be in touch shortly.' : 'Submission failed. Please email us directly.';
        } catch { msg.textContent = 'Submission failed. Please email us directly.'; }
        btn.textContent = 'Send Inquiry';
        btn.disabled = false;
    });
})();
</script>
