<script>
(function() {
    const canvas = document.getElementById('hero-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let W, H, nodes = [], mouse = {x: -999, y: -999};
    const COLORS = ['rgba(100,160,255,', 'rgba(80,130,220,', 'rgba(150,190,255,'];
    let animId;
    function resize() {
        const wrap = canvas.parentElement;
        W = canvas.width = wrap.offsetWidth;
        H = canvas.height = wrap.offsetHeight;
    }
    function makeNode(i) {
        return {
            x: Math.random() * W, y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4,
            r: Math.random() * 2 + 1,
            col: COLORS[i % COLORS.length],
            alpha: Math.random() * 0.6 + 0.2
        };
    }
    function init() { nodes = []; for (let i = 0; i < 48; i++) nodes.push(makeNode(i)); }
    function draw() {
        ctx.clearRect(0, 0, W, H);
        for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
                const a = nodes[i], b = nodes[j];
                const dx = a.x - b.x, dy = a.y - b.y;
                const dist = Math.sqrt(dx*dx + dy*dy);
                if (dist < 140) {
                    const mx = (a.x+b.x)/2, my = (a.y+b.y)/2;
                    const mdx = mx-mouse.x, mdy = my-mouse.y;
                    const mdist = Math.sqrt(mdx*mdx+mdy*mdy);
                    const boost = mdist < 120 ? 1.8 : 1;
                    const alpha = (1-dist/140)*0.25*boost;
                    ctx.strokeStyle = 'rgba(100,160,255,' + alpha + ')';
                    ctx.lineWidth = 0.5 * boost;
                    ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
                }
            }
        }
        nodes.forEach(n => {
            const dx = n.x-mouse.x, dy = n.y-mouse.y;
            const dist = Math.sqrt(dx*dx+dy*dy);
            const boost = dist < 80 ? 2.2 : 1;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r*boost, 0, Math.PI*2);
            ctx.fillStyle = n.col + (n.alpha*boost) + ')';
            ctx.fill();
        });
        nodes.forEach(n => {
            n.x += n.vx; n.y += n.vy;
            if (n.x<0||n.x>W) n.vx*=-1;
            if (n.y<0||n.y>H) n.vy*=-1;
        });
        animId = requestAnimationFrame(draw);
    }
    canvas.addEventListener('mousemove', e => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX-rect.left; mouse.y = e.clientY-rect.top;
    });
    canvas.addEventListener('mouseleave', () => { mouse.x=-999; mouse.y=-999; });
    canvas.addEventListener('touchmove', e => {
        const rect = canvas.getBoundingClientRect();
        const t = e.touches[0];
        mouse.x = t.clientX-rect.left; mouse.y = t.clientY-rect.top;
    }, {passive:true});
    resize(); init(); draw();
    window.addEventListener('resize', () => { resize(); init(); });
    let labelIdx = 0;
    const labels = document.querySelectorAll('.hero-canvas-label span');
    setInterval(() => {
        labels.forEach(l => l.classList.remove('hl-active'));
        if (labels[labelIdx]) labels[labelIdx].classList.add('hl-active');
        labelIdx = (labelIdx+1) % labels.length;
    }, 2000);
})();

(function() {
    const flowBtns = document.querySelectorAll('.meth-flow-btn');
    const stepRows = document.querySelectorAll('.step-row');
    const progress = document.getElementById('step-progress');
    const rail = document.getElementById('step-rail');
    let cur = 0, timer;
    function setStep(i) {
        flowBtns.forEach(b => b.classList.remove('active'));
        stepRows.forEach(s => s.classList.remove('active'));
        if (flowBtns[i]) flowBtns[i].classList.add('active');
        if (stepRows[i]) stepRows[i].classList.add('active');
        if (progress && rail) {
            const totalH = rail.offsetHeight;
            const stepH = totalH / stepRows.length;
            progress.style.height = (i * stepH + stepH * 0.5) + 'px';
        }
        cur = i;
    }
    function play() { timer = setInterval(() => setStep((cur+1)%5), 4000); }
    function stop() { clearInterval(timer); }
    flowBtns.forEach(b => {
        b.addEventListener('click', () => { stop(); setStep(+b.dataset.idx); });
        b.addEventListener('mouseenter', () => { stop(); setStep(+b.dataset.idx); });
        b.addEventListener('mouseleave', play);
    });
    stepRows.forEach(r => {
        r.addEventListener('mouseenter', () => { stop(); setStep(+r.dataset.idx); });
        r.addEventListener('mouseleave', play);
    });
    setStep(0); play();
})();

(function() {
    const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
})();

(function() {
    const nav = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });
})();

(function() {
    const btn = document.getElementById('menu-btn');
    const nav = document.getElementById('mobile-nav');
    btn.addEventListener('click', () => {
        nav.classList.toggle('open');
        document.body.style.overflow = nav.classList.contains('open') ? 'hidden' : '';
    });
    document.querySelectorAll('.mob-link').forEach(l => {
        l.addEventListener('click', () => {
            nav.classList.remove('open');
            document.body.style.overflow = '';
        });
    });
})();

(function() {
    const form = document.getElementById('contact-form');
    const msg = document.getElementById('form-msg');
    if (!form) return;
    form.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = form.querySelector('[type="submit"]');
        btn.textContent = 'Sending...';
        btn.disabled = true;
        try {
            const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) });
            const data = await res.json();
            msg.textContent = data.success ? 'Inquiry received. We will be in touch shortly.' : 'Submission failed. Please email us directly.';
        } catch { msg.textContent = 'Submission failed. Please email us directly.'; }
        btn.textContent = 'Send Inquiry';
        btn.disabled = false;
    });
})();
</script>

<script>
/* ===== CASE STUDIES TIMELINE ===== */
(function(){
    const cs2Rail = document.getElementById('cs2-rail');
    const tnodes = document.querySelectorAll('.cs2-tnode');
    const cards = document.querySelectorAll('.cs2-card');
    const progress = document.getElementById('cs2-progress');
    const pcts = ['0%','33%','66%','100%'];

    function setActive(idx) {
        tnodes.forEach((n,i) => n.classList.toggle('active', i<=idx));
        cards.forEach((c,i) => c.classList.toggle('active', i===idx));
        if(progress) progress.style.width = pcts[idx] || '0%';
    }

    // Scroll-trigger: auto-activate as user scrolls through section
    if(cs2Rail) {
        const io = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    const rect = cs2Rail.getBoundingClientRect();
                    const vh = window.innerHeight;
                    const sectionProgress = Math.max(0, Math.min(1, (vh - rect.top) / (rect.height + vh)));
                    const idx = Math.min(3, Math.floor(sectionProgress * 4));
                    setActive(idx);
                }
            });
        }, { threshold: [0, 0.25, 0.5, 0.75, 1] });
        io.observe(cs2Rail);
        window.addEventListener('scroll', () => {
            if(!cs2Rail) return;
            const rect = cs2Rail.getBoundingClientRect();
            const vh = window.innerHeight;
            const sp = Math.max(0, Math.min(1, (vh - rect.top) / (rect.height + vh * 0.5)));
            setActive(Math.min(3, Math.floor(sp * 4.5)));
        }, { passive: true });
    }

    tnodes.forEach((n, i) => n.addEventListener('click', () => setActive(i)));
    cards.forEach((c, i) => {
        c.addEventListener('mouseenter', () => setActive(i));
    });

    // Initialize
    setActive(0);
})();

/* ===== FADE-UP OBSERVER ===== */
(function(){
    if(window._fuObserver) return;
    window._fuObserver = true;
    const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
})();
</script>

