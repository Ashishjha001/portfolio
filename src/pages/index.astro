<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DataDecision.consulting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* Modern reset and base styles */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; color: #0f172a; line-height: 1.6; background: #ffffff; overflow-x: hidden; }
        html { scroll-behavior: smooth; }
        a { text-decoration: none; color: inherit; }
        
        /* Navbar */
        nav {
            position: fixed; top: 0; left: 0; right: 0;
            display: flex; justify-content: space-between; align-items: center;
            padding: 20px 60px; background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px); z-index: 1000;
            border-bottom: 1px solid #e2e8f0;
        }
        .logo { font-weight: 800; font-size: 1.25rem; color: #0f172a; }
        .nav-links { display: flex; gap: 32px; flex-wrap: wrap; }
        .nav-links a { font-weight: 600; font-size: 0.9rem; color: #475569; transition: color 0.2s; }
        .nav-links a:hover { color: #2563eb; }

        @media (max-width: 768px) {
            nav { padding: 16px 24px; flex-direction: column; gap: 12px; }
            .nav-links { gap: 16px; justify-content: center; }
        }

        /* Generic Section Styles */
        .section-wrapper { padding: 100px 60px; max-width: 1200px; margin: 0 auto; }
        @media (max-width: 768px) { .section-wrapper { padding: 80px 24px; } }
        .section-title { font-size: 2.5rem; font-weight: 800; margin-bottom: 40px; color: #0f172a; }
        .section-title::after { content: ''; display: block; width: 60px; height: 4px; background: #2563eb; margin-top: 16px; }

        /* Animation Classes */
        .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        /* 1. Who We Are (Hero with Image) */
        .hero { 
            position: relative; 
            min-height: 85vh; 
            display: flex; 
            align-items: center; 
            padding: 100px 60px;
            margin-top: 0;
            color: white;
            overflow: hidden;
        }
        .hero-bg {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
        }
        .hero-bg img {
            width: 100%; height: 100%; object-fit: cover;
            animation: zoomIn 20s infinite alternate linear;
        }
        @keyframes zoomIn { from { transform: scale(1); } to { transform: scale(1.1); } }
        .hero-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(135deg, rgba(15,23,42,0.9) 0%, rgba(37,99,235,0.7) 100%);
        }
        .hero-content {
            max-width: 900px;
            z-index: 1;
            margin: 0 auto;
            animation: fadeIn 1s ease-out forwards;
        }
        .hero-content h1 {
            font-size: clamp(3rem, 6vw, 4.5rem);
            font-weight: 800;
            margin-bottom: 32px;
            color: white;
            line-height: 1.1;
        }
        .hero-content .purpose {
            font-size: 1.35rem;
            border-left: 4px solid #60a5fa;
            padding-left: 24px;
            color: #e2e8f0;
            font-style: italic;
            line-height: 1.6;
        }

        /* Turning Data & Founder */
        .turning-data { margin-top: 60px; background: #f8fafc; padding: 60px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
        .turning-data h2 { font-size: 2.2rem; margin-bottom: 24px; font-weight: 800; }
        .turning-data p { font-size: 1.15rem; color: #334155; margin-bottom: 16px; }
        .turning-data .highlight { font-weight: 700; color: #2563eb; font-size: 1.3rem; margin-top: 24px; display: inline-block; padding: 8px 16px; background: #eff6ff; border-radius: 8px; }
        @media (max-width: 768px) { .turning-data { padding: 32px; } }
        
        .founder-section { 
            margin-top: 60px; display: flex; align-items: center; gap: 40px; 
            padding: 40px; border: 1px solid #e2e8f0; border-radius: 16px; 
            background: white; box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .founder-img {
            width: 200px; height: 200px; border-radius: 50%; object-fit: cover;
            border: 4px solid #eff6ff; box-shadow: 0 10px 20px rgba(37,99,235,0.1);
        }
        .founder-info h3 { font-size: 2rem; margin-bottom: 4px; font-weight: 800; }
        .founder-info h4 { color: #2563eb; margin-bottom: 16px; font-weight: 600; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.05em; }
        .founder-info p { font-size: 1.1rem; color: #475569; line-height: 1.7; }
        .founder-quote { margin-top: 20px; font-weight: 700; color: #0f172a; font-size: 1.15rem; }
         (max-width: 768px) { .founder-section { flex-direction: column; text-align: center; } }

        /* 2. What We Do */
        .slider-container { position: relative; width: 100%; overflow: hidden; margin-top: 40px; padding-bottom: 20px; }
        .slider { display: flex; gap: 24px; transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1); }
        .slide-card { min-width: calc(100% / 3 - 16px); background: #f8fafc; border-radius: 16px; overflow: hidden; display: block; transition: transform 0.3s, box-shadow 0.3s; border: 1px solid #e2e8f0; }
        .slide-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); border-color: #cbd5e1; }
        .slide-image { width: 100%; height: 220px; background-color: #e2e8f0; object-fit: cover; transition: transform 0.5s; }
        .slide-card:hover .slide-image { transform: scale(1.05); }
        .slide-image-wrapper { overflow: hidden; }
        .slide-content { padding: 32px 24px; }
        .slide-content h3 { font-size: 1.35rem; margin-bottom: 12px; color: #0f172a; font-weight: 700; }
        .slide-content p { font-size: 1rem; color: #64748b; line-height: 1.6; }
        
        .slider-controls { display: flex; justify-content: flex-end; gap: 16px; margin-top: 32px; }
        .slider-btn { background: #f1f5f9; color: #0f172a; border: none; width: 48px; height: 48px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.2s; font-weight: bold;}
        .slider-btn:hover { background: #2563eb; color: white; }
        @media (max-width: 900px) { .slide-card { min-width: calc(100% / 2 - 12px); } }
        @media (max-width: 600px) { .slide-card { min-width: 100%; } }

        /* 3. Our Industries */
        .industries-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px 40px; margin-top: 40px; }
        .industry-item { display: flex; align-items: center; font-size: 1.1rem; color: #0f172a; font-weight: 500; cursor: pointer; transition: all 0.2s; padding: 12px; border-radius: 8px; }
        .industry-item::before { content: '›'; margin-right: 12px; font-size: 1.5rem; font-weight: 400; color: #2563eb; transition: transform 0.2s; }
        .industry-item:hover { color: #2563eb; background: #f8fafc; }
        .industry-item:hover::before { transform: translateX(4px); }

        /* 4. Our Insights */
        .insights-intro { font-size: 1.15rem; color: #334155; max-width: 800px; margin-bottom: 60px; line-height: 1.8; }
        .insights-list { display: flex; flex-direction: column; gap: 48px; }
        .insight-card { display: grid; grid-template-columns: 350px 1fr; gap: 40px; align-items: start; border-bottom: 1px solid #e2e8f0; padding-bottom: 48px; }
        .insight-card:last-child { border-bottom: none; padding-bottom: 0; }
        .insight-image-wrapper { overflow: hidden; border-radius: 12px; height: 240px; }
        .insight-image { width: 100%; height: 100%; background-color: #e2e8f0; object-fit: cover; transition: transform 0.5s; }
        .insight-card:hover .insight-image { transform: scale(1.05); }
        .insight-content h3 { font-size: 1.8rem; margin-bottom: 16px; color: #0f172a; font-weight: 800; line-height: 1.2; transition: color 0.2s;}
        .insight-card:hover .insight-content h3 { color: #2563eb; }
        .insight-content p { font-size: 1.05rem; color: #475569; margin-bottom: 24px; line-height: 1.6; }
        .insight-content .date { font-size: 0.85rem; color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; }
        @media (max-width: 768px) { .insight-card { grid-template-columns: 1fr; gap: 24px; } }

        /* 5. Contact */
        .contact-section { background: #f8fafc; border-top: 1px solid #e2e8f0; }
        .contact { text-align: center; border-radius: 16px; padding: 0; margin-top: 0;}
        .contact p { color: #64748b; margin-bottom: 28px; font-size: 1.1rem; }
        .contact-form { max-width: 600px; margin: 0 auto; text-align: left; background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;}
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .form-group { display: flex; flex-direction: column; }
        .form-group.full-width { margin-bottom: 24px; }
        .form-group label { font-size: 0.9rem; font-weight: 600; color: #334155; margin-bottom: 6px; }
        .optional { font-weight: 400; color: #94a3b8; }
        .form-group input, .form-group textarea { padding: 12px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; font-size: 1rem; background: #fff; transition: border-color 0.2s, box-shadow 0.2s; resize: vertical; }
        .form-group input:focus, .form-group textarea:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12); }
        .submit-btn { border: none; cursor: pointer; font-size: 1rem; width: 100%; background: #1e3a8a; color: #fff; padding: 16px 32px; border-radius: 8px; font-weight: 600; transition: background 0.2s; }
        .submit-btn:hover { background: #2563eb; }
        .form-status { margin-top: 16px; font-size: 0.95rem; text-align: center; min-height: 20px; }
        @media (max-width: 640px) { .form-row { grid-template-columns: 1fr; gap: 0; } .contact-form { padding: 24px; } }
        
        /* 6. Careers */
        .careers-section { background: #0f172a; color: white; }
        .careers-content { border-radius: 16px; }
        .careers-content p { font-size: 1.15rem; margin-bottom: 24px; line-height: 1.8; color: #cbd5e1; }
        .careers-content h3 { font-size: 1.5rem; margin: 40px 0 24px 0; color: #e2e8f0; font-weight: 700; }
        .careers-content ul { list-style: none; margin-bottom: 40px; }
        .careers-content ul li { font-size: 1.15rem; margin-bottom: 16px; display: flex; align-items: center; color: #cbd5e1; }
        .careers-content ul li::before { content: '✓'; color: #3b82f6; margin-right: 16px; font-weight: bold; font-size: 1.2rem;}
        .careers-content .highlight-box { background: rgba(255,255,255,0.05); padding: 40px; border-radius: 12px; margin-top: 40px; font-weight: 500; text-align: center; border: 1px solid rgba(255,255,255,0.1); }
        
        footer { text-align: center; padding: 40px; color: #94a3b8; font-size: 0.9rem; background: white; }
    </style>
</head>
