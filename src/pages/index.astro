---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQList from '../components/FAQList.astro';
import FinalCTA from '../components/FinalCTA.astro';

import StartFinder from '../components/StartFinder.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { Search, Sparkles, BarChart3, Megaphone, Globe, Bot } from 'lucide-astro';
import { insightImages } from '../data/insightImages';

const measurementCluster = (await getCollection('insights'))
  .filter((entry) => entry.data.cluster === 'Measurement & Lead-Source Truth')
  .sort((a, b) => {
    if (a.data.pillar !== b.data.pillar) return a.data.pillar ? -1 : 1;
    return a.data.title.localeCompare(b.data.title);
  });
const featuredMeasurementInsights = measurementCluster.slice(0, 3);

const faqs = [
  {
    question: 'Can you guarantee placement or citations in AI answers?',
    answer:
      'No. AI answers are nondeterministic and change with the engine, query, session and time. We document what appeared within the sampled window, repeat runs where the method calls for it, and never sell a ranking promise.',
  },
  {
    question: 'Which surfaces does the diagnostic cover?',
    answer:
      'The default scope covers up to four approved search and AI surfaces where access permits. The final engine set, access conditions and observation protocol are written into the methodology record before collection begins.',
  },
  {
    question: 'What is included in the standard scope?',
    answer:
      'Fifty buying-intent queries, one market, one language, up to four surfaces where access permits, two documented runs where methodologically appropriate, a technical access review, measurement-gap review and prioritized 90-day action plan.',
  },
  {
    question: 'How long does it take?',
    answer:
      'The standard delivery window is 15 business days after the required inputs are complete and the written scope is confirmed.',
  },
];

const showcaseServices = [
  {
    index: '01',
    href: '/services/seo/',
    icon: Search,
    title: 'SEO Services',
    body: 'Technical SEO and content built for qualified discovery.',
    label: 'SEO services',
    tone: 'search',
    image: insightImages[0],
  },
  {
    index: '02',
    href: '/services/ai-search-visibility/',
    icon: Sparkles,
    title: 'AI Search Visibility',
    body: 'Understand your visibility in AI answers. No placement guarantees.',
    label: 'AEO & GEO',
    tone: 'visibility',
    image: insightImages[2],
  },
  {
    index: '03',
    href: '/services/measurement-foundation/',
    icon: BarChart3,
    title: 'GA4 & Attribution',
    body: 'Connect GA4, campaign sources and your CRM.',
    label: 'Measurement',
    tone: 'measurement',
    image: insightImages[4],
  },
  {
    index: '04',
    href: '/services/#paid-acquisition-performance',
    icon: Megaphone,
    title: 'Paid Media & Demand',
    body: 'Google, Meta and LinkedIn campaigns measured against qualified pipeline.',
    label: 'Paid acquisition',
    tone: 'paid',
    image: insightImages[6],
  },
  {
    index: '05',
    href: '/services/#ai-agent-development',
    icon: Bot,
    title: 'Custom AI Agents',
    body: 'Automate research and reporting with human review and guardrails.',
    label: 'AI automation',
    tone: 'agents',
    image: insightImages[8],
  },
  {
    index: '06',
    href: '/services/website-development-seo/',
    icon: Globe,
    title: 'Website Development',
    body: 'Fast websites with SEO, schema and measurement built in.',
    label: 'Build + SEO',
    tone: 'build',
    image: insightImages[10],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="B2B SaaS Growth & SEO Consultancy | Data Decision Consulting"
  description="Founder-led growth and SEO consultancy for B2B SaaS: SEO and AI-search visibility services, GA4 measurement and attribution consulting, paid acquisition and conversion: evidence-first, no guarantees."
  path="/"
  schema={schema}
>
  <div class="home-refresh">
    <!-- Chapter 01: Opening statement -->
    <section class="hero" data-chapter aria-label="Introduction">
      <span class="chapter-mark" aria-hidden="true">01</span>
      <HeroMedia />
      <div class="shell hero__layout">
        <div class="hero__copy">
          <p class="eyebrow t-stagger">
            <span class="t-stagger-line t-stagger-line--1">AI Search × SEO × Growth</span>
          </p>
          <h1 class="hero__title hero__title--rotator">
            <span class="sr-only">
              Growth you can prove: SEO, AI-search visibility and measurement consulting for B2B
              SaaS. Data Decision Consulting builds complete growth engines for B2B SaaS.
            </span>
            <span aria-hidden="true">
              <span class="line" style="--line:0"><span>Get Recommended by</span></span>
              <span class="line rotator" style="--line:1" data-rotator data-platform="chatgpt">
                <span class="rotator__word is-current" data-platform="chatgpt">ChatGPT</span>
                <span class="rotator__word" data-platform="overviews" hidden>AI Overviews</span>
                <span class="rotator__word" data-platform="gemini" hidden>Gemini</span>
                <span class="rotator__word" data-platform="claude" hidden>Claude</span>
                <span class="rotator__word" data-platform="grok" hidden>Grok</span>
              </span>
            </span>
          </h1>
          <div class="button-row hero__actions" data-reveal style="--reveal-delay:220ms">
            <a
              class="button button--primary"
              href="/contact/?service=web-seo-ai-visibility#request-a-brief"
              data-event="cta_primary_click"
            >
              Get a Free AI Visibility Audit
            </a>
            <a class="text-link" href="/methodology/" data-event="methodology_cta_click">
              See How It Works
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter 01b: Services showcase -->
    <section id="home-services" class="showcase" aria-labelledby="showcase-heading">
      <div class="shell">
        <div class="showcase__head">
          <p class="eyebrow">What we build</p>
          <h2 id="showcase-heading" class="t-stagger">Find your next growth move.</h2>
        </div>
        <div
          class="service-filters"
          data-service-filters
          hidden
          role="group"
          aria-label="Filter services by goal"
        >
          <button type="button" data-service-filter="all" aria-pressed="true">All services</button>
          <button type="button" data-service-filter="discovery" aria-pressed="false"
            >Get discovered</button
          >
          <button type="button" data-service-filter="revenue" aria-pressed="false"
            >Grow revenue</button
          >
          <button type="button" data-service-filter="automation" aria-pressed="false"
            >Automate work</button
          >
        </div>
        <p class="sr-only" data-service-count role="status"></p>
        <div class="showcase__grid">
          {
            showcaseServices.map((service) => (
              <ShowcaseCard
                href={service.href}
                index={service.index}
                title={service.title}
                body={service.body}
                label={service.label}
                tone={service.tone}
                group={
                  ['search', 'visibility', 'build'].includes(service.tone)
                    ? 'discovery'
                    : service.tone === 'agents'
                      ? 'automation'
                      : 'revenue'
                }
                imageSrc={service.image?.src ?? ''}
                imagePosition={service.image?.position ?? '50% 50%'}
              >
                <service.icon strokeWidth={1.75} aria-hidden="true" />
              </ShowcaseCard>
            ))
          }
        </div>
        <div style="text-align: center; margin-top: clamp(1.6rem, 3vw, 2.4rem);">
          <a class="button button--primary" href="/services/" data-event="showcase_all_services">
            Explore all services
          </a>
        </div>
      </div>
    </section>

    <StartFinder />

    <!-- Chapter 03: Insights -->
    <section
      class="section section--compact section--bright home-insights-section"
      data-chapter
      aria-labelledby="home-insights-heading"
    >
      <span class="chapter-mark" aria-hidden="true">03</span>
      <div class="shell editorial-grid">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Practical answers</p>
          <h2 id="home-insights-heading">When your numbers disagree.</h2>
          <a class="text-link" href="/insights/">Explore the insights</a>
        </div>
        <div class="home-insights">
          {
            featuredMeasurementInsights.map((entry, index) => (
              <a
                class:list={['home-insight', { 'home-insight--featured': entry.data.pillar }]}
                href={`/insights/${entry.id}/`}
                data-reveal
                style={`--reveal-delay:${index * 110}ms`}
              >
                <span class="mono">{entry.data.pillar ? 'Start here' : 'Measurement guide'}</span>
                <>
                  <h3>{entry.data.title}</h3>
                  <span class="home-insight__action">
                    Read the guide <span aria-hidden="true">↗</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-owner" aria-labelledby="home-owner-title">
      <div class="shell home-owner__inner">
        <div>
          <p class="eyebrow">Founder-led</p><h2 id="home-owner-title">
            Work directly with Ashish.
          </h2><p>
            Ashish Jha, founder and NIT Surat graduate, leads our AI-search visibility and
            measurement work.
          </p>
        </div>
        <a class="button button--primary" href="/about/">Meet your consultant</a>
      </div>
    </section>

    <!-- Chapter 06: Questions -->
    <section
      class="section section--compact home-faq"
      data-chapter
      aria-labelledby="home-faq-heading"
    >
      <span class="chapter-mark" aria-hidden="true">06</span>
      <div class="shell editorial-grid">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Essential questions</p><h2 id="home-faq-heading">Before you begin.</h2>
        </div>
        <div data-reveal style="--reveal-delay:100ms"><FAQList items={faqs} /></div>
      </div>
    </section>

    <FinalCTA />
  </div>
  <script>
    const filters = document.querySelector<HTMLElement>('[data-service-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-service-group]'));
    const resultCount = document.querySelector<HTMLElement>('[data-service-count]');
    if (filters && cards.length) {
      filters.hidden = false;
      const buttons = Array.from(
        filters.querySelectorAll<HTMLButtonElement>('[data-service-filter]'),
      );
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const group = button.dataset.serviceFilter;
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          cards.forEach((card) => {
            card.hidden = group !== 'all' && card.dataset.serviceGroup !== group;
          });
          if (resultCount)
            resultCount.textContent =
              cards.filter((card) => !card.hidden).length + ' services shown';
        }),
      );
    }

    /* Hero platform rotator: pauses off-screen, on hidden tab and under reduced motion */
    (function () {
      const rotator = document.querySelector<HTMLElement>('[data-rotator]');
      if (!rotator) return;
      const words = Array.from(rotator.querySelectorAll<HTMLElement>('.rotator__word'));
      if (!words.length) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0;
      let timer: number | null = null;
      let inView = true;

      words.forEach((word) => {
        word.hidden = false;
      });

      const show = (index: number) => {
        const previousWord = words[current];
        const nextWord = words[index];
        if (!previousWord || !nextWord) return;
        previousWord.classList.remove('is-current');
        current = index;
        nextWord.classList.add('is-current');
        rotator.dataset.platform = nextWord.dataset.platform || 'chatgpt';
      };

      if (reduced.matches) {
        show(0);
        return;
      }

      const start = () => {
        if (timer !== null || reduced.matches || !inView || document.hidden) return;
        timer = window.setInterval(() => show((current + 1) % words.length), 2200);
      };
      const stop = () => {
        if (timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      const io = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry) return;
        inView = entry.isIntersecting;
        if (inView) start();
        else stop();
      });
      io.observe(rotator);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });
      show(0);
      start();
    })();
  </script>
</BaseLayout>

<style>
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
      padding-bottom: calc(clamp(270px, 40svh, 330px) + 1rem);
    }
    .hero .hero__title--rotator {
      font-size: clamp(2.3rem, 9.6vw, 3.2rem);
    }
    .hero__title--rotator .line:not(.rotator) {
      font-size: 0.68em;
    }
  }
</style>
