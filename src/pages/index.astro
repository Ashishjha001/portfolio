        <div class="bento-grid">
            <!-- 01: DATA & DECISION INTELLIGENCE (Large spanning card) -->
            <a href="/case-study-data-analytics" class="bento-card bento-wide fade-up delay-1">
                <div class="bento-bg-img" style="background-image: url('https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&q=80&w=1600');"></div>
                <div class="bento-overlay"></div>
                <div class="bento-viz">
                    <svg viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg" class="viz-svg viz-network">
                        <path d="M50 100 Q 150 20 200 100 T 350 100" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                        <path d="M50 100 Q 150 180 200 100 T 350 100" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
                        <circle cx="50" cy="100" r="4" fill="#1a52b8" />
                        <circle cx="200" cy="100" r="6" fill="#fff" />
                        <circle cx="350" cy="100" r="4" fill="#1a52b8" />
                        <!-- animated signals -->
