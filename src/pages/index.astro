    <title>DataDecision.consulting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* Modern reset and base styles */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; color: #0f172a; line-height: 1.6; background: #ffffff; }
        html { scroll-behavior: smooth; }
        a { text-decoration: none; color: inherit; }
        
        /* Navbar */
        nav {
            position: fixed; top: 0; left: 0; right: 0;
            display: flex; justify-content: space-between; align-items: center;
            padding: 20px 60px; background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px); z-index: 1000;
            border-bottom: 1px solid #e2e8f0;
        }
        .logo { font-weight: 800; font-size: 1.25rem; color: #0f172a; }
        .nav-links { display: flex; gap: 32px; flex-wrap: wrap; }
        .nav-links a { font-weight: 600; font-size: 0.9rem; color: #475569; transition: color 0.2s; }
        .nav-links a:hover { color: #2563eb; }

        @media (max-width: 768px) {
            nav { padding: 16px 24px; flex-direction: column; gap: 12px; }
            .nav-links { gap: 16px; justify-content: center; }
        }

        /* Sections */
        section { padding: 100px 60px; max-width: 1200px; margin: 0 auto; }
        @media (max-width: 768px) { section { padding: 80px 24px; } }
        .section-title { font-size: 2.5rem; font-weight: 800; margin-bottom: 40px; color: #0f172a; }
        .section-title::after { content: ''; display: block; width: 60px; height: 4px; background: #2563eb; margin-top: 16px; }

        /* Who We Are */
        .hero { padding-top: 180px; text-align: left; }
        .hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.1; margin-bottom: 24px; }
        .purpose { font-size: 1.25rem; color: #475569; border-left: 4px solid #2563eb; padding-left: 20px; margin-bottom: 60px; font-style: italic; }
        
        .turning-data { margin-top: 60px; background: #f8fafc; padding: 60px; border-radius: 16px; }
        .turning-data h2 { font-size: 2rem; margin-bottom: 24px; font-weight: 800; }
        .turning-data p { font-size: 1.1rem; color: #334155; margin-bottom: 16px; }
        .turning-data .highlight { font-weight: 700; color: #2563eb; font-size: 1.2rem; margin-top: 24px; display: block; }
        @media (max-width: 768px) { .turning-data { padding: 32px; } }
        
        .founder-section { margin-top: 60px; display: flex; align-items: center; gap: 40px; padding: 40px; border: 1px solid #e2e8f0; border-radius: 16px; }
        .founder-info h3 { font-size: 1.8rem; margin-bottom: 4px; font-weight: 800; }
        .founder-info h4 { color: #2563eb; margin-bottom: 16px; font-weight: 600; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.05em; }
        .founder-info p { font-size: 1.05rem; color: #475569; }
        .founder-quote { margin-top: 20px; font-weight: 700; color: #0f172a; font-size: 1.1rem; }

        /* What We Do */
        .slider-container { position: relative; width: 100%; overflow: hidden; margin-top: 40px; padding-bottom: 20px; }
        .slider { display: flex; gap: 24px; transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1); }
        .slide-card { min-width: calc(100% / 3 - 16px); background: #f8fafc; border-radius: 12px; overflow: hidden; display: block; transition: transform 0.3s, box-shadow 0.3s; border: 1px solid #e2e8f0; }
        .slide-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-color: #cbd5e1; }
        .slide-image { width: 100%; height: 220px; background-color: #e2e8f0; object-fit: cover; }
        .slide-content { padding: 24px; }
        .slide-content h3 { font-size: 1.25rem; margin-bottom: 12px; color: #0f172a; font-weight: 700; }
        .slide-content p { font-size: 0.95rem; color: #64748b; line-height: 1.5; }
        
        .slider-controls { display: flex; justify-content: flex-end; gap: 16px; margin-top: 32px; }
        .slider-btn { background: #f1f5f9; color: #0f172a; border: none; width: 48px; height: 48px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.2s; }
        .slider-btn:hover { background: #2563eb; color: white; }
        @media (max-width: 900px) { .slide-card { min-width: calc(100% / 2 - 12px); } }
        @media (max-width: 600px) { .slide-card { min-width: 100%; } }

        /* Our Industries */
