<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DataDecision | Data &amp; AI Strategy Consulting</title>
    <meta name="description" content="We turn complex data into clear decisions. Premium data and AI strategy consulting for modern businesses." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Lora:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --white: #ffffff;
            --off-white: #fafaf8;
            --stone-50: #f5f4f1;
            --stone-100: #ede9e4;
            --stone-200: #d8d3cc;
            --stone-400: #9d9590;
            --ink: #1a1a18;
            --ink-70: #3d3d3a;
            --ink-40: #767673;
            --blue: #1a52b8;
            --blue-hover: #1340a0;
            --blue-light: #eef2fb;
            --border: #e2ddd8;
            --border-dark: rgba(255,255,255,0.12);
            --font-sans: 'DM Sans', system-ui, sans-serif;
            --font-serif: 'Lora', Georgia, serif;
            --section-pad: 120px;
            --radius: 3px;
        }
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }
        body { font-family: var(--font-sans); background: var(--white); color: var(--ink); line-height: 1.65; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        img { max-width: 100%; height: auto; display: block; }
        button { font-family: inherit; }
        h1, h2, h3, h4 { color: var(--ink); line-height: 1.15; letter-spacing: -0.025em; }
        h1 { font-family: var(--font-sans); font-size: clamp(2.6rem, 5.5vw, 4.25rem); font-weight: 700; }
        h2 { font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 600; }
        h3 { font-size: 1.2rem; font-weight: 600; }
        h4 { font-size: 1rem; font-weight: 600; }
        p { color: var(--ink-70); line-height: 1.75; margin-bottom: 1rem; }
        p:last-child { margin-bottom: 0; }
        .serif { font-family: var(--font-serif); font-style: italic; }
        .eyebrow { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.18em; font-weight: 600; color: var(--ink-40); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        
        .lead { font-size: 1.15rem; line-height: 1.75; color: var(--ink-70); }
        .text-blue { color: var(--blue); }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
        .section { padding: var(--section-pad) 0; }
        .bg-stone { background: var(--stone-50); }
        .bg-dark { background: #0f1923; }
        .border-b { border-bottom: 1px solid var(--border); }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 28px; font-size: 0.875rem; font-weight: 500; border-radius: var(--radius); border: 1px solid transparent; cursor: pointer; transition: all 0.2s ease; letter-spacing: 0.01em; }
        .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
        .btn-primary:hover { background: var(--blue-hover); border-color: var(--blue-hover); }
        .btn-outline { background: transparent; color: var(--ink); border-color: var(--border); }
        .btn-outline:hover { border-color: var(--ink-70); }
        .btn-ghost { background: transparent; color: var(--blue); border: none; padding: 0; font-weight: 600; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 6px; }
        .btn-ghost:hover { color: var(--blue-hover); }
        .navbar { position: fixed; top: 0; left: 0; width: 100%; z-index: 200; padding: 22px 0; transition: all 0.35s ease; }
        .navbar.scrolled { padding: 14px 0; background: rgba(255,255,255,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; }
        .logo { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.03em; color: var(--ink); }
        .logo-mark { width: 22px; height: 22px; background: var(--blue); display: flex; align-items: center; justify-content: center; border-radius: 2px; }
        .logo-mark svg { width: 11px; fill: #fff; }
        .nav-links { display: none; align-items: center; gap: 36px; }
        .nav-links a { font-size: 0.825rem; font-weight: 500; color: var(--ink-70); transition: color 0.2s; }
        .nav-links a:hover { color: var(--ink); }
        .nav-cta { border: 1px solid var(--border) !important; border-radius: var(--radius) !important; padding: 9px 18px !important; font-size: 0.825rem !important; font-weight: 600 !important; color: var(--ink) !important; }
        .nav-cta:hover { background: var(--ink) !important; color: #fff !important; border-color: var(--ink) !important; }
        @media (min-width: 1024px) { .nav-links { display: flex; } }
        .menu-btn { display: flex; background: none; border: none; cursor: pointer; padding: 4px; }
        .menu-btn svg { width: 22px; height: 22px; stroke: var(--ink); }
        @media (min-width: 1024px) { .menu-btn { display: none; } }
        .mobile-nav { position: fixed; inset: 0; background: var(--white); z-index: 190; display: flex; flex-direction: column; padding: 96px 32px 48px; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); }
        .mobile-nav.open { transform: translateX(0); }
        .mobile-nav a { font-size: 1.75rem; font-weight: 600; color: var(--ink-70); margin-bottom: 20px; display: block; }
        .mobile-nav a:hover { color: var(--ink); }
        .hero { padding-top: 180px; padding-bottom: 120px; border-bottom: 1px solid var(--border); position: relative; overflow: hidden; background: var(--white); }
        .hero-grid { display: grid; grid-template-columns: 1fr; gap: 64px; align-items: center; }
        @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; } }
        .hero-title-block { max-width: 680px; }
        .hero-eyebrow { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.18em; font-weight: 600; color: var(--blue); margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }
        
        .hero-title { margin-bottom: 28px; }
        .hero-title em { font-style: italic; color: var(--blue); font-family: var(--font-serif); }
        .hero-lead { font-size: 1.1rem; line-height: 1.8; color: var(--ink-70); max-width: 520px; margin-bottom: 44px; }
        .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
        .hero-video-wrap { position: relative; border-radius: 6px; overflow: hidden; background: var(--stone-100); aspect-ratio: 4/5; width: 100%; transform: translateZ(0); }
        @media (min-width: 1024px) { .hero-video-wrap { aspect-ratio: 3/4; } }
        #hero-video { width: 100%; height: 100%; object-fit: cover; display: block; }
        @media (prefers-reduced-motion: reduce) {
            #hero-video { display: none; }
            .hero-video-wrap { background-image: url('https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&q=80&w=1200'); background-size: cover; background-position: center; }
        }
        .challenge-grid { display: grid; grid-template-columns: 1fr; gap: 48px; }
        @media (min-width: 768px) { .challenge-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: start; } }
        .expertise-header { max-width: 540px; margin-bottom: 72px; }
        .expertise-grid { display: grid; grid-template-columns: 1fr; gap: 1px; border: 1px solid var(--border); background: var(--border); }
        @media (min-width: 768px) { .expertise-grid { grid-template-columns: 1.2fr 1fr; } }
        .exp-card { background: var(--white); transition: background 0.25s; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
        .exp-card:hover { background: var(--stone-50); }
        .exp-card-img { height: 240px; overflow: hidden; position: relative; }
        .exp-card-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%); transition: filter 0.5s, transform 0.6s; }
        .exp-card:hover .exp-card-img img { filter: grayscale(0%); transform: scale(1.03); }
        .exp-card-body { padding: 32px; flex: 1; display: flex; flex-direction: column; border-top: 1px solid var(--border); }
        .exp-card-num { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; color: var(--blue); margin-bottom: 12px; }
        .exp-card-body h3 { margin-bottom: 12px; font-size: 1.15rem; }
        .exp-card-body p { font-size: 0.9rem; line-height: 1.7; flex: 1; }
        .exp-card-link { margin-top: 24px; font-size: 0.8rem; font-weight: 600; color: var(--blue); display: inline-flex; align-items: center; gap: 6px; }
        .meth-grid { display: grid; grid-template-columns: 1fr; gap: 64px; }
        @media (min-width: 1024px) { .meth-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: start; } }
        .meth-flow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 40px; }
        .meth-flow-btn { background: transparent; border: 1px solid var(--border); padding: 7px 14px; border-radius: 2px; font-weight: 500; cursor: pointer; transition: all 0.25s; color: var(--ink-70); font-size: 0.8rem; font-family: var(--font-sans); }
        .meth-flow-btn.active, .meth-flow-btn:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
        .meth-flow-sep { color: var(--stone-200); font-size: 0.9rem; }
        .meth-visual { border-radius: var(--radius); overflow: hidden; aspect-ratio: 16/9; position: relative; background: #0d1929; }
        .meth-visual img { width: 100%; height: 100%; object-fit: cover; }
        .meth-visual-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(13,25,41,0.3) 0%, transparent 60%); }
        .step-rail { border-left: 1px solid var(--border); padding-left: 32px; display: flex; flex-direction: column; gap: 36px; position: relative; }
        .step-rail-progress { position: absolute; left: -1px; top: 0; width: 1px; background: var(--blue); transition: height 0.5s cubic-bezier(0.4,0,0.2,1); height: 0; }
        .step-row { position: relative; cursor: pointer; transition: opacity 0.25s; opacity: 0.4; }
        .step-row::before { content: ""; position: absolute; left: -36px; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--white); border: 1.5px solid var(--border); transition: all 0.25s; z-index: 1; }
        .step-row.active, .step-row:hover { opacity: 1; }
        .step-row.active::before, .step-row:hover::before { border-color: var(--blue); background: var(--blue); }
        .step-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; color: var(--blue); margin-bottom: 4px; display: block; }
        .step-row h4 { font-size: 1rem; margin-bottom: 6px; }
        .step-row p { font-size: 0.875rem; }
        .if-grid { display: grid; grid-template-columns: 1fr; gap: 64px; }
        @media (min-width: 768px) { .if-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; } }
        .industry-list { display: flex; flex-direction: column; gap: 0; margin-top: 24px; }
        .industry-item { padding: 16px 0; border-bottom: 1px solid var(--border); font-weight: 500; font-size: 1rem; color: var(--ink-70); transition: color 0.2s, padding-left 0.2s; cursor: default; }
        .industry-item:hover { color: var(--ink); padding-left: 8px; }
        .industry-item:first-child { border-top: 1px solid var(--border); }
        .founder-block { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border); }
        .founder-name { font-size: 1rem; font-weight: 600; margin-bottom: 4px; }
        .founder-title { font-size: 0.875rem; color: var(--ink-40); }
        .cs-intro { max-width: 600px; margin-bottom: 72px; }
        .cs-grid { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); }
        @media (min-width: 768px) { .cs-grid { grid-template-columns: 1.2fr 1fr; } }
        .cs-card { background: var(--white); padding: 40px; display: flex; flex-direction: column; transition: background 0.2s; text-decoration: none; color: inherit; }
        .cs-card:hover { background: var(--stone-50); }
        .cs-card-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--blue); margin-bottom: 16px; }
        .cs-card h3 { font-size: 1.2rem; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
        .cs-field-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--blue); }
        .cs-field { margin-bottom: 18px; }
        .cs-field p { margin-top: 4px; font-size: 0.875rem; line-height: 1.65; margin-bottom: 0; }
        .cs-card-link { margin-top: auto; padding-top: 28px; font-size: 0.8rem; font-weight: 600; color: var(--blue); display: inline-flex; align-items: center; gap: 6px; }
        .insights-header { max-width: 540px; margin-bottom: 64px; }
        .featured-ins { display: grid; grid-template-columns: 1fr; border: 1px solid var(--border); margin-bottom: 1px; overflow: hidden; transition: background 0.2s; cursor: pointer; text-decoration: none; color: inherit; display: block; }
        @media (min-width: 900px) { .featured-ins { display: grid; grid-template-columns: 1.1fr 0.9fr; } }
        .featured-ins:hover { background: var(--stone-50); }
        .fi-img { overflow: hidden; min-height: 280px; }
        @media (min-width: 900px) { .fi-img { min-height: 360px; } }
        .fi-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%); transition: filter 0.4s, transform 0.5s; }
        .featured-ins:hover .fi-img img { filter: grayscale(0%); transform: scale(1.03); }
        .fi-content { padding: 48px; display: flex; flex-direction: column; justify-content: center; }
        .fi-category { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--blue); margin-bottom: 16px; }
        .fi-title { font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.3; font-weight: 600; margin-bottom: 16px; letter-spacing: -0.02em; }
        .fi-desc { font-size: 0.95rem; color: var(--ink-70); margin-bottom: 24px; }
        .ins-grid { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); }
        @media (min-width: 640px) { .ins-grid { grid-template-columns: repeat(3, 1fr); } }
        .ins-card { background: var(--white); display: flex; flex-direction: column; cursor: pointer; transition: background 0.2s; overflow: hidden; text-decoration: none; color: inherit; }
        .ins-card:hover { background: var(--stone-50); }
        .ins-card-img { height: 200px; overflow: hidden; }
        .ins-card-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%); transition: filter 0.4s, transform 0.5s; }
        .ins-card:hover .ins-card-img img { filter: grayscale(0%); transform: scale(1.03); }
        .ins-card-body { padding: 24px; flex: 1; display: flex; flex-direction: column; border-top: 1px solid var(--border); }
        .ins-card-cat { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--blue); margin-bottom: 10px; }
        .ins-card-body h4 { font-size: 1rem; line-height: 1.4; margin-bottom: 10px; }
        .ins-card-body p { font-size: 0.85rem; flex: 1; }
        .ins-read { margin-top: 16px; font-size: 0.8rem; font-weight: 600; color: var(--blue); display: inline-flex; align-items: center; gap: 5px; }
        .careers-grid { display: grid; grid-template-columns: 1fr; gap: 64px; }
        @media (min-width: 768px) { .careers-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; } }
        .careers-section { background: #0f1923; color: #f0efed; }
        .careers-section h2, .careers-section h4 { color: #f0efed; }
        .careers-section p { color: rgba(240,239,237,0.6); }
        .careers-section .eyebrow { color: rgba(240,239,237,0.4); }
        .culture-item { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px; margin-bottom: 24px; }
        .culture-num { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; color: rgba(100,150,255,0.8); margin-bottom: 8px; }
        .contact-section { background: #0f1923; color: #f0efed; border-top: 1px solid rgba(255,255,255,0.08); }
        .contact-grid { display: grid; grid-template-columns: 1fr; gap: 64px; }
        @media (min-width: 768px) { .contact-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; } }
        .contact-section h2 { color: #f0efed; font-size: clamp(2rem, 4vw, 3rem); }
        .contact-section p { color: rgba(240,239,237,0.6); }
        .contact-section .eyebrow { color: rgba(240,239,237,0.4); }
        .contact-email { font-size: 1rem; color: #f0efed !important; margin-bottom: 6px !important; }
        .form-wrap { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius); padding: 40px; }
        .form-row { margin-bottom: 20px; }
        .form-row label { display: block; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(240,239,237,0.4); margin-bottom: 8px; }
        .form-field { width: 100%; padding: 13px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); color: #f0efed; font-family: var(--font-sans); font-size: 0.9rem; border-radius: 2px; outline: none; transition: border-color 0.2s; }
        .form-field:focus { border-color: var(--blue); }
        select.form-field option { background: #0f1923; }
        .footer { padding: 80px 0 40px; background: var(--stone-50); border-top: 1px solid var(--border); }
        .footer-grid { display: grid; grid-template-columns: 1fr; gap: 48px; margin-bottom: 64px; }
        @media (min-width: 768px) { .footer-grid { grid-template-columns: 1.8fr 1fr 1fr; } }
        .footer h5 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 600; color: var(--ink-40); margin-bottom: 20px; }
        .footer ul { display: flex; flex-direction: column; gap: 12px; }
        .footer ul li a { font-size: 0.875rem; color: var(--ink-70); transition: color 0.2s; }
        .footer ul li a:hover { color: var(--ink); }
        .footer-tagline { font-size: 0.875rem; color: var(--ink-40); max-width: 280px; margin-top: 16px; line-height: 1.6; margin-bottom: 0; }
        .footer-bottom { border-top: 1px solid var(--border); padding-top: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
        .footer-bottom p { font-size: 0.8rem; color: var(--ink-40); margin-bottom: 0; }
        .footer-bottom a { font-size: 0.8rem; color: var(--ink-40); margin-left: 24px; }
        .footer-bottom a:hover { color: var(--ink); }
        .fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.75s ease, transform 0.75s ease; }
        .fade-up.visible { opacity: 1; transform: none; }
        .delay-1 { transition-delay: 0.1s; }
        .delay-2 { transition-delay: 0.2s; }
        .delay-3 { transition-delay: 0.3s; }
        @media (max-width: 768px) {
            :root { --section-pad: 80px; }
            .hero { padding-top: 140px; padding-bottom: 80px; }
            .container { padding: 0 20px; }
            .fi-content { padding: 28px; }
            .form-wrap { padding: 28px 24px; }
        }
    
        /* OVERRIDE FOR FULLSCREEN HERO */
        .hero { position: relative; min-height: 90vh; display: flex; align-items: center; padding-top: 120px; padding-bottom: 80px; border-bottom: none; overflow: hidden; }
        .hero-bg-video { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
        #hero-video { width: 100%; height: 100%; object-fit: cover; display: block; }
        .hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, #ffffff 0%, rgba(255,255,255,0.92) 40%, rgba(255,255,255,0.2) 75%, rgba(255,255,255,0) 100%); z-index: 1; pointer-events: none; }
        @media (max-width: 768px) { .hero-overlay { background: linear-gradient(180deg, #ffffff 0%, rgba(255,255,255,0.95) 55%, rgba(255,255,255,0.4) 100%); } }
        .hero-content { position: relative; z-index: 2; width: 100%; }
        .hero-title-block { max-width: 680px; position: relative; z-index: 3; }
        @media (prefers-reduced-motion: reduce) {
            #hero-video { display: none; }
            .hero-bg-video { background: url('https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&q=80&w=1200') center/cover no-repeat; }
        }

        /* ===== EXPERTISE (BENTO GRID) ===== */
.bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 64px;
}
@media (min-width: 900px) {
    .bento-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .bento-wide {
        grid-column: 1 / -1;
    }
}
.bento-card {
    position: relative;
    border-radius: 6px;
    background: #0d141c;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 380px;
    text-decoration: none;
    color: #fff;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s, box-shadow 0.4s;
}
@media (min-width: 900px) {
    .bento-wide {
        min-height: 420px;
    }
}
.bento-card:hover {
    transform: translateY(-8px);
    border-color: rgba(26,82,184,0.5);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4), 0 0 30px rgba(26,82,184,0.1);
}
.bento-bg-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    mix-blend-mode: luminosity;
    transition: opacity 0.6s, transform 6s linear;
}
.bento-card:hover .bento-bg-img {
    opacity: 0.3;
    transform: scale(1.05);
}
.bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(7,11,16,0.4) 0%, rgba(7,11,16,0.95) 100%);
}
.bento-content {
    position: relative;
    z-index: 2;
    padding: 48px;
    display: flex;
