<!-- Our Approach -->
<section id="approach" class="py-section bg-light border-bottom">
    <div class="container grid-2">
        <div class="reveal">
            <div>Methodology</div>
            <h2>How we work.</h2>
            <p class="lead-text" style="margin-bottom: 32px;">A clean, rigorous process designed to move from ambiguity to execution.</p>
            
            <div class="methodology-flow" id="methodology-flow">
                <button class="flow-btn active" data-index="0">Data</button>
