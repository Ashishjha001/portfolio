                        <circle cx="260" cy="400" r="20" fill="#1a52b8" fill-opacity="0.07"/>
                        <circle id="cviz-decision-core" cx="260" cy="400" r="5" fill="#1a52b8"/>
                        <text x="260" y="444" text-anchor="middle" class="cviz-stage-text" fill="#1a52b8" font-weight="600">DECISION</text>
