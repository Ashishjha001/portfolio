    <!-- INTERACTIVITY SCRIPTS -->
    <script>
        // 1. Navigation Scroll Effect
        const nav = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
                // Check if passing through light sections
                const expertiseTop = document.getElementById('expertise').offsetTop;
                if(window.scrollY >= expertiseTop - 50 && window.scrollY < document.getElementById('challenge').offsetTop) {
                    nav.classList.add('light-mode');
                } else if(window.scrollY >= document.getElementById('case-studies').offsetTop - 50 && window.scrollY < document.getElementById('insights').offsetTop) {
                    nav.classList.add('light-mode');
                } else {
                    nav.classList.remove('light-mode');
                }
            } else {
                nav.classList.remove('scrolled');
                nav.classList.remove('light-mode');
            }
        });

        // 2. Scroll Reveal
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

        // 3. Native Slider Logic with Drag
        function setupNativeSlider(trackId, progressId) {
            const track = document.getElementById(trackId);
            if (!track) return;
            const container = track.parentElement;
            const prev = container.querySelector('.prev-btn');
            const next = container.querySelector('.next-btn');
            const progress = document.getElementById(progressId);
            
            // Update progress bar & button states
            const updateUI = () => {
                if(!progress && !prev && !next) return;
                const maxScroll = track.scrollWidth - track.clientWidth;
                const scrollLeft = track.scrollLeft;
                const percent = maxScroll > 0 ? (scrollLeft / maxScroll) * 100 : 0;
                
                if(progress) progress.style.width = percent + '%';
                if(prev) prev.style.opacity = scrollLeft <= 10 ? 0.3 : 1;
                if(next) next.style.opacity = scrollLeft >= maxScroll - 10 ? 0.3 : 1;
            };

            track.addEventListener('scroll', updateUI);
            window.addEventListener('resize', updateUI);
            
            // Button controls
            const getScrollAmount = () => {
                const card = track.children[0];
                return card.offsetWidth + parseInt(window.getComputedStyle(track).gap || 0);
            };
            if(prev) prev.addEventListener('click', () => track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' }));
            if(next) next.addEventListener('click', () => track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' }));

            // Click and Drag Logic
            let isDown = false;
            let startX;
            let scrollLeft;

            track.addEventListener('mousedown', (e) => {
                isDown = true;
                track.style.scrollBehavior = 'auto'; // Disable smooth snap while dragging
                track.style.scrollSnapType = 'none';
                startX = e.pageX - track.offsetLeft;
                scrollLeft = track.scrollLeft;
            });
            track.addEventListener('mouseleave', () => {
                isDown = false;
                track.style.scrollBehavior = 'smooth';
                track.style.scrollSnapType = 'x mandatory';
            });
            track.addEventListener('mouseup', () => {
                isDown = false;
                track.style.scrollBehavior = 'smooth';
                track.style.scrollSnapType = 'x mandatory';
            });
            track.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - track.offsetLeft;
                const walk = (x - startX) * 2; // Scroll speed multiplier
                track.scrollLeft = scrollLeft - walk;
            });

            // Initial UI update
            setTimeout(updateUI, 100);
        }

        setupNativeSlider('cs-track', 'cs-progress');
        setupNativeSlider('exp-track', 'exp-progress');
        setupNativeSlider('ins-track', null);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReducedMotion) {
            document.querySelector('.hero-split').classList.add('run-animation');
        }

        // 4. Hero Particle Canvas
        const canvas = document.getElementById('particle-canvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let w, h, particles = [];
            const init = () => {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
                particles = Array.from({length: 50}, () => ({
                    x: Math.random() * w, y: Math.random() * h,
                    vx: (Math.random()-0.5)*0.5, vy: (Math.random()-0.5)*0.5
                }));
            };
            init();
            window.addEventListener('resize', init);

            const draw = () => {
                ctx.clearRect(0,0,w,h);
                ctx.fillStyle = 'rgba(0, 229, 255, 0.5)';
                ctx.strokeStyle = 'rgba(0, 85, 255, 0.15)';
                particles.forEach(p => {
                    p.x += p.vx; p.y += p.vy;
                    if(p.x<0||p.x>w) p.vx*=-1; if(p.y<0||p.y>h) p.vy*=-1;
                    ctx.beginPath(); ctx.arc(p.x, p.y, 1.5, 0, Math.PI*2); ctx.fill();
                    particles.forEach(p2 => {
                        const d = Math.hypot(p.x-p2.x, p.y-p2.y);
                        if(d < 150) { ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p2.x, p2.y); ctx.stroke(); }
                    });
                });
                requestAnimationFrame(draw);
            };
            draw();
        }
    </script>
