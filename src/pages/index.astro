<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DataDecision | Data & AI Strategy Consulting</title>
    <meta name="description" content="We turn complex data into clear decisions. Premium data and AI strategy consulting for modern businesses." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg-white: #ffffff;
            --bg-light: #F7F8FA;
            --bg-dark: #030b18;
            --text-main: #111827;
            --text-secondary: #4b5563;
            --text-muted: #6b7280;
            --text-light: #f9fafb;
            --text-light-muted: #9ca3af;
            --accent-blue: #1e5bc6;
            --border-color: #e5e7eb;
            --border-dark: rgba(255,255,255,0.1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg-white); color: var(--text-main); line-height: 1.6; -webkit-font-smoothing: antialiased; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        img { max-width: 100%; height: auto; display: block; }
        
        /* Typography */
        h1, h2, h3, h4 { font-weight: 600; letter-spacing: -0.03em; color: var(--text-main); }
        h1 { font-size: clamp(3rem, 6vw, 4.5rem); line-height: 1.1; font-weight: 700; margin-bottom: 1.5rem; }
        h2 { font-size: clamp(2rem, 4vw, 2.75rem); line-height: 1.2; margin-bottom: 1.5rem; }
        h3 { font-size: 1.25rem; margin-bottom: 0.75rem; }
        p { color: var(--text-secondary); margin-bottom: 1rem; }
        
        .text-blue { color: var(--accent-blue); }
        .lead-text { font-size: 1.25rem; color: var(--text-secondary); line-height: 1.6; }
        
        .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 600; color: var(--text-muted); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px; }
        .eyebrow::before { content: ""; width: 24px; height: 1px; background: currentColor; }
        
        /* Layout */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
        .py-section { padding: 120px 0; }
        .bg-light { background-color: var(--bg-light); }
        .bg-dark { background-color: var(--bg-dark); color: var(--text-light); }
        .bg-dark h2, .bg-dark h3, .bg-dark h4 { color: var(--text-light); }
        .bg-dark p { color: var(--text-light-muted); }
        .bg-dark .eyebrow { color: var(--text-light-muted); }
        
        .grid-2 { display: grid; grid-template-columns: 1fr; gap: 3rem; }
        .grid-3 { display: grid; grid-template-columns: 1fr; gap: 2rem; }
        .grid-4 { display: grid; grid-template-columns: 1fr; gap: 2rem; }
        @media(min-width: 768px) {
            .grid-2 { grid-template-columns: repeat(2, 1fr); gap: 5rem; }
            .grid-3 { grid-template-columns: repeat(3, 1fr); }
            .grid-4 { grid-template-columns: repeat(2, 1fr); }
        }
        @media(min-width: 1024px) {
            .grid-4 { grid-template-columns: repeat(4, 1fr); }
        }
        
        /* Image Styles */
        .img-premium { width: 100%; height: 100%; object-fit: cover; filter: grayscale(15%) contrast(1.05); transition: filter 0.5s ease, transform 0.8s ease; }
        .img-wrap { overflow: hidden; position: relative; }
        .hover-lift:hover .img-premium, .card:hover .img-premium, .featured-insight:hover .img-premium, .insight-card:hover .img-premium { filter: grayscale(0%) contrast(1); transform: scale(1.03); }
        
        /* Buttons */
        .btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; font-weight: 500; font-size: 0.9rem; border-radius: 4px; transition: all 0.2s; cursor: pointer; border: 1px solid transparent; }
        .btn-primary { background: var(--accent-blue); color: #fff; }
        .btn-primary:hover { background: #15459e; }
        .btn-outline { border-color: var(--border-color); color: var(--text-main); }
        .btn-outline:hover { border-color: var(--text-main); }
        
        /* Navbar */
        .navbar { position: fixed; top: 0; left: 0; width: 100%; padding: 24px 0; z-index: 100; transition: all 0.3s; background: transparent; }
        .navbar.scrolled { padding: 16px 0; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border-color); }
        .nav-container { display: flex; justify-content: space-between; align-items: center; }
        .logo { font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px; }
        .logo-icon { width: 24px; height: 24px; background: var(--accent-blue); display: flex; align-items: center; justify-content: center; }
        .logo-icon svg { width: 12px; fill: #fff; }
        .nav-links { display: none; gap: 32px; align-items: center; }
        .nav-links a { font-size: 0.85rem; font-weight: 500; color: var(--text-secondary); transition: color 0.2s; }
        .nav-links a:hover { color: var(--text-main); }
        .nav-links .btn-nav { border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 4px; color: var(--text-main); }
        .nav-links .btn-nav:hover { border-color: var(--text-main); }
        @media(min-width: 1024px) { .nav-links { display: flex; } }
        
        /* Hero */
        .hero { padding-top: 160px; padding-bottom: 100px; }
        .hero-grid { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
        @media(min-width: 992px) { 
            .hero { padding-top: 180px; padding-bottom: 120px; }
            .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: 64px; } 
        }
        .hero-content { max-width: 900px; }
        .hero-ctas { display: flex; gap: 16px; margin-top: 40px; flex-wrap: wrap; }
        .hero-visual { border-radius: 8px; overflow: hidden; box-shadow: 0 24px 48px rgba(0,0,0,0.08); aspect-ratio: 4/5; background: var(--bg-light); }
        @media(min-width: 992px) { .hero-visual { aspect-ratio: 3/4; } }
        
        /* Utility */
        .border-top { border-top: 1px solid var(--border-color); }
        .border-bottom { border-bottom: 1px solid var(--border-color); }
        
        /* Challenge */
        .challenge-section { position: relative; }
        .challenge-pattern { position: absolute; inset: 0; background-image: radial-gradient(var(--border-color) 1px, transparent 1px); background-size: 32px 32px; opacity: 0.6; pointer-events: none; z-index: 0; }
        .challenge-content { position: relative; z-index: 1; }
        
        /* Expertise Cards */
        .card { background: var(--bg-white); border: 1px solid var(--border-color); }
        .expertise-card { padding: 0; display: flex; flex-direction: column; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .expertise-card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(0,0,0,0.05); }
        .expertise-img { height: 220px; }
        .expertise-content { padding: 32px; flex-grow: 1; display: flex; flex-direction: column; }
        .btn-link { margin-top: auto; padding-top: 24px; font-weight: 600; color: var(--accent-blue); font-size: 0.9rem; display: inline-flex; align-items: center; }
        
        /* Methodology */
        .methodology-flow { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px; }
        @media(min-width: 768px) { .methodology-flow { flex-direction: row; align-items: center; justify-content: space-between; } }
        .flow-btn { background: var(--bg-light); border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 20px; font-weight: 600; cursor: pointer; transition: all 0.3s; color: var(--text-main); font-size: 0.9rem; }
        .flow-btn.active, .flow-btn:hover { background: var(--accent-blue); color: #fff; border-color: var(--accent-blue); box-shadow: 0 4px 12px rgba(30,91,198,0.25); }
        .flow-arrow { color: var(--border-color); font-size: 1.2rem; }
        .methodology-visual { margin-top: 48px; border-radius: 8px; overflow: hidden; box-shadow: 0 16px 32px rgba(0,0,0,0.06); aspect-ratio: 16/9; position: relative; }
        .glow-node { position: absolute; width: 16px; height: 16px; background: #38bdf8; border-radius: 50%; transform: translate(-50%, -50%) scale(0.5); opacity: 0; transition: all 0.5s ease; box-shadow: 0 0 20px 8px rgba(56,189,248,0.7); z-index: 10; pointer-events: none; }
        .glow-node.active { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
        .step-list { border-left: 2px solid var(--border-color); padding-left: 32px; display: flex; flex-direction: column; gap: 32px; margin-left: 8px; position: relative; }
        .step-progress { position: absolute; left: -2px; top: 0; width: 2px; height: 20%; background: var(--accent-blue); transition: top 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        .step-item { position: relative; cursor: pointer; opacity: 0.4; transition: opacity 0.3s; }
        .step-item.active, .step-item:hover { opacity: 1; }
        .step-item::before { content: ""; position: absolute; left: -36.5px; top: 8px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg-white); border: 2px solid var(--border-color); transition: border-color 0.3s; z-index: 2; }
        .step-item.active::before, .step-item:hover::before { border-color: var(--accent-blue); background: var(--accent-blue); }
        .step-num { font-size: 0.75rem; font-weight: 700; color: var(--accent-blue); margin-bottom: 4px; display: block; }

        
        /* Insights */
        .featured-insight { display: grid; grid-template-columns: 1fr; background: var(--bg-white); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; margin-bottom: 40px; transition: box-shadow 0.3s ease; }
        .featured-insight:hover { box-shadow: 0 16px 32px rgba(0,0,0,0.05); }
        @media(min-width: 900px) { .featured-insight { grid-template-columns: 1.2fr 0.8fr; } }
        .featured-insight-img { height: 300px; }
        @media(min-width: 900px) { .featured-insight-img { height: 100%; } }
        .featured-insight-content { padding: 48px; display: flex; flex-direction: column; justify-content: center; }
        .insight-card { border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; background: var(--bg-white); display: flex; flex-direction: column; transition: box-shadow 0.3s ease; }
        .insight-card:hover { box-shadow: 0 12px 24px rgba(0,0,0,0.05); }
        .insight-card-img { height: 200px; }
        .insight-card-content { padding: 24px; flex-grow: 1; display: flex; flex-direction: column; }
        
        /* Form */
        .form-group { margin-bottom: 24px; }
        .form-group label { display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-light-muted); margin-bottom: 8px; }
        .form-control { width: 100%; padding: 16px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-dark); color: #fff; font-family: inherit; font-size: 1rem; border-radius: 4px; outline: none; transition: border-color 0.2s; }
        .form-control:focus { border-color: var(--accent-blue); }
        select.form-control option { background: var(--bg-dark); }
        
        /* Animations */
        .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.8s ease, transform 0.8s ease; will-change: opacity, transform; }
        .reveal.active { opacity: 1; transform: translateY(0); }
        .delay-1 { transition-delay: 0.1s; }
        .delay-2 { transition-delay: 0.2s; }
        
        /* Footer */
        .footer { padding: 80px 0 40px; }
        .footer-grid { display: grid; grid-template-columns: 1fr; gap: 48px; margin-bottom: 64px; }
        @media(min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr; } }
        .footer h4 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 24px; }
        .footer ul { display: flex; flex-direction: column; gap: 12px; }
        .footer ul a { color: var(--text-secondary); font-size: 0.9rem; }
        .footer ul a:hover { color: var(--text-main); }
        
        /* Mobile Menu */
        .mobile-menu-btn { display: block; background: none; border: none; cursor: pointer; padding: 4px; }
        .mobile-menu-btn svg { width: 24px; height: 24px; stroke: var(--text-main); }
        @media(min-width: 1024px) { .mobile-menu-btn { display: none; } }
        .mobile-menu { position: fixed; inset: 0; background: var(--bg-white); z-index: 99; display: flex; flex-direction: column; padding: 100px 24px; transform: translateX(100%); transition: transform 0.3s ease; }
        .mobile-menu.open { transform: translateX(0); }
        .mobile-menu a { font-size: 1.5rem; font-weight: 600; margin-bottom: 24px; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar" id="navbar">
    <div class="container nav-container">
        <a href="#" class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 16 16"><rect x="1" y="8" width="3" height="7"/><rect x="6" y="4" width="3" height="11"/><rect x="11" y="1" width="3" height="14"/></svg>
