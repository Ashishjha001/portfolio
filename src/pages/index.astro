<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>DataDecision.consulting | High-End Data & AI Strategy</title>
    <meta name="description" content="We drive business forward with data and AI. Turning intelligence into measurable business impact." />
    
    <!-- Fonts: Inter for Sans, Playfair Display for elegant accents -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet" />
    
    <style>
        /* 
         * =========================================================================
         * 1. CSS VARIABLES & THEME SYSTEM
         * =========================================================================
         * Defines the core aesthetic for DataDecision.consulting (Palantir/BCG vibe).
         * Uses deep slate blues, pure blacks, and neon cyan/blue accents.
         */
        :root {
            /* Core Backgrounds */
            --bg-base: #020617;        /* Ultra dark slate/black */
            --bg-surface: #0f172a;     /* Dark slate */
            --bg-surface-elevated: rgba(15, 23, 42, 0.7); /* Translucent slate */
            --bg-surface-light: rgba(255, 255, 255, 0.03);
            --bg-surface-hover: rgba(255, 255, 255, 0.08);

            /* Typography Colors */
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #64748b;
            
            /* Accents */
            --accent-primary: #2563eb; /* Royal Blue */
            --accent-secondary: #06b6d4; /* Cyan */
            --accent-tertiary: #8b5cf6; /* Deep Purple */
            
            /* Glows & Shadows */
            --glow-primary: rgba(37, 99, 235, 0.5);
            --glow-secondary: rgba(6, 182, 212, 0.5);
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
            --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
            --shadow-glow: 0 0 30px -5px var(--glow-primary);

            /* Borders */
            --border-light: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.2);
            --border-accent: rgba(37, 99, 235, 0.4);

            /* Typography Families */
            --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            --font-serif: 'Playfair Display', Georgia, Cambria, 'Times New Roman', Times, serif;
            
            /* Animation Timings */
            --transition-fast: all 0.2s ease;
            --transition-smooth: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            --transition-bounce: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* 
         * =========================================================================
         * 2. RESET & BASE STYLES
         * =========================================================================
         */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        
        html { 
            scroll-behavior: smooth; 
            font-size: 16px; 
            background-color: var(--bg-base); 
            scrollbar-width: thin;
            scrollbar-color: var(--accent-primary) var(--bg-surface);
        }
        
        body { 
            font-family: var(--font-sans); 
            color: var(--text-primary); 
            line-height: 1.6; 
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::selection { background: var(--accent-primary); color: white; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--bg-surface); }
        ::-webkit-scrollbar-thumb { background: var(--accent-primary); border-radius: 5px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent-secondary); }

        a { text-decoration: none; color: inherit; outline: none; }
        a:focus-visible { box-shadow: 0 0 0 3px var(--accent-secondary); border-radius: 4px; }
        ul { list-style: none; }
        img { max-width: 100%; height: auto; display: block; }
        button { font-family: inherit; }

        /* 
         * =========================================================================
         * 3. LAYOUT & GRID UTILITIES
         * =========================================================================
         * Mobile-first responsive container system.
         */
        .container {
            width: 100%;
            padding: 0 24px;
            margin: 0 auto;
        }
        @media (min-width: 640px) { .container { max-width: 640px; } }
        @media (min-width: 768px) { .container { max-width: 768px; padding: 0 40px; } }
        @media (min-width: 1024px) { .container { max-width: 1024px; } }
        @media (min-width: 1280px) { .container { max-width: 1280px; } }

        .section-padding { padding: 80px 0; }
        @media (min-width: 768px) { .section-padding { padding: 120px 0; } }
        @media (min-width: 1024px) { .section-padding { padding: 160px 0; } }

        /* 
         * =========================================================================
         * 4. TYPOGRAPHY UTILITIES
         * =========================================================================
         */
        h1, h2, h3, h4, h5, h6 { font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; }
        
        .text-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #64748b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .text-gradient-accent {
            background: linear-gradient(135deg, var(--accent-secondary) 0%, var(--accent-primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            margin-bottom: 1.5rem;
            position: relative;
            display: inline-block;
        }
        .section-subtitle {
            font-size: clamp(1.1rem, 2vw, 1.25rem);
            color: var(--text-secondary);
            max-width: 700px;
            margin-bottom: 4rem;
            line-height: 1.7;
        }

        /* 
         * =========================================================================
         * 5. ANIMATIONS, KEYFRAMES & REVEALS
         * =========================================================================
         */
        /* Reveal on Scroll */
        .reveal { 
            opacity: 0; 
            transform: translateY(40px); 
            transition: var(--transition-smooth); 
            will-change: opacity, transform;
        }
        .reveal.active { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: 0.15s; }
        .reveal-delay-2 { transition-delay: 0.3s; }
        .reveal-delay-3 { transition-delay: 0.45s; }

        /* Floating Ambient Background Orbs */
        .ambient-bg {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: -2; pointer-events: none; overflow: hidden;
            background: var(--bg-base);
        }
        /* Grid overlay for tech feel */
        .ambient-grid {
            position: absolute; inset: 0; z-index: -1; opacity: 0.15;
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            mask-image: radial-gradient(circle at center, black 0%, transparent 80%);
            -webkit-mask-image: radial-gradient(circle at center, black 0%, transparent 80%);
        }
        
        .orb {
            position: absolute; border-radius: 50%; filter: blur(120px);
            opacity: 0.35; mix-blend-mode: screen;
            animation: float 25s infinite alternate ease-in-out;
        }
        .orb-1 { width: 600px; height: 600px; background: rgba(37, 99, 235, 0.4); top: -10%; left: -10%; }
        .orb-2 { width: 500px; height: 500px; background: rgba(6, 182, 212, 0.3); bottom: -10%; right: -5%; animation-delay: -7s; }
        .orb-3 { width: 700px; height: 700px; background: rgba(139, 92, 246, 0.2); top: 30%; left: 30%; animation-delay: -14s; }
        
        @keyframes float {
            0% { transform: translate(0, 0) scale(1) rotate(0deg); }
            50% { transform: translate(50px, 100px) scale(1.1) rotate(10deg); }
            100% { transform: translate(-50px, 50px) scale(0.9) rotate(-10deg); }
        }

        /* 
         * =========================================================================
         * 6. UI COMPONENTS (BUTTONS, CARDS)
         * =========================================================================
         */
        /* Glassmorphism Panel */
        .glass-panel {
            background: var(--bg-surface-elevated);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-light);
            border-radius: 24px;
            box-shadow: var(--shadow-lg);
            position: relative;
            overflow: hidden;
        }
        .glass-panel::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        }

        /* Magnetic / Glowing Button */
        .btn-primary {
            display: inline-flex; align-items: center; justify-content: center;
            padding: 18px 36px; border-radius: 99px;
            background: linear-gradient(135deg, var(--accent-primary), #1d4ed8);
            color: white; font-weight: 600; letter-spacing: 0.5px;
            border: 1px solid rgba(255,255,255,0.1); cursor: pointer;
            transition: var(--transition-bounce);
            position: relative; overflow: hidden;
            box-shadow: 0 10px 25px -5px var(--glow-primary);
        }
        .btn-primary::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transform: translateX(-100%);
            transition: transform 0.6s ease;
        }
        .btn-primary:hover { 
            transform: translateY(-4px); 
            box-shadow: 0 15px 35px -5px var(--glow-primary); 
            border-color: rgba(255,255,255,0.3);
        }
        .btn-primary:hover::after { transform: translateX(100%); }

        /* Secondary Link */
        .link-secondary {
            display: inline-flex; align-items: center; gap: 8px;
            color: var(--accent-secondary); font-weight: 600;
            transition: var(--transition-fast);
        }
        .link-secondary:hover { gap: 12px; color: white; }

        /* 
         * =========================================================================
         * 7. NAVIGATION BAR
         * =========================================================================
         */
        .navbar {
            position: fixed; top: 0; left: 0; width: 100%; z-index: 100;
            transition: var(--transition-smooth);
            padding: 24px 0;
        }
        .navbar.scrolled {
            padding: 16px 0; background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-light);
            box-shadow: var(--shadow-md);
        }
        .nav-container { display: flex; justify-content: space-between; align-items: center; }
        
        .logo { 
            font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px; 
            display: flex; align-items: center; gap: 12px; z-index: 101;
            color: white;
        }
        .logo-icon { 
            width: 28px; height: 28px; 
            background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary)); 
            border-radius: 6px; transform: rotate(45deg); 
            box-shadow: 0 0 20px var(--glow-primary); 
            transition: var(--transition-bounce);
        }
        .logo:hover .logo-icon { transform: rotate(135deg); }
        
        .nav-links { display: flex; gap: 40px; align-items: center; }
        .nav-links a { 
            font-size: 0.95rem; font-weight: 500; color: var(--text-secondary); 
            transition: color 0.3s; position: relative;
        }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -6px; left: 0; width: 0; height: 2px;
            background: var(--accent-secondary); transition: width 0.3s ease;
        }
        .nav-links a:hover { color: white; }
        .nav-links a:hover::after { width: 100%; }
        
        .nav-btn {
            padding: 12px 24px; background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-light); border-radius: 99px;
            color: white; font-weight: 600; transition: var(--transition-smooth);
        }
        .nav-btn:hover { background: white; color: black; }

        /* Mobile Menu */
        .mobile-menu-btn { 
            display: none; background: none; border: none; color: white; 
            font-size: 1.8rem; cursor: pointer; z-index: 101; 
            transition: transform 0.3s;
        }
        .mobile-menu-btn:active { transform: scale(0.9); }
        
        .mobile-overlay {
            position: fixed; inset: 0; background: rgba(2, 6, 23, 0.98); 
            backdrop-filter: blur(20px); z-index: 100;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            opacity: 0; pointer-events: none; transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .mobile-overlay.active { opacity: 1; pointer-events: auto; }
        .mobile-overlay a { 
            font-size: 2.5rem; font-weight: 700; margin: 20px 0; 
            opacity: 0; transform: translateY(30px); 
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); 
            color: var(--text-secondary);
        }
        .mobile-overlay a:hover { color: white; }
        .mobile-overlay.active a { opacity: 1; transform: translateY(0); }
        .mobile-overlay.active a:nth-child(2) { transition-delay: 0.1s; }
        .mobile-overlay.active a:nth-child(3) { transition-delay: 0.15s; }
        .mobile-overlay.active a:nth-child(4) { transition-delay: 0.2s; }
        .mobile-overlay.active a:nth-child(5) { transition-delay: 0.25s; }
        .mobile-overlay.active a:nth-child(6) { transition-delay: 0.3s; }
        
        @media (max-width: 1024px) {
            .nav-links { display: none; }
            .mobile-menu-btn { display: block; }
        }

        /* 
         * =========================================================================
         * 8. HERO SECTION
         * =========================================================================
         */
        .hero {
            position: relative; min-height: 100vh;
            display: flex; align-items: center;
            padding-top: 100px; overflow: hidden;
        }
        .hero-bg-wrapper {
            position: absolute; inset: 0; z-index: -1;
            mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
        }
        .hero-bg-image {
            width: 100%; height: 100%;
            background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1920');
            background-size: cover; background-position: center;
            opacity: 0.15; filter: grayscale(80%) contrast(150%) brightness(0.8);
            transform: scale(1.05); animation: slowZoom 30s infinite alternate ease-in-out;
        }
        @keyframes slowZoom { from { transform: scale(1.05); } to { transform: scale(1.15); } }
        
        .hero-content { max-width: 1000px; position: relative; z-index: 10; }
        .hero-title { 
            font-size: clamp(3.5rem, 8vw, 7rem); 
            margin-bottom: 2.5rem; 
            letter-spacing: -0.03em;
        }
        .hero-quote {
            font-size: clamp(1.25rem, 3vw, 1.75rem);
            color: var(--text-secondary); font-style: italic;
            font-family: var(--font-serif);
            border-left: 3px solid var(--accent-primary);
            padding-left: 32px; margin-bottom: 4rem;
            line-height: 1.6; max-width: 800px;
        }

        /* 
         * =========================================================================
         * 9. WHO WE ARE (DATA TO DECISIONS)
         * =========================================================================
         */
        .about-grid {
            display: grid; grid-template-columns: 1fr; gap: 40px;
        }
        @media (min-width: 1024px) {
            .about-grid { grid-template-columns: 1.2fr 0.8fr; align-items: stretch; gap: 40px; }
        }
        
        .about-panel { padding: 40px; }
        @media (min-width: 768px) { .about-panel { padding: 60px; } }
        
        .about-text p { font-size: 1.15rem; color: var(--text-secondary); margin-bottom: 1.75rem; }
        .about-text strong { color: white; font-weight: 600;}
        .flow-diagram { 
            display: flex; align-items: center; flex-wrap: wrap; gap: 16px; 
            margin-top: 40px; font-weight: 800; font-size: 1.35rem; 
            background: rgba(0,0,0,0.3); padding: 20px 32px; border-radius: 16px;
            border: 1px solid var(--border-light); width: max-content;
        }
        @media (max-width: 600px) { .flow-diagram { width: 100%; justify-content: center; } }
        .flow-arrow { color: var(--accent-secondary); }
        
        .founder-card { 
            padding: 40px; position: relative; overflow: hidden; 
            display: flex; flex-direction: column; justify-content: center;
        }
        @media (min-width: 768px) { .founder-card { padding: 60px; } }
        
        .founder-card::before {
            content: ''; position: absolute; inset: 0;
            background: url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80') center/cover;
            opacity: 0.15; mix-blend-mode: color-dodge; z-index: -1;
            filter: grayscale(50%); transition: opacity 0.5s;
        }
        .founder-card:hover::before { opacity: 0.25; }
        
        .founder-tag { 
            display: inline-block; padding: 8px 16px; 
            background: rgba(255,255,255,0.05); border-radius: 99px; 
            font-size: 0.85rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; 
            margin-bottom: 32px; color: var(--accent-secondary); border: 1px solid var(--border-light); 
            width: max-content;
        }
        .founder-card h3 { font-size: 2.5rem; margin-bottom: 24px; }
        .founder-card p { color: var(--text-secondary); margin-bottom: 40px; font-size: 1.15rem; line-height: 1.8; }
        .founder-mantra { 
            font-family: var(--font-serif); font-size: 1.75rem; 
            color: white; font-style: italic; 
            border-top: 1px solid var(--border-light); padding-top: 24px;
        }

        /* 
         * =========================================================================
         * 10. WHAT WE DO (HORIZONTAL 3D CAROUSEL)
         * =========================================================================
         */
        .services-section { background: rgba(0,0,0,0.3); border-block: 1px solid var(--border-light); }
        
        .carousel-wrapper {
            position: relative; margin-top: 60px;
            margin-left: -24px; margin-right: -24px; padding-left: 24px; padding-right: 24px;
        }
        @media (min-width: 768px) {
            .carousel-wrapper { margin-left: -40px; margin-right: -40px; padding-left: 40px; padding-right: 40px; }
        }
        
        .carousel {
            display: flex; gap: 24px; overflow-x: auto;
            scroll-snap-type: x mandatory; scroll-behavior: smooth;
            padding-bottom: 60px; padding-top: 20px;
            -ms-overflow-style: none; scrollbar-width: none;
        }
        .carousel::-webkit-scrollbar { display: none; }
        
        .service-card {
            min-width: 85vw; scroll-snap-align: center;
            border-radius: 24px; overflow: hidden;
            background: var(--bg-surface-elevated); border: 1px solid var(--border-light);
            transition: var(--transition-bounce);
            display: flex; flex-direction: column;
            transform-style: preserve-3d; perspective: 1000px;
            cursor: pointer;
        }
        @media (min-width: 768px) { .service-card { min-width: 45vw; } }
        @media (min-width: 1024px) { .service-card { min-width: 30vw; scroll-snap-align: start; } }
        
        .service-card:hover { 
            transform: translateY(-15px); border-color: rgba(255,255,255,0.3); 
            box-shadow: var(--shadow-lg), 0 0 40px rgba(37,99,235,0.2); 
        }
        
        .service-img-wrapper { height: 260px; overflow: hidden; position: relative; }
        .service-img-wrapper img { 
            width: 100%; height: 100%; object-fit: cover; 
            transition: transform 0.8s cubic-bezier(0.2, 1, 0.3, 1); 
            filter: grayscale(40%) contrast(120%); 
        }
        .service-card:hover .service-img-wrapper img { transform: scale(1.12); filter: grayscale(0%) contrast(100%); }
        .service-img-overlay { position: absolute; inset: 0; background: linear-gradient(to top, var(--bg-surface-elevated), transparent 80%); }
        
        .service-tag {
            position: absolute; bottom: 20px; left: 32px;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(8px);
            padding: 6px 16px; border-radius: 99px; font-size: 0.8rem;
            font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .service-content { padding: 40px 32px; flex-grow: 1; display: flex; flex-direction: column; position: relative; }
        .service-icon {
            position: absolute; top: -24px; right: 32px;
            width: 48px; height: 48px; background: var(--bg-base);
            border: 1px solid var(--border-light); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: var(--accent-secondary); transition: var(--transition-bounce);
            font-size: 1.2rem;
        }
        .service-card:hover .service-icon { 
            background: var(--accent-primary); color: white; 
            transform: rotate(45deg) scale(1.1); border-color: transparent; 
            box-shadow: 0 10px 20px rgba(37,99,235,0.4);
        }
        
        .service-content h3 { font-size: 1.75rem; margin-bottom: 16px; }
        .service-content p { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.7; }

        .carousel-controls { display: flex; justify-content: flex-end; gap: 16px; margin-top: 16px; padding-right: 24px;}
        @media (max-width: 1024px) { .carousel-controls { display: none; } }
        .ctrl-btn {
            width: 56px; height: 56px; border-radius: 50%;
            background: transparent; border: 1px solid rgba(255,255,255,0.2);
            color: white; font-size: 1.5rem; cursor: pointer;
            transition: var(--transition-bounce);
            display: flex; align-items: center; justify-content: center;
        }
        .ctrl-btn:hover { background: white; color: black; transform: scale(1.1); }

        /* 
         * =========================================================================
         * 11. INDUSTRIES
         * =========================================================================
         */
        .industries-grid {
            display: grid; grid-template-columns: 1fr; gap: 16px;
            margin-top: 60px;
        }
        @media (min-width: 640px) { .industries-grid { grid-template-columns: 1fr 1fr; } }
        @media (min-width: 992px) { .industries-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
        @media (min-width: 1280px) { .industries-grid { grid-template-columns: repeat(4, 1fr); } }
        
        .industry-item {
            padding: 24px; border-radius: 16px;
            background: var(--bg-surface-light); border: 1px solid var(--border-light);
            display: flex; align-items: center; transition: var(--transition-smooth);
            cursor: pointer; font-size: 1.1rem; font-weight: 500;
        }
        .industry-item::before {
            content: '→'; margin-right: 20px; color: var(--accent-secondary);
            transition: transform 0.3s ease; opacity: 0.5; font-size: 1.25rem;
        }
        .industry-item:hover {
            background: var(--bg-surface-hover); border-color: rgba(255,255,255,0.3);
            transform: translateX(10px); box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            color: white;
        }
        .industry-item:hover::before { transform: translateX(5px); opacity: 1; }

        /* 
         * =========================================================================
         * 12. INSIGHTS
         * =========================================================================
         */
        .insights-section { background: rgba(0,0,0,0.2); border-top: 1px solid var(--border-light); }
        .insight-list { display: flex; flex-direction: column; gap: 40px; margin-top: 60px;}
        
        .insight-card {
            display: grid; grid-template-columns: 1fr; gap: 0;
            border-radius: 32px; overflow: hidden;
