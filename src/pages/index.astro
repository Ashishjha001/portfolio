}
@media (prefers-reduced-motion: reduce) {
    .bento-card:hover, .bento-card:hover .bento-viz, .bento-card:hover .bento-bg-img { transform: none; }
    .bento-card:hover .chart-line { stroke-dashoffset: 0; transition: none; }
    .layer { animation: none !important; }
    .viz-signal { display: none; }
