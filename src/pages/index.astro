---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MethodStory from '../components/MethodStory.astro';
import ServiceExplorer from '../components/ServiceExplorer.astro';
import DecisionTabs from '../components/DecisionTabs.astro';
import MethodBadge from '../components/MethodBadge.astro';
import FAQList from '../components/FAQList.astro';
import FinalCTA from '../components/FinalCTA.astro';

const measurementCluster = (await getCollection('insights'))
  .filter((entry) => entry.data.cluster === 'Measurement & Lead-Source Truth')
  .sort((a, b) => {
    if (a.data.pillar !== b.data.pillar) return a.data.pillar ? -1 : 1;
    return a.data.title.localeCompare(b.data.title);
  });
const featuredMeasurementInsights = measurementCluster.slice(0, 3);

const faqs = [
  {
    question: 'Can you guarantee placement or citations in AI answers?',
    answer:
      'No. AI answers are nondeterministic and change with the engine, query, session and time. We document what appeared within the sampled window, repeat runs where the method calls for it, and never sell a ranking promise.',
  },
  {
    question: 'Which surfaces does the diagnostic cover?',
    answer:
      'The default scope covers up to four approved search and AI surfaces where access permits. The final engine set, access conditions and observation protocol are written into the methodology record before collection begins.',
  },
  {
    question: 'Is this SEO with a new name?',
    answer:
      'Some foundations overlap: crawl access, useful content, technical clarity and external authority still matter. The additional work is a sampled answer-layer baseline, source observation, prompt-frame design and a measurement path into conversion and pipeline.',
  },
  {
    question: 'What is included in the standard scope?',
    answer:
      'Fifty buying-intent queries, one market, one language, up to four surfaces where access permits, two documented runs where methodologically appropriate, a technical access review, measurement-gap review and prioritized 90-day action plan.',
  },
  {
    question: 'How long does it take?',
    answer:
      'The standard delivery window is 15 business days after the required inputs are complete and the written scope is confirmed.',
  },
  {
    question: 'Do you manage paid media?',
    answer:
      'The launch focus is AI-search visibility, measurement foundations and tightly scoped post-diagnostic implementation. Paid channels may appear in a recommendation when the evidence makes them relevant, but paid-media management is outside the current service scope.',
  },
];

const methodSteps = [
  {
    index: '01',
    title: 'Frame the query set',
    body: 'Define buying intent, market, language, competitors and collection conditions before checking any result.',
    tag: 'Inputs locked',
    deliverable: 'A written query frame and approved comparison set.',
    decision: 'What we compare, in which market and language.',
  },
  {
    index: '02',
    title: 'Observe the surfaces',
    body: 'Record dated answers, mentions and sources across the approved engine set inside a clearly defined sample.',
    tag: 'Windowed',
    deliverable: 'Dated observation records for every surface.',
    decision: 'Which engines stay in the approved set.',
  },
  {
    index: '03',
    title: 'Audit the measurement path',
    body: 'Test whether referral, conversion and CRM records can connect discovery to pipeline.',
    tag: 'Assumptions shown',
    deliverable: 'A measurement-gap review with test results.',
    decision: 'Which gaps we repair now and which we document.',
  },
  {
    index: '04',
    title: 'Rank the next decisions',
    body: 'Attach an owner, effort, expected signal, confidence label and stopping rule to each recommended action.',
    tag: '90-day horizon',
    deliverable: 'A prioritized 90-day action plan.',
    decision: 'What moves first, owned by whom, stopped by what.',
  },
];

const capabilities = [
  {
    index: 'A',
    label: 'AI-search visibility',
    title: 'AI-search visibility diagnostic',
    body: 'A dated, sampled baseline across approved surfaces, with a source map, competitor comparison and prioritized actions.',
    meta: 'Diagnostic output · 15 business days',
    href: '/services/ai-search-visibility/',
    figure: [
      { term: 'Frame', detail: '50 buying-intent queries' },
      { term: 'Surfaces', detail: 'Up to four approved surfaces where access permits' },
      { term: 'Runs', detail: 'Two documented runs where appropriate' },
      { term: 'Output', detail: 'Baseline, source map and 90-day plan' },
    ],
  },
  {
    index: 'B',
    label: 'Measurement foundation',
    title: 'Measurement foundation',
    body: 'Tracking plan, referral visibility, CRM linkage and an assumption register that makes reporting easier to challenge.',
    meta: 'Diagnostic output · scoped separately',
    href: '/services/measurement-foundation/',
    figure: [
      { term: 'Plan', detail: 'Decisions before events' },
      { term: 'Sources', detail: 'Acquisition and CRM fields reconciled' },
      { term: 'Linkage', detail: 'Discovery connected to pipeline records' },
      { term: 'Register', detail: 'What each report can and cannot say' },
    ],
  },
  {
    index: 'C',
    label: 'Recommendations',
    title: 'Conversion and visibility recommendations',
    body: 'Audit-grade recommendations inside every engagement, ordered by evidence, effort and expected signal.',
    meta: 'Included in every diagnostic',
    figure: [
      { term: 'Order', detail: 'Evidence first, then effort' },
      { term: 'Signal', detail: 'Expected change named per action' },
      { term: 'Confidence', detail: 'Labelled beside each recommendation' },
      { term: 'Boundary', detail: 'Evidence limits stated openly' },
    ],
  },
  {
    index: 'D',
    label: 'Implementation sprint',
    title: 'Scoped implementation sprint',
    body: 'A fixed post-diagnostic sprint for a defined measurement or answer-readiness problem, with its own boundaries and acceptance criteria.',
    meta: 'Post-diagnostic only',
    figure: [
      { term: 'Entry', detail: 'Selected from diagnostic findings' },
      { term: 'Scope', detail: 'Fixed before kickoff' },
      { term: 'Criteria', detail: 'Acceptance defined in writing' },
      { term: 'Additions', detail: 'Agreed separately, never silently' },
    ],
  },
];

const decisionQuestions = [
  {
    label: 'Visibility baseline',
    heading: 'What appeared in the sample?',
    body: 'See the dated mentions, citations and comparison set produced by the agreed query frame.',
  },
  {
    label: 'Measurement gap',
    heading: 'What would your stack miss?',
    body: 'Find the breaks between referral data, conversion events and CRM records.',
  },
  {
    label: 'Priority action',
    heading: 'What should move first?',
    body: 'Give each recommended action an owner, effort estimate, expected signal and stopping rule.',
  },
  {
    label: 'Evidence boundary',
    heading: 'What can the evidence not prove?',
    body: 'State the sample boundary and uncertainty beside the decision it supports.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="DataDecision | Measurement-first AI-search visibility for B2B SaaS"
  description="DataDecision helps B2B SaaS teams measure how they appear across search and AI answers, identify measurement gaps and decide what to improve next."
  path="/"
  schema={schema}
>
  <!-- Chapter 01: Opening statement -->
  <section class="hero" data-chapter aria-label="Introduction">
    <span class="chapter-mark" aria-hidden="true">01</span>
    <p class="hero__query hero__query--a mono" aria-hidden="true">best crm for b2b saas</p>
    <p class="hero__query hero__query--b mono" aria-hidden="true">top ai visibility agency</p>
    <p class="hero__query hero__query--c mono" aria-hidden="true">best seo partner for saas</p>
    <div class="shell">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal>AI Search × SEO × Growth</p>
        <h1 class="hero__title hero__title--rotator">
          <span class="sr-only">
            Get recommended by ChatGPT, Google AI Overviews, Gemini, Claude or Grok. DataDecision
            builds complete growth engines for B2B SaaS.
          </span>
          <span aria-hidden="true">
            <span class="line" style="--line:0"><span>Get Recommended by</span></span>
            <span class="line rotator" style="--line:1" data-rotator data-platform="chatgpt">
              <span class="rotator__word is-current" data-platform="chatgpt">ChatGPT</span>
              <span class="rotator__word" data-platform="overviews" hidden>Google AI Overviews</span
              >
              <span class="rotator__word" data-platform="gemini" hidden>Gemini</span>
              <span class="rotator__word" data-platform="claude" hidden>Claude</span>
              <span class="rotator__word" data-platform="grok" hidden>Grok</span>
            </span>
          </span>
        </h1>
        <p class="hero__standfirst" data-reveal style="--reveal-delay:160ms">
          Let AI recommend your product or service when your customers are ready to choose.
        </p>
        <p class="lede hero__lede" data-reveal style="--reveal-delay:220ms">
          From building your website to SEO, AI search visibility, content, paid acquisition,
          conversion and analytics — we build the complete digital growth engine behind your
          business.
        </p>
        <div class="button-row hero__actions" data-reveal style="--reveal-delay:280ms">
          <a
            class="button button--primary"
            href="/contact/?service=web-seo-ai-visibility#request-a-brief"
            data-event="cta_primary_click"
          >
            Get Your Free AI Visibility Audit
          </a>
          <a class="text-link" href="/methodology/" data-event="methodology_cta_click">
            See How It Works
          </a>
        </div>
        <p class="hero__trust mono" data-reveal style="--reveal-delay:340ms">
          Built for discovery across Google · ChatGPT · Gemini · Claude · Grok
        </p>
      </div>
    </div>
  </section>

  <!-- Chapter 02: Method -->
  <section class="section section--ink" data-chapter aria-labelledby="home-method-heading">
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">The method</p>
        <h2 id="home-method-heading">Four steps from question to action.</h2>
        <MethodBadge />
        <p class="small" style="margin-top:1.2rem;">
          Every engagement follows the same observable sequence. Nothing is interpreted before the
          frame is fixed and the window is recorded.
        </p>
        <div class="button-row">
          <a class="text-link" href="/services/ai-search-visibility/">
            See the diagnostic deliverables
          </a>
        </div>
      </div>
      <MethodStory steps={methodSteps} />
    </div>
  </section>

  <!-- Chapter 03: Capabilities explorer -->
  <section class="section" data-chapter aria-labelledby="home-capabilities-heading">
    <span class="chapter-mark" aria-hidden="true">03</span>
    <div class="shell editorial-grid editorial-grid--balanced">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Launch capabilities</p>
        <h2 id="home-capabilities-heading">Focused enough to show the work.</h2>
        <p class="small">
          The launch scope covers AI-search visibility, measurement foundations and defined
          implementation work. Select a capability to inspect its scope.
        </p>
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <ServiceExplorer capabilities={capabilities} />
      </div>
    </div>
  </section>

  <!-- Free tools card -->
  <section class="section section--compact tools-card-section" aria-labelledby="tools-card-heading">
    <div class="shell">
      <a class="tools-card" href="/tools/" data-event="tools_card_click" data-reveal>
        <span class="tools-card__rule" aria-hidden="true"></span>
        <div class="tools-card__main">
          <span class="tools-card__label mono">
            <span class="tools-card__dot" aria-hidden="true"></span>
            Free tools · No signup · Run in your browser
          </span>
          <h2 id="tools-card-heading">Run our checks yourself. Right now.</h2>
          <p class="tools-card__copy">
            The same UTM validator, AI crawler access checker and website snapshot audit the
            DataDecision team runs before every engagement — free, nothing stored.
          </p>
        </div>
        <ul class="tools-card__list" aria-hidden="true">
          <li><span class="mono">01</span> UTM builder &amp; validator</li>
          <li><span class="mono">02</span> AI crawler access checker</li>
          <li><span class="mono">03</span> Website snapshot audit</li>
        </ul>
        <span class="tools-card__cta" aria-hidden="true">Open the tools →</span>
      </a>
    </div>
  </section>

  <!-- Chapter 04: Insights -->
  <section class="section section--bright" data-chapter aria-labelledby="home-insights-heading">
    <span class="chapter-mark" aria-hidden="true">04</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Measurement &amp; Lead-Source Truth</p>
        <h2 id="home-insights-heading">Resolve the questions between analytics and revenue.</h2>
        <p class="small">
          Six practical guides connect website activity, source fields, CRM records and closed-won
          value without pretending one platform can answer every question.
        </p>
        <a class="text-link" href="/insights/">View all insights</a>
      </div>
      <div class="home-insights">
        {
          featuredMeasurementInsights.map((entry, index) => (
            <a
              class:list={['home-insight', { 'home-insight--featured': entry.data.pillar }]}
              href={`/insights/${entry.id}/`}
              data-reveal
              style={`--reveal-delay:${index * 110}ms`}
            >
              <span class="mono">
                {String(index + 1).padStart(2, '0')} /{' '}
                {entry.data.pillar ? 'Foundational guide' : 'Supporting insight'}
              </span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Chapter 05: Evidence format -->
  <section class="section" data-chapter aria-labelledby="home-evidence-heading">
    <span class="chapter-mark" aria-hidden="true">05</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Evidence format</p>
        <h2 id="home-evidence-heading">Every recommendation answers four questions.</h2>
        <p class="small">
          What did we observe? What did the data miss? What should happen next? What can the
          evidence not prove?
        </p>
        <div class="button-row">
          <a class="text-link" href="/work/" data-event="benchmark_view">View sample output</a>
          <a class="text-link" href="/methodology/">Read the evidence standard</a>
        </div>
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <DecisionTabs questions={decisionQuestions} />
      </div>
    </div>
  </section>

  <!-- Chapter 06: Process and scope -->
  <section class="section section--ink" data-chapter aria-labelledby="home-process-heading">
    <span class="chapter-mark" aria-hidden="true">06</span>
    <div class="shell">
      <div class="editorial-grid editorial-grid--balanced" style="margin-bottom: 3rem;">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Process and scope</p>
          <h2 id="home-process-heading">A defined scope before kickoff.</h2>
        </div>
        <div data-reveal style="--reveal-delay:100ms">
          <p class="lede">
            The default diagnostic is deliberately narrow enough to repeat. Additions such as larger
            query sets, more markets, more languages or more runs require a written scope change.
          </p>
        </div>
      </div>
      <div class="process-rail">
        <div class="process-rail__step" data-process-step data-reveal>
          <span class="mono">01 / 15 business days</span><h3>Diagnostic</h3><p>
            Begins after required inputs and the written scope are complete.
          </p>
        </div>
        <div class="process-rail__step" data-process-step data-reveal style="--reveal-delay:110ms">
          <span class="mono">02 / optional</span><h3>Implementation sprint</h3><p>
            Fixed scope selected from the diagnostic, with additions agreed separately.
          </p>
        </div>
        <div class="process-rail__step" data-process-step data-reveal style="--reveal-delay:220ms">
          <span class="mono">03 / optional</span><h3>Measurement cadence</h3><p>
            Repeat observation and decision review only when the signal warrants it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 07: Founder -->
  <section class="section section--bright" data-chapter aria-labelledby="homepage-founder">
    <span class="chapter-mark" aria-hidden="true">07</span>
    <div class="shell editorial-grid editorial-grid--reverse">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Founder</p>
        <h2 id="homepage-founder">Accountability has a name.</h2>
      </div>
      <div class="founder-band" data-reveal style="--reveal-delay:120ms">
        <div class="founder-band__monogram" aria-hidden="true">AJ</div>
        <div>
          <p class="lede">
            Ashish Jha founded DataDecision. He is a graduate of NIT Surat and leads the firm’s
            AI-search visibility and measurement work.
          </p>
          <p class="measure">
            Ashish defines the observation frame, reviews the evidence and turns the findings into a
            practical next-step plan. The NIT Surat reference identifies his education and does not
            imply institutional endorsement.
          </p>
          <a class="text-link" href="/about/">Read about Ashish and the operating principles</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 08: Questions -->
  <section class="section" data-chapter aria-labelledby="home-faq-heading">
    <span class="chapter-mark" aria-hidden="true">08</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Essential questions</p><h2 id="home-faq-heading">
          What a cautious buyer should ask.
        </h2>
      </div>
      <div data-reveal style="--reveal-delay:100ms"><FAQList items={faqs} /></div>
    </div>
  </section>

  <FinalCTA />
  <script>
    /* Hero platform rotator: pauses off-screen, on hidden tab and under reduced motion */
    (function () {
      const rotator = document.querySelector<HTMLElement>('[data-rotator]');
      if (!rotator) return;
      const words = Array.from(rotator.querySelectorAll<HTMLElement>('.rotator__word'));
      if (!words.length) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0;
      let timer: number | null = null;
      let inView = true;

      words.forEach((word) => {
        word.hidden = false;
      });

      const show = (index: number) => {
        words[current].classList.remove('is-current');
        current = index;
        words[current].classList.add('is-current');
        rotator.dataset.platform = words[current].dataset.platform || 'chatgpt';
      };

      if (reduced.matches) {
        show(0);
        return;
      }

      const start = () => {
        if (timer !== null || reduced.matches || !inView || document.hidden) return;
        timer = window.setInterval(() => show((current + 1) % words.length), 2200);
      };
      const stop = () => {
        if (timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      const io = new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        if (inView) start();
        else stop();
      });
      io.observe(rotator);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });
      show(0);
      start();
    })();

    /* Process rail activation */
    const processSteps = document.querySelectorAll<HTMLElement>('[data-process-step]');
    if (processSteps.length && 'IntersectionObserver' in window) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches) {
        processSteps.forEach((step) => step.classList.add('is-active'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-active');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        processSteps.forEach((step) => observer.observe(step));
      }
    }
  </script>
</BaseLayout>
