---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQList from '../components/FAQList.astro';
import FinalCTA from '../components/FinalCTA.astro';

import StartFinder from '../components/StartFinder.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import HeroMedia from '../components/HeroMedia.astro';
import {
  Search,
  Sparkles,
  BarChart3,
  Megaphone,
  Globe,
  Bot,
  ArrowUpRight,
  ArrowRight,
  ArrowDown,
} from 'lucide-astro';
import '../styles/home-next.css';

const measurementCluster = (await getCollection('insights'))
  .filter((entry) => entry.data.cluster === 'Measurement & Lead-Source Truth')
  .sort((a, b) => {
    if (a.data.pillar !== b.data.pillar) return a.data.pillar ? -1 : 1;
    return a.data.title.localeCompare(b.data.title);
  });
const featuredMeasurementInsights = measurementCluster.slice(0, 3);

const faqs = [
  {
    question: 'Can you guarantee placement or citations in AI answers?',
    answer:
      'No. AI answers are nondeterministic and change with the engine, query, session and time. We document what appeared within the sampled window, repeat runs where the method calls for it, and never sell a ranking promise.',
  },
  {
    question: 'Which surfaces does the diagnostic cover?',
    answer:
      'The default scope covers up to four approved search and AI surfaces where access permits. The final engine set, access conditions and observation protocol are written into the methodology record before collection begins.',
  },
  {
    question: 'What is included in the standard scope?',
    answer:
      'Fifty buying-intent queries, one market, one language, up to four surfaces where access permits, two documented runs where methodologically appropriate, a technical access review, measurement-gap review and prioritized 90-day action plan.',
  },
  {
    question: 'How long does it take?',
    answer:
      'The standard delivery window is 15 business days after the required inputs are complete and the written scope is confirmed.',
  },
];

const showcaseServices = [
  {
    index: '01',
    href: '/services/seo/',
    icon: Search,
    title: 'Build organic demand.',
    body: 'Technical SEO and content built for qualified discovery.',
    label: 'SEO services',
    tone: 'search',
  },
  {
    index: '02',
    href: '/services/ai-search-visibility/',
    icon: Sparkles,
    title: 'Show up in AI answers.',
    body: 'Find where your brand appears, what shapes the answer and what to improve.',
    label: 'AI search visibility',
    tone: 'visibility',
  },
  {
    index: '03',
    href: '/services/measurement-foundation/',
    icon: BarChart3,
    title: 'Know what drives pipeline.',
    body: 'Connect GA4, campaign sources and your CRM.',
    label: 'GA4 & attribution',
    tone: 'measurement',
  },
  {
    index: '04',
    href: '/services/#paid-acquisition-performance',
    icon: Megaphone,
    title: 'Paid Media & Demand',
    body: 'Google, Meta and LinkedIn campaigns measured against qualified pipeline.',
    label: 'Paid acquisition',
    tone: 'paid',
  },
  {
    index: '05',
    href: '/services/#ai-agent-development',
    icon: Bot,
    title: 'Custom AI Agents',
    body: 'Automate research and reporting with human review and guardrails.',
    label: 'AI automation',
    tone: 'agents',
  },
  {
    index: '06',
    href: '/services/website-development-seo/',
    icon: Globe,
    title: 'Website Development',
    body: 'Fast websites with SEO, schema and measurement built in.',
    label: 'Build + SEO',
    tone: 'build',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="B2B SaaS Growth & SEO Consultancy | Data Decision Consulting"
  description="Founder-led growth and SEO consultancy for B2B SaaS: SEO and AI-search visibility services, GA4 measurement and attribution consulting, paid acquisition and conversion: evidence-first, no guarantees."
  path="/"
  schema={schema}
>
  <div class="home-next">
    <section class="signal-hero" aria-labelledby="hero-heading">
      <div class="shell signal-hero__grid">
        <div class="signal-hero__copy">
          <p class="hero-kicker"><span aria-hidden="true"></span> For ambitious B2B SaaS teams</p>
          <h1 id="hero-heading">Turn discovery<br />into <em>demand.</em></h1>
          <p class="signal-hero__intro">
            Be easier to find. Harder to overlook. Connect SEO and AI visibility to the pipeline
            that matters.
          </p>
          <div class="signal-hero__actions">
            <a
              class="button button--primary"
              href="/contact/?service=web-seo-ai-visibility#request-a-brief"
              data-event="cta_primary_click"
              >Find my growth opportunity <ArrowUpRight size={19} aria-hidden="true" /></a
            >
            <a class="hero-explore" href="#home-services"
              >Explore services <ArrowDown size={17} aria-hidden="true" /></a
            >
          </div>
          <div class="hero-principles">
            <span>Founder-led.</span><span>Evidence-first.</span><span>Built to act on.</span>
          </div>
        </div>
        <div class="signal-hero__visual">
          <span class="visual-caption"
            ><Sparkles size={15} aria-hidden="true" /> A new era of discovery</span
          >
          <HeroMedia />
          <a
            class="visual-question"
            href="/services/ai-search-visibility/"
            data-event="hero_ai_service_click"
            ><span>When buyers ask AI,<br /><strong>does your brand come up?</strong></span><span
              class="visual-question__arrow"><ArrowUpRight size={22} aria-hidden="true" /></span
            ></a
          >
        </div>
      </div>
      <div class="shell discovery-links" aria-label="Explore our core services">
        <p>From the first search<br /><strong>to the next customer.</strong></p>
        <a href="/services/seo/"
          ><Search size={21} aria-hidden="true" /><span>Organic search</span><ArrowUpRight
            size={17}
            aria-hidden="true"
          /></a
        >
        <a href="/services/ai-search-visibility/"
          ><Sparkles size={21} aria-hidden="true" /><span>AI visibility</span><ArrowUpRight
            size={17}
            aria-hidden="true"
          /></a
        >
        <a href="/services/measurement-foundation/"
          ><BarChart3 size={21} aria-hidden="true" /><span>Revenue clarity</span><ArrowUpRight
            size={17}
            aria-hidden="true"
          /></a
        >
      </div>
    </section>

    <!-- Chapter 01b: Services showcase -->
    <section id="home-services" class="showcase" aria-labelledby="showcase-heading">
      <div class="shell">
        <div class="showcase__head">
          <div>
            <p class="eyebrow">Your next advantage</p><h2 id="showcase-heading">
              Make the next move<br />the right one.
            </h2>
          </div><p>Choose the gap you want to close.<br />We’ll help you connect the pieces.</p>
        </div>
        <div
          class="service-filters"
          data-service-filters
          hidden
          role="group"
          aria-label="Filter services by goal"
        >
          <button type="button" data-service-filter="all" aria-pressed="true">All services</button>
          <button type="button" data-service-filter="discovery" aria-pressed="false"
            >Get discovered</button
          >
          <button type="button" data-service-filter="revenue" aria-pressed="false"
            >Grow revenue</button
          >
          <button type="button" data-service-filter="automation" aria-pressed="false"
            >Automate work</button
          >
        </div>
        <p class="sr-only" data-service-count role="status"></p>
        <div class="showcase__grid">
          {
            showcaseServices.map((service) => (
              <ShowcaseCard
                href={service.href}
                index={service.index}
                title={service.title}
                body={service.body}
                label={service.label}
                tone={service.tone}
                group={
                  ['search', 'visibility', 'build'].includes(service.tone)
                    ? 'discovery'
                    : service.tone === 'agents'
                      ? 'automation'
                      : 'revenue'
                }
              >
                <service.icon strokeWidth={1.75} aria-hidden="true" />
              </ShowcaseCard>
            ))
          }
        </div>
        <a class="all-services-link" href="/services/" data-event="showcase_all_services"
          >Compare all services <ArrowRight size={19} aria-hidden="true" /></a
        >
      </div>
    </section>

    <StartFinder />

    <!-- Chapter 03: Insights -->
    <section
      class="section section--compact section--bright home-insights-section"
      data-chapter
      aria-labelledby="home-insights-heading"
    >
      <span class="chapter-mark" aria-hidden="true">03</span>
      <div class="shell editorial-grid">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Practical answers</p>
          <h2 id="home-insights-heading">Good questions. Clear answers.</h2>
          <a class="text-link" href="/insights/">Explore the insights</a>
        </div>
        <div class="home-insights">
          {
            featuredMeasurementInsights.map((entry, index) => (
              <a
                class:list={['home-insight', { 'home-insight--featured': entry.data.pillar }]}
                href={`/insights/${entry.id}/`}
                data-reveal
                style={`--reveal-delay:${index * 110}ms`}
              >
                <span class="mono">{entry.data.pillar ? 'Start here' : 'Measurement guide'}</span>
                <>
                  <h3>{entry.data.title}</h3>
                  <span class="home-insight__action">
                    Read the guide <span aria-hidden="true">↗</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-owner" aria-labelledby="home-owner-title">
      <div class="shell home-owner__inner">
        <div>
          <p class="eyebrow">Founder-led</p><h2 id="home-owner-title">
            Work directly with Ashish.
          </h2><p>
            Ashish Jha, founder and NIT Surat graduate, leads our AI-search visibility and
            measurement work.
          </p>
        </div>
        <a class="button button--primary" href="/about/">Meet your consultant</a>
      </div>
    </section>

    <!-- Chapter 06: Questions -->
    <section
      class="section section--compact home-faq"
      data-chapter
      aria-labelledby="home-faq-heading"
    >
      <span class="chapter-mark" aria-hidden="true">06</span>
      <div class="shell editorial-grid">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">Essential questions</p><h2 id="home-faq-heading">Before you begin.</h2>
        </div>
        <div data-reveal style="--reveal-delay:100ms"><FAQList items={faqs} /></div>
      </div>
    </section>

    <FinalCTA
      heading="Let’s find your next advantage."
      body="Bring your growth challenge. Leave with a clear scope and a practical next step."
      label="Start a conversation"
    />
  </div>
  <script>
    const filters = document.querySelector<HTMLElement>('[data-service-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-service-group]'));
    const resultCount = document.querySelector<HTMLElement>('[data-service-count]');
    if (filters && cards.length) {
      filters.hidden = false;
      const buttons = Array.from(
        filters.querySelectorAll<HTMLButtonElement>('[data-service-filter]'),
      );
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const group = button.dataset.serviceFilter;
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          cards.forEach((card) => {
            card.hidden = group !== 'all' && card.dataset.serviceGroup !== group;
          });
          if (resultCount)
            resultCount.textContent =
              cards.filter((card) => !card.hidden).length + ' services shown';
        }),
      );
    }
  </script>
</BaseLayout>
