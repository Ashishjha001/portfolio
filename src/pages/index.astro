<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DataDecision | Engineered Intelligence</title>
    <meta name="description" content="AI engineering laboratory and premium data consulting firm." />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <style>
        :root {
            /* Color System */
            --graphite: #0a0a0c;
            --graphite-light: #121215;
            --graphite-border: #1f1f24;
            --off-white: #f8f9fa;
            --warm-white: #f1f3f5;
            --electric-blue: #0055FF;
            --electric-blue-glow: rgba(0, 85, 255, 0.2);
            --cyan-accent: #00E5FF;
            
            /* Typography */
            --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            
            /* Animation */
            --transition-smooth: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html { scroll-behavior: smooth; }
        
        body {
            font-family: var(--font-sans);
            background: var(--graphite);
            color: var(--off-white);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Typography */
        h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
        h1 { font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: -0.04em; }
        h2 { font-size: clamp(2.5rem, 5vw, 4rem); }
        h3 { font-size: 1.5rem; }
        p { color: #a1a1aa; font-weight: 400; }
        
        .eyebrow {
            display: inline-block;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--electric-blue);
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        a { text-decoration: none; color: inherit; }
        
        /* Layout */
        .container { max-width: 1440px; margin: 0 auto; padding: 0 5%; }
        .section { padding: 160px 0; position: relative; }
        
        /* Reveal Animation */
        .reveal { opacity: 0; transform: translateY(30px); transition: all 1s var(--transition-smooth); filter: blur(4px); }
        .reveal.visible { opacity: 1; transform: translateY(0); filter: blur(0); }
        .delay-1 { transition-delay: 0.1s; }
        .delay-2 { transition-delay: 0.2s; }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            border-radius: 2px;
            transition: all 0.3s var(--transition-smooth);
            cursor: pointer;
        }
        .btn-primary {
            background: var(--electric-blue);
            color: white;
            border: 1px solid var(--electric-blue);
            box-shadow: 0 0 20px var(--electric-blue-glow);
        }
        .btn-primary:hover {
            background: transparent;
            box-shadow: 0 0 30px var(--electric-blue-glow);
        }
        .btn-outline {
            background: transparent;
            color: var(--off-white);
            border: 1px solid var(--graphite-border);
        }
        .btn-outline:hover {
            border-color: var(--electric-blue);
            color: var(--electric-blue);
        }

        /* Navigation */
        .navbar {
            position: fixed; top: 0; width: 100%; z-index: 100;
            background: rgba(10, 10, 12, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--graphite-border);
            padding: 20px 0;
            transition: all 0.3s ease;
        }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; }
        .logo-img { height: 24px; filter: invert(1); mix-blend-mode: screen; }
        .nav-links { display: flex; gap: 32px; align-items: center; }
        .nav-links a { font-size: 0.85rem; font-weight: 500; color: #a1a1aa; transition: color 0.2s; }
        .nav-links a:hover { color: var(--off-white); }
        
        @media(max-width: 1024px) {
            .nav-links { display: none; }
        }

        /* Technical Background (Hero) */
        .tech-canvas {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1; opacity: 0.4;
        }

        /* Hero */
        .hero { min-height: 100vh; display: flex; align-items: center; padding-top: 100px; }
        .hero-content { max-width: 800px; }
        .hero p { font-size: 1.25rem; line-height: 1.7; margin-top: 2rem; margin-bottom: 3rem; max-width: 600px; }
        
        /* Technology Section (Dark) */
        .tech-section { background: var(--graphite-light); border-top: 1px solid var(--graphite-border); border-bottom: 1px solid var(--graphite-border); }
        .flow-container {
            display: flex; justify-content: space-between; align-items: center; margin-top: 80px;
            position: relative;
        }
        .flow-node {
            background: var(--graphite);
            border: 1px solid var(--graphite-border);
            padding: 30px;
            border-radius: 2px;
            z-index: 2;
            width: 22%;
            position: relative;
            transition: all 0.5s var(--transition-smooth);
        }
        .flow-node:hover {
            border-color: var(--electric-blue);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px var(--electric-blue-glow);
        }
        .flow-node h4 { color: var(--electric-blue); font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 10px; }
        .flow-node p { font-size: 0.9rem; color: #a1a1aa; margin:0; }
        
        .flow-line {
            position: absolute; top: 50%; left: 0; width: 100%; height: 1px;
            background: var(--graphite-border); z-index: 1;
        }
        .flow-line-active {
            position: absolute; top: 50%; left: 0; height: 1px;
            background: var(--electric-blue); z-index: 1;
            width: 0%;
            box-shadow: 0 0 10px var(--electric-blue);
            animation: pulse-line 3s infinite linear;
        }
        @keyframes pulse-line {
            0% { width: 0%; opacity: 0; }
            50% { opacity: 1; }
            100% { width: 100%; opacity: 0; }
        }
        @media(max-width: 768px) {
            .flow-container { flex-direction: column; gap: 20px; }
            .flow-node { width: 100%; }
            .flow-line, .flow-line-active { display: none; }
        }

        /* Expertise Section (Light/Technical) */
        .expertise-section { background: var(--warm-white); color: var(--graphite); }
        .expertise-section p { color: #52525b; }
        .expertise-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: #e4e4e7; border: 1px solid #e4e4e7; margin-top: 80px; }
        .exp-card {
            background: var(--white); padding: 60px 40px; position: relative; overflow: hidden;
            transition: all 0.4s var(--transition-smooth);
        }
        .exp-num { font-size: 0.85rem; font-weight: 600; color: #a1a1aa; margin-bottom: 20px; display: block; }
        .exp-card h3 { color: var(--graphite); margin-bottom: 15px; }
        .exp-card p { opacity: 0; transform: translateY(10px); transition: all 0.4s var(--transition-smooth); height: 0; }
        .exp-explore { margin-top: 20px; font-size: 0.85rem; font-weight: 600; color: var(--electric-blue); display: flex; align-items: center; gap: 5px; opacity: 1; transition: all 0.3s; }
        
        .exp-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.05); z-index: 10; border-bottom: 2px solid var(--electric-blue); }
        .exp-card:hover p { opacity: 1; transform: translateY(0); height: auto; margin-top: 15px; }
        
        @media(max-width: 768px) { .expertise-grid { grid-template-columns: 1fr; } .exp-card p { opacity: 1; height: auto; transform: none; } }

        /* Industries Section */
        .industries-section { background: var(--graphite); }
        .ind-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 80px; }
        .ind-card {
            border: 1px solid var(--graphite-border);
            padding: 40px;
            background: var(--graphite-light);
            transition: all 0.4s var(--transition-smooth);
            position: relative;
            overflow: hidden;
        }
        .ind-card::after {
            content: ''; position: absolute; bottom: 0; left: 0; width: 0%; height: 2px;
            background: var(--cyan-accent); transition: width 0.4s var(--transition-smooth);
        }
        .ind-card:hover { border-color: var(--electric-blue); transform: translateY(-5px); }
        .ind-card:hover::after { width: 100%; }
        .ind-card h4 { font-size: 1.25rem; margin-bottom: 10px; }
        @media(max-width: 768px) { .ind-grid { grid-template-columns: 1fr; } }

        /* Case Studies Section (Warm Light) */
        .case-studies { background: var(--off-white); color: var(--graphite); }
        .case-studies h2 { color: var(--graphite); }
        .cs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; margin-top: 80px; }
        .cs-card {
            display: block;
            border: 1px solid #e4e4e7;
            background: var(--white);
            padding: 40px;
            transition: all 0.4s var(--transition-smooth);
        }
        .cs-card:hover { transform: translateY(-5px) scale(1.01); box-shadow: 0 20px 40px rgba(0,0,0,0.08); border-color: var(--electric-blue); }
        .cs-card .eyebrow { margin-bottom: 10px; }
        .cs-card h3 { color: var(--graphite); margin-bottom: 15px; font-size: 1.75rem; }
        .cs-card p { color: #52525b; margin-bottom: 30px; }
        .cs-explore { font-size: 0.85rem; font-weight: 600; color: var(--electric-blue); display: flex; align-items: center; gap: 8px; transition: gap 0.3s; }
        .cs-card:hover .cs-explore { gap: 12px; }
        @media(max-width: 768px) { .cs-grid { grid-template-columns: 1fr; } }

        /* Insights */
        .insights { background: var(--graphite); border-top: 1px solid var(--graphite-border); }
        .ins-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 60px; }
        .ins-card {
            border: 1px solid var(--graphite-border);
            padding: 30px;
            transition: all 0.3s;
        }
        .ins-card:hover { border-color: var(--electric-blue); background: var(--graphite-light); }
        .ins-card .date { font-size: 0.75rem; color: #71717a; margin-bottom: 15px; display: block; }
        .ins-card h4 { font-size: 1.1rem; line-height: 1.4; }
        @media(max-width: 1024px) { .ins-grid { grid-template-columns: repeat(2, 1fr); } }
        @media(max-width: 768px) { .ins-grid { grid-template-columns: 1fr; } }

        /* Careers & Contact */
        .careers { background: var(--graphite-light); }
        .contact-section { background: var(--graphite); border-top: 1px solid var(--graphite-border); text-align: center; }
        .contact-section h2 { margin-bottom: 20px; }
        .contact-section p { margin: 0 auto 40px; max-width: 600px; }

        /* Footer */
        .footer { background: #050505; padding: 80px 0 40px; border-top: 1px solid var(--graphite-border); }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 60px; }
        .footer-links h4 { font-size: 0.85rem; color: var(--off-white); margin-bottom: 20px; letter-spacing: 1px; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links a { color: #a1a1aa; font-size: 0.85rem; transition: color 0.2s; }
        .footer-links a:hover { color: var(--electric-blue); }
        .footer-bottom { border-top: 1px solid var(--graphite-border); padding-top: 30px; display: flex; justify-content: space-between; font-size: 0.8rem; color: #71717a; }
        
        @media(max-width: 768px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
    </style>
</head>
