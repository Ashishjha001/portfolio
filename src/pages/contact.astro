---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { entityDefinition, organizationReference } from '../data/entityDefinition';
---

<BaseLayout
  title="Request a B2B SaaS SEO or Measurement Diagnostic | Data Decision Consulting"
  description="Brief Data Decision Consulting on the B2B SaaS SEO, AI-search visibility, GA4 or attribution question your team needs to answer next."
  path="/contact/"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Request a B2B SaaS SEO or measurement diagnostic',
    url: 'https://datadecision.consulting/contact/',
    email: entityDefinition.email,
    mainEntity: organizationReference,
  }}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">Request a diagnostic</p><h1>
        Start with the decision you need to make.
      </h1><p class="lede">
        Tell us what is difficult to find, measure or decide. We will test whether an SEO and
        AI-search diagnostic or a GA4 and attribution review can answer it.
      </p>
    </div><aside class="page-hero__aside" data-reveal style="--reveal-delay:120ms">
      <div class="folio"><span>What happens next</span><span>03 steps</span></div><div
        class="rule-list"
      >
        <div class="rule-row rule-row--slim">
          <span class="mono">01</span><div>
            <h3>Submit one brief</h3><p>Use the form or email the same information directly.</p>
          </div>
        </div><div class="rule-row rule-row--slim">
          <span class="mono">02</span><div>
            <h3>Fit review</h3><p>We check the question, evidence needs and scope fit.</p>
          </div>
        </div><div class="rule-row rule-row--slim">
          <span class="mono">03</span><div>
            <h3>Written scope</h3><p>
              Final frame, fee, inputs, timing and limitations before kickoff.
            </p>
          </div>
        </div>
      </div>
      <div class="caveat">
        <span class="evidence-label">Before work begins</span>
        Delivery starts only after the written scope is accepted and required inputs are complete. The
        enquiry does not create a charge or an automatic calendar booking.
      </div>
    </aside>
  </header>
  <section
    id="request-a-brief"
    class="section contact-form-section"
    aria-labelledby="diagnostic-brief"
  >
    <span class="chapter-mark" aria-hidden="true">01</span>
    <div class="shell editorial-grid editorial-grid--balanced">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Request a brief</p><h2 id="diagnostic-brief">
          Tell us what you need to grow.
        </h2><p class="small">
          Share the business question, your website and the service area you are exploring. We will
          review fit before proposing scope. You can also email <a
            href="mailto:contact@datadecision.consulting">contact@datadecision.consulting</a
          >.
        </p>
        <div class="scope-summary" aria-label="Ways to start">
          <p class="evidence-label">Two focused ways to start</p>
          <dl>
            <div>
              <dt>SEO &amp; AI search</dt><dd>
                Find technical, content and answer-visibility gaps that affect qualified discovery.
              </dd>
            </div>
            <div>
              <dt>GA4 &amp; attribution</dt><dd>
                Trace where analytics, referral and CRM records stop agreeing.
              </dd>
            </div>
            <div>
              <dt>Before kickoff</dt><dd>
                Receive a written scope with the fee, inputs, timing, outputs and limitations.
              </dd>
            </div>
          </dl>
        </div>
      </div><div data-reveal style="--reveal-delay:120ms"><ContactForm /></div>
    </div>
  </section>
  <section class="section section--bright">
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell editorial-grid editorial-grid--reverse">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Bring if available</p><h2>Inputs that make the first review sharper.</h2>
      </div><div class="comparison" data-reveal style="--reveal-delay:110ms">
        <div>
          <h3>Visibility context</h3><ul>
            <li>Your product category and primary market.</li><li>
              Three to five products buyers compare.
            </li><li>Questions buyers ask before a shortlist.</li>
          </ul>
        </div><div class="comparison__rule"></div><div>
          <h3>Measurement context</h3><ul>
            <li>The dashboard or CRM disagreement.</li><li>Current tracking constraints.</li><li>
              The decision and deadline this work should support.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
