---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCTA from '../components/FinalCTA.astro';
import StrategicAreas from '../components/StrategicAreas.astro';

const playbooks = (await getCollection('insights'))
  .filter((entry) => entry.data.cluster === 'Service Playbooks')
  .sort((a, b) => {
    if (a.data.pillar !== b.data.pillar) return a.data.pillar ? -1 : 1;
    return a.data.title.localeCompare(b.data.title);
  });
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'DataDecision implementation playbooks',
  description:
    'Practical DataDecision playbooks for SEO, AI search, paid acquisition, conversion, measurement, AI agents and GPT integrations.',
  url: 'https://datadecision.consulting/playbooks/',
  hasPart: playbooks.map((entry) => ({
    '@type': 'Article',
    name: entry.data.title,
    url: `https://datadecision.consulting/insights/${entry.id}/`,
  })),
};
---

<BaseLayout
  title="Implementation playbooks | DataDecision"
  description="See how DataDecision approaches SEO, AI search, paid acquisition, conversion, measurement, AI agents and GPT integrations before a scope is written."
  path="/playbooks/"
  schema={schema}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Playbooks' }]} />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">Implementation playbooks</p>
      <h1>See how the work gets done before you buy it.</h1>
      <p class="lede">
        These playbooks explain the inputs, sequence, artifacts, measurement and limits behind our
        services. They are practical guides, not substitute case studies or promises of a result.
      </p>
    </div>
    <aside class="page-hero__aside" data-reveal style="--reveal-delay:120ms">
      <div class="folio">
        <span>Published library</span><span>{playbooks.length} playbooks</span>
      </div>
      <div class="caveat">
        <span class="evidence-label">How to use them</span>
        Start with the playbook closest to your constraint. Then use the related strategic area to understand
        how it fits the wider growth system.
      </div>
    </aside>
  </header>

  <StrategicAreas heading="Find the playbook through the decision it supports." />

  <section class="section section--ink" aria-labelledby="playbook-list-heading">
    <span class="chapter-mark" aria-hidden="true">01</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Published playbooks</p>
        <h2 id="playbook-list-heading">From question to implementation.</h2>
        <p class="small">
          The article copy, titles and publication records remain exactly as originally published.
        </p>
      </div>
      <ol class="playbook-list" data-reveal style="--reveal-delay:100ms">
        {
          playbooks.map((entry, index) => (
            <li>
              <a href={`/insights/${entry.id}/`}>
                <span class="mono">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <span class="evidence-label">
                    {entry.data.pillar ? 'Foundational playbook' : 'Service playbook'}
                  </span>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </div>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="playbook-standard-heading">
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell editorial-grid editorial-grid--balanced">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">The common standard</p>
        <h2 id="playbook-standard-heading">A method should expose its decisions and its limits.</h2>
      </div>
      <div class="playbook-standard" data-reveal style="--reveal-delay:100ms">
        <p>
          Each engagement still needs a written scope. The playbook shows the logic behind the work,
          while the scope names the systems, market, evidence available, acceptance criteria and
          commercial treatment for the specific situation.
        </p>
        <a class="text-link" href="/methodology/">Read the evidence standard</a>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Found the playbook that matches your problem?"
    body="Send us the business question and the systems involved. We will confirm whether the work is a fit before proposing a scope."
    label="Discuss the implementation"
  />
</BaseLayout>

<style>
  .playbook-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--paper) 30%, transparent);
  }

  .playbook-list li {
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
  }

  .playbook-list a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
  }

  .playbook-list .mono {
    color: var(--signal);
    font-size: 0.65rem;
  }

  .playbook-list h3 {
    margin: 0.35rem 0;
    font-size: 1.2rem;
  }

  .playbook-list p {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .playbook-list a:hover h3,
  .playbook-list a:focus-visible h3 {
    color: var(--signal);
  }

  .playbook-standard {
    max-width: 62ch;
  }

  .playbook-standard p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  @media (max-width: 600px) {
    .playbook-list a {
      grid-template-columns: 2rem 1fr;
    }

    .playbook-list a > span:last-child {
      display: none;
    }
  }
</style>
