---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCTA from '../components/FinalCTA.astro';
import FounderSocialLinks from '../components/FounderSocialLinks.astro';
import { founderSchema, organizationReference } from '../data/entityDefinition';
---

<BaseLayout
  title="About Data Decision Consulting and founder Ashish Jha"
  description="Data Decision Consulting is a founder-led growth and SEO consultancy for B2B SaaS. Meet founder Ashish Jha and read the principles behind its SEO, AI-search visibility and measurement work."
  path="/about/"
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      name: 'About Data Decision Consulting',
      url: 'https://datadecision.consulting/about/',
      mainEntity: organizationReference,
    },
    founderSchema,
  ]}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">About Data Decision Consulting</p><h1>
        A focused practice for better growth decisions.
      </h1>
      <p class="lede">
        A founder-led growth and SEO consultancy for B2B SaaS teams: SEO, AI-search visibility and
        the measurement path into pipeline, with the evidence attached to every recommendation.
      </p>
    </div><aside class="page-hero__aside" data-reveal style="--reveal-delay:120ms">
      <div class="folio"><span>Company description</span><span>01 line</span></div>
      <p class="lede">
        SEO and AI-search visibility, measurement foundations and scoped implementation for B2B SaaS
        teams.
      </p>
    </aside>
  </header>

  <section class="section" aria-labelledby="founder-heading">
    <span class="chapter-mark" aria-hidden="true">01</span>
    <div class="shell founder-record">
      <div class="founder-record__identity" data-reveal>
        <p class="eyebrow">Founder</p>
        <h2 id="founder-heading">Ashish Jha</h2>
        <p class="small">Founder, Data Decision Consulting<br />Graduate, NIT Surat</p>
        <a class="text-link" href="mailto:contact@datadecision.consulting">
          contact@datadecision.consulting
        </a>
        <FounderSocialLinks />
      </div>
      <div class="founder-record__body" data-reveal style="--reveal-delay:120ms">
        <p class="lede">
          Ashish Jha founded Data Decision Consulting to build a growth and SEO practice where the
          measurement path, from search and AI surfaces into pipeline, is built before the
          recommendations are.
        </p>
        <p class="measure">
          Ashish defines the observation frame before interpreting the output, keeps the important
          limits visible and recommends work the evidence can support. That discipline shapes every
          Data Decision Consulting engagement.
        </p>
        <dl class="founder-record__facts">
          <div>
            <dt>Education</dt>
            <dd>NIT Surat</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="why-heading">
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell editorial-grid editorial-grid--reverse">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Why this exists</p><h2 id="why-heading">
          Evidence should survive the handoff.
        </h2>
      </div><div data-reveal style="--reveal-delay:110ms">
        <p class="lede">
          A useful growth number should carry enough context to make a decision. That matters as
          discovery spreads across search pages, generated answers, review sources and conversations
          that no single dashboard can fully observe.
        </p><p class="measure">
          Data Decision Consulting concentrates on the measurement layer: establish what is visible,
          identify what the existing stack misses and rank the work most likely to improve the next
          decision.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <span class="chapter-mark" aria-hidden="true">03</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Operating principles</p><h2 id="principles-heading">
          How the work is judged.
        </h2>
      </div><div class="rule-list" data-reveal style="--reveal-delay:110ms">
        <div class="rule-row">
          <span class="mono">01</span><div>
            <h3>Start with the observation</h3><p>
              Describe what happened, when it happened and how it was recorded.
            </p>
          </div><span class="rule-row__meta">Claim discipline</span>
        </div><div class="rule-row">
          <span class="mono">02</span><div>
            <h3>Record the baseline</h3><p>
              Establish the starting point before proposing a change.
            </p>
          </div><span class="rule-row__meta">Comparability</span>
        </div><div class="rule-row">
          <span class="mono">03</span><div>
            <h3>Publish the method</h3><p>
              Publish the rules needed to interrogate a number without disclosing private client
              data.
            </p>
          </div><span class="rule-row__meta">Transparency</span>
        </div><div class="rule-row">
          <span class="mono">04</span><div>
            <h3>Name uncertainty precisely</h3><p>
              Record unknown, unavailable and ambiguous observations as separate states.
            </p>
          </div><span class="rule-row__meta">Honesty</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="relationship-heading">
    <span class="chapter-mark" aria-hidden="true">04</span>
    <div class="shell editorial-grid editorial-grid--balanced">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Working relationship</p><h2 id="relationship-heading">
          Clear access and clear handoffs.
        </h2>
      </div><div data-reveal style="--reveal-delay:110ms">
        <p class="lede">
          You work directly with Ashish from the first fit review through the final Decision Board.
          Before work begins, you receive a written scope covering the question, inputs, timing, fee
          and expected deliverables.
        </p>
      </div>
    </div>
  </section>
  <FinalCTA heading="Start with a question the evidence can answer." />
</BaseLayout>
