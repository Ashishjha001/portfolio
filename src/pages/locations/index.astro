---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQList from '../../components/FAQList.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { organizationReference } from '../../data/entityDefinition';

const faqs = [
  {
    question: 'Do you work only with businesses in Surat?',
    answer:
      'No. Data Decision Consulting works remotely with suitable B2B teams in India and other markets. Surat has a dedicated page because we have documented enough specific public-market context to make that page useful. Other enquiries begin through the relevant service page rather than a generic city page.',
  },
  {
    question: 'Are location pages the same as local offices?',
    answer:
      'No. A market page describes who a remote service is designed for; it does not represent a physical office. We do not publish addresses, staff, reviews or local-business schema for locations we do not operate.',
  },
  {
    question: 'Can a remote consultancy support an international team?',
    answer:
      'Yes, when the work can be delivered through agreed access, asynchronous collaboration and scheduled reviews. Geography, working hours, invoicing and decision ownership are confirmed before the engagement is accepted.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Markets served remotely by Data Decision Consulting',
    url: 'https://datadecision.consulting/locations/',
    description:
      'Evidence-led market pages for remote SEO, AI-search visibility, paid acquisition and marketing measurement services.',
    about: organizationReference,
    hasPart: [
      {
        '@type': 'WebPage',
        name: 'B2B SEO and digital growth services for Surat manufacturers and exporters',
        url: 'https://datadecision.consulting/locations/surat/',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="Markets Served Remotely | Data Decision Consulting"
  description="Evidence-led market pages for Data Decision Consulting's remote SEO, AI-search visibility, paid acquisition and marketing measurement services."
  path="/locations/"
  schema={schema}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Locations' }]} />

  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">Remote service · Evidence-gated pages</p>
      <h1>We serve teams remotely. We publish a market page only when it adds real context.</h1>
      <p class="lede">
        A city name is not a strategy. Every dedicated market page must contain distinct buyer and
        industry research, clear delivery boundaries and sources a reader can check. Surat is the
        first market to meet that standard.
      </p>
      <div class="button-row">
        <a class="button button--primary" href="/locations/surat/">Explore Surat services</a>
        <a class="text-link" href="/services/">See all services</a>
      </div>
    </div>
  </header>

  <section class="section" aria-labelledby="published-market-heading">
    <span class="chapter-mark" aria-hidden="true">01</span>
    <div class="shell editorial-grid editorial-grid--balanced">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Published market · Surat</p>
        <h2 id="published-market-heading">For manufacturers, exporters and B2B teams in Surat.</h2>
        <p>
          Grounded in Gujarat government sources on the region's textile, diamond, engineering and
          small-industry context.
        </p>
      </div>
      <a class="market-card" href="/locations/surat/" data-reveal style="--reveal-delay:110ms">
        <span class="mono">Surat, Gujarat · Remote delivery</span>
        <h3>SEO and digital growth for Surat manufacturers and exporters.</h3>
        <p>
          Website, SEO, AI-search visibility, paid acquisition and measurement,selected after the
          commercial question is defined.
        </p>
        <span class="text-link">View the evidence-backed market page →</span>
      </a>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="remote-work-heading">
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Outside Surat</p>
        <h2 id="remote-work-heading">Start with the service and the business problem.</h2>
      </div>
      <div class="rule-list" data-reveal style="--reveal-delay:110ms">
        <div class="rule-row">
          <span class="mono">01</span>
          <div>
            <h3><a href="/services/seo/">B2B SEO services</a></h3><p>
              Technical access, intent-led architecture, useful content and measurable organic
              demand.
            </p>
          </div>
          <span class="rule-row__meta">Search</span>
        </div>
        <div class="rule-row">
          <span class="mono">02</span>
          <div>
            <h3><a href="/services/ai-search-visibility/">AI-search visibility</a></h3><p>
              Dated observation across approved answer surfaces, source review and prioritized
              improvements.
            </p>
          </div>
          <span class="rule-row__meta">AEO / GEO</span>
        </div>
        <div class="rule-row">
          <span class="mono">03</span>
          <div>
            <h3><a href="/services/google-ads-management/">Paid acquisition</a></h3><p>
              Google and Meta campaigns connected to landing pages, conversion signals and qualified
              outcomes.
            </p>
          </div>
          <span class="rule-row__meta">Ads</span>
        </div>
        <div class="rule-row">
          <span class="mono">04</span>
          <div>
            <h3>
              <a href="/services/measurement-foundation/">GA4 and attribution consulting</a>
            </h3><p>Measurement from source and campaign through CRM stages and revenue.</p>
          </div>
          <span class="rule-row__meta">Measurement</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="locations-faq-heading">
    <span class="chapter-mark" aria-hidden="true">03</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Questions</p>
        <h2 id="locations-faq-heading">What remote service means here.</h2>
      </div>
      <div data-reveal style="--reveal-delay:110ms"><FAQList items={faqs} /></div>
    </div>
  </section>

  <FinalCTA
    heading="Tell us where you compete and what growth must produce."
    body="We will review the market, service fit and measurement access before proposing a scope or publishing another location claim."
    label="Request a diagnostic"
  />

  <style>
    .market-card {
      display: grid;
      gap: 0.8rem;
      align-content: start;
      padding: clamp(1.25rem, 3vw, 2rem);
      border: 1px solid var(--rule);
      color: inherit;
      text-decoration: none;
      background: var(--paper);
      transition:
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 180ms ease;
    }

    .market-card:hover,
    .market-card:focus-visible {
      transform: translateY(-3px);
      border-color: var(--signal);
    }

    .market-card h3 {
      max-width: 22ch;
      font-family: var(--font-display);
      font-size: clamp(1.55rem, 3vw, 2.35rem);
      line-height: 1.08;
    }

    .market-card p {
      max-width: 58ch;
      color: var(--muted);
    }

    @media (prefers-reduced-motion: reduce) {
      .market-card {
        transition: none;
      }
    }
  </style>
</BaseLayout>
