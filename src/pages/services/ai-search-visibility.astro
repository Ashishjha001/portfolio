---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MethodBadge from '../../components/MethodBadge.astro';
import DecisionTabs from '../../components/DecisionTabs.astro';
import FAQList from '../../components/FAQList.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const faqs = [
  {
    question: 'How stable are the observations?',
    answer:
      'Each result belongs to a defined observation window. Repeated runs can show whether an observation appears again, while engine, session and prompt variance still affect the answer.',
  },
  {
    question: 'How often should the baseline be repeated?',
    answer:
      'The cadence should follow the decision. A major launch or remediation program may justify a shorter interval; a stable category may not. The method records cadence before collection so frequency is not changed to manufacture a better story.',
  },
  {
    question: 'Does crawler access guarantee a citation?',
    answer:
      'Crawler access supports some retrieval paths, but citations also depend on the product, query, sources and answer-generation process. The diagnostic reviews access as one part of the picture.',
  },
  {
    question: 'What arrives after 15 business days?',
    answer:
      'A dated visibility baseline, citation and source map, competitor comparison, technical access review, measurement-gap review, prioritized 90-day plan and a one-page Decision Board.',
  },
];

const decisionQuestions = [
  {
    label: 'Visibility baseline',
    heading: 'What appeared in the sample?',
    body: 'See the dated mentions, citations and comparison set produced by the agreed query frame.',
  },
  {
    label: 'Measurement gap',
    heading: 'What would your stack miss?',
    body: 'Find the breaks between referral data, conversion events and CRM records.',
  },
  {
    label: 'Priority action',
    heading: 'What should move first?',
    body: 'Give each recommended action an owner, effort estimate, expected signal and stopping rule.',
  },
  {
    label: 'Evidence boundary',
    heading: 'What can the evidence not prove?',
    body: 'State the sample boundary and uncertainty beside the decision it supports.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Growth Visibility Diagnostic',
    serviceType: 'AI-search visibility measurement',
    provider: { '@type': 'Organization', name: 'DataDecision' },
    areaServed: 'Remote',
    description:
      'A sampled AI-search visibility baseline and prioritized action plan for B2B SaaS.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="AI-search visibility for B2B SaaS | DataDecision"
  description="Measure how your SaaS appears across an agreed set of search and AI surfaces, then choose the highest-value improvements."
  path="/services/ai-search-visibility/"
  schema={schema}
>
  <Breadcrumbs
    items={[{ label: 'Home', href: '/' }, { label: 'Services' }, { label: 'AI-search visibility' }]}
  />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy" data-reveal>
      <p class="eyebrow">AI-search visibility</p>
      <h1>Where does your SaaS appear, and what should you improve next?</h1>
      <p class="lede">
        Replace anecdotal spot-checks with a documented query frame, dated observations, a source
        map and a prioritized action plan.
      </p>
      <div class="button-row">
        <a class="button button--primary" href="/contact/" data-event="cta_primary_click"
          >Request a visibility diagnostic</a
        ><MethodBadge />
      </div>
    </div>
    <aside class="page-hero__aside" data-reveal style="--reveal-delay:120ms">
      <div class="folio"><span>Diagnostic / standard</span><span>15 business days</span></div>
      <dl class="evidence-list">
        <div class="evidence-line">
          <dt class="evidence-line__number">50</dt><dd>
            <strong>Buying-intent queries</strong><small>Documented before collection</small>
          </dd>
        </div>
        <div class="evidence-line">
          <dt class="evidence-line__number">01</dt><dd>
            <strong>Market and language</strong><small>Expansion requires explicit scoping</small>
          </dd>
        </div>
        <div class="evidence-line">
          <dt class="evidence-line__number">90d</dt><dd>
            <strong>Action horizon</strong><small>Owner · effort · signal · stopping rule</small>
          </dd>
        </div>
      </dl>
    </aside>
  </header>

  <section class="section" aria-labelledby="problem-heading">
    <span class="chapter-mark" aria-hidden="true">01</span>
    <div class="shell">
      <div class="editorial-grid">
        <div class="section-intro" data-reveal>
          <p class="eyebrow">The problem</p><h2 id="problem-heading">
            A useful baseline begins beyond the first answer.
          </h2>
        </div>
        <p class="lede" data-reveal style="--reveal-delay:110ms">
          Generated answers vary by engine, prompt, location, account state and time. A useful
          baseline fixes the query frame and surface set, records what appeared on specific dates
          and gives the team a consistent comparison for the next decision.
        </p>
      </div>
      <div class="rule-list visual-followup" data-reveal style="--reveal-delay:180ms">
        <div class="rule-row">
          <span class="mono">01</span><div>
            <h3>Same buyer questions</h3><p>
              Fix the market, language, comparison set and question wording before collection.
            </p>
          </div><span class="rule-row__meta">Query frame</span>
        </div><div class="rule-row">
          <span class="mono">02</span><div>
            <h3>Dated observation conditions</h3><p>
              Record the surface, access state, intended locale and collection date for every run.
            </p>
          </div><span class="rule-row__meta">Run record</span>
        </div><div class="rule-row">
          <span class="mono">03</span><div>
            <h3>Separate evidence layers</h3><p>
              Keep mentions, visible sources and observable referrals as distinct fields in the
              final baseline.
            </p>
          </div><span class="rule-row__meta">Clear signals</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="deliverables-heading">
    <span class="chapter-mark" aria-hidden="true">02</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">What you receive</p><h2 id="deliverables-heading">
          A decision file built for action.
        </h2>
      </div>
      <div class="rule-list" data-reveal style="--reveal-delay:110ms">
        <div class="rule-row">
          <span class="mono">01</span><div>
            <h3>Visibility baseline</h3><p>
              Dated mention, citation and recommendation observations inside the sampled query set.
            </p>
          </div><span class="rule-row__meta">Window attached</span>
        </div>
        <div class="rule-row">
          <span class="mono">02</span><div>
            <h3>Citation and source map</h3><p>
              The public sources visible in the answers, grouped by topic and recurring domain.
            </p>
          </div><span class="rule-row__meta">Source context</span>
        </div>
        <div class="rule-row">
          <span class="mono">03</span><div>
            <h3>Competitor comparison</h3><p>
              A consistent comparison against the approved set within the same query frame.
            </p>
          </div><span class="rule-row__meta">Same sample</span>
        </div>
        <div class="rule-row">
          <span class="mono">04</span><div>
            <h3>Technical access review</h3><p>
              Robots policy, fetch accessibility, content clarity and implementation risks.
            </p>
          </div><span class="rule-row__meta">Access layer only</span>
        </div>
        <div class="rule-row">
          <span class="mono">05</span><div>
            <h3>Measurement gaps and 90-day plan</h3><p>
              Referral-to-CRM gaps plus ranked fixes with owners, effort, expected signal,
              confidence and stopping rules.
            </p>
          </div><span class="rule-row__meta">Decision-ready</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="board-heading">
    <span class="chapter-mark" aria-hidden="true">03</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Decision Board</p><h2 id="board-heading">
          Every recommendation answers four questions.
        </h2><p class="small">
          What did we observe? What did the data miss? What should happen next? What can the
          evidence not prove?
        </p>
      </div>
      <div data-reveal style="--reveal-delay:110ms">
        <DecisionTabs questions={decisionQuestions} />
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="fit-heading">
    <span class="chapter-mark" aria-hidden="true">04</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Fit</p><h2 id="fit-heading">
          Built for teams with a real decision to make.
        </h2>
      </div>
      <div class="comparison" data-reveal style="--reveal-delay:110ms">
        <div>
          <span class="evidence-label">Strong fit</span><h3>Growth-stage B2B SaaS</h3><ul>
            <li>A founder or growth leader needs a defensible baseline.</li><li>
              Discovery, conversion and CRM data disagree.
            </li><li>The team can provide inputs and act on a 90-day plan.</li>
          </ul>
        </div><div class="comparison__rule"></div><div>
          <span class="evidence-label">Outside launch scope</span><h3>
            Work outside the current scope
          </h3><ul>
            <li>Guaranteed rankings, citations or revenue.</li><li>
              Pure brand campaigns or paid-media management.
            </li><li>Unbounded multi-market monitoring without a written add-on.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="questions-heading">
    <span class="chapter-mark" aria-hidden="true">05</span>
    <div class="shell editorial-grid">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Questions</p><h2 id="questions-heading">
          What teams ask before starting.
        </h2>
      </div><div data-reveal style="--reveal-delay:110ms"><FAQList items={faqs} /></div>
    </div>
  </section>
  <FinalCTA heading="Turn the question into a repeatable baseline." />
  <div class="mobile-cta" data-mobile-cta hidden>
    <a class="button button--primary" href="/contact/">Request a visibility diagnostic</a>
  </div>
</BaseLayout>
