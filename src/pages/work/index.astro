---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FinalCTA from '../../components/FinalCTA.astro';

const work = (await getCollection('work'))
  .filter((entry) => entry.data.status === 'complete')
  .sort((a, b) => b.data.observationDate.valueOf() - a.data.observationDate.valueOf());
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(
    date,
  );
---

<BaseLayout
  title="Work and demonstration evidence — DataDecision"
  description="Public-data demonstrations and DataDecision self-measurement, clearly separated from client work and published with dates, samples, methods and limitations."
  path="/work/"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Work' }]} />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy">
      <p class="eyebrow">Evidence ledger</p><h1>Artifacts, honestly labelled.</h1><p class="lede">
        Public-data demonstrations and DataDecision self-measurement now. Client work only after
        real permission and verification.
      </p>
    </div>
    <aside class="page-hero__aside">
      <div class="folio"><span>Label key</span><span>01 definition</span></div><div class="caveat">
        <span class="evidence-label">DEMONSTRATION RUN</span>A genuine public-data or DataDecision
        self-measurement record. It is not a client result and does not imply a commercial outcome.
      </div>
    </aside>
  </header>
  <section class="section">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">Published records</p><h2>Evidence before reputation.</h2><p
          class="small"
        >
          No logo walls, empty client cards or work-in-progress case claims.
        </p>
      </div><div class="work-ledger">
        {
          work.map((entry) => (
            <article class="work-entry">
              <div>
                <>
                  <span class="status-label">{entry.data.label}</span>
                  <p class="small">Observed {formatDate(entry.data.observationDate)}</p>
                </>
              </div>
              <div>
                <>
                  <h3>
                    <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
                  </h3>
                  <p>{entry.data.description}</p>
                </>
              </div>
              <div class="small">
                <br />
                {entry.data.sample}
                <br />
                <br />
                <br />
                {entry.data.methodologyVersion}
                <br />
                <br />
                <br />
                {entry.data.limitations[0]}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section section--bright">
    <div class="shell editorial-grid">
      <div class="section-intro">
        <p class="eyebrow">Self-case cadence</p><h2>Measure the firm with the same discipline.</h2>
      </div><div class="scope-wrap">
        <table class="scope-table">
          <thead
            ><tr><th>Observation</th><th>Status</th><th>Purpose</th><th>Publication rule</th></tr
            ></thead
          ><tbody
            ><tr
              ><td>Launch day</td><td>Published record above</td><td
                >Establish the initial evidence and technical baseline.</td
              ><td>Date, sample, method and limitations visible.</td></tr
            ><tr
              ><td>Day 30</td><td>Scheduled</td><td
                >Repeat only comparable measures and document changes.</td
              ><td>No future result shown before collection.</td></tr
            ><tr
              ><td>Day 60</td><td>Scheduled</td><td>Review signal stability and method drift.</td
              ><td>Comparability note required.</td></tr
            ><tr
              ><td>Day 90</td><td>Scheduled</td><td
                >Publish the complete launch-quarter self-case.</td
              ><td>Keep null and negative findings.</td></tr
            ></tbody
          >
        </table>
      </div>
    </div>
  </section>
  <FinalCTA heading="Want your own evidence ledger?" />
</BaseLayout>
