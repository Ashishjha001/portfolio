---
// Concise, scroll-linked overview of the four method steps.
import { ScanSearch, Database, GitMerge, ListChecks } from 'lucide-astro';

interface Step {
  index: string;
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;

const methodVisuals = [
  { icon: ScanSearch, tone: 'frame' },
  { icon: Database, tone: 'evidence' },
  { icon: GitMerge, tone: 'connect' },
  { icon: ListChecks, tone: 'decide' },
];
---

<div class="method-story">
  <ol class="method-story__steps">
    {
      steps.map((step, index) => {
        const visual = methodVisuals[index] ?? methodVisuals[0]!;
        const Icon = visual.icon;
        return (
          <li
            class="method-step t-tilt"
            data-tone={visual.tone}
            data-reveal
            data-tilt
            style={`--reveal-delay:${index * 70}ms`}
          >
            <div class="method-step__surface t-tilt-card">
              <div class="method-step__visual" aria-hidden="true">
                <span class="method-step__matrix" />
                <span class="method-step__orbit" />
                <Icon strokeWidth={1.65} />
              </div>
              <div class="method-step__copy">
                <span class="mono">{step.index}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>
</div>
