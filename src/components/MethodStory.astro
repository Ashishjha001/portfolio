---
// Scroll-linked retelling of the four method steps.
// Copy is preserved verbatim from the approved homepage content.
// Each step reveals its concrete deliverable and the decision it enables:
// on hover/focus, when scroll-activated, or pinned by click/keyboard.
interface Step {
  index: string;
  title: string;
  body: string;
  tag: string;
  deliverable: string;
  decision: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="method-story" data-method-story>
  <div class="method-story__rail" aria-hidden="true">
    <span class="method-story__rail-fill"></span>
  </div>
  <ol class="method-story__steps">
    {
      steps.map((step) => (
        <li class="method-step" data-method-step>
          <span class="mono">{step.index}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <span class="method-step__tag">{step.tag}</span>
          <button
            class="method-step__toggle text-link"
            type="button"
            aria-expanded="false"
            data-step-toggle
          >
            Deliverable + decision
          </button>
          <div class="method-step__detail">
            <div class="method-step__detail-inner">
              <dl class="method-step__facts">
                <div>
                  <dt>Output</dt>
                  <dd>{step.deliverable}</dd>
                </div>
                <div>
                  <dt>Decision</dt>
                  <dd>{step.decision}</dd>
                </div>
              </dl>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .method-step__toggle {
    justify-self: start;
    margin-top: 0.7rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 0.8rem;
  }
</style>

<script>
  const story = document.querySelector<HTMLElement>('[data-method-story]');

  if (story) {
    const steps = Array.from(story.querySelectorAll<HTMLElement>('[data-method-step]'));
    const fill = story.querySelector<HTMLElement>('.method-story__rail-fill');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const activateAll = () => {
      steps.forEach((step) => step.classList.add('is-active'));
      if (fill) fill.style.transform = 'scaleY(1)';
    };

    if (reduced.matches || !('IntersectionObserver' in window)) {
      activateAll();
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-active');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );
      steps.forEach((step) => observer.observe(step));

      let frame: number | undefined;
      const updateFill = () => {
        frame = undefined;
        if (!fill) return;
        const rect = story.getBoundingClientRect();
        const anchor = window.innerHeight * 0.72;
        const progress = (anchor - rect.top) / rect.height;
        const clamped = Math.max(0, Math.min(progress, 1));
        fill.style.setProperty('transform', `scaleY(${clamped})`);
      };
      const onScroll = () => {
        if (!frame) frame = requestAnimationFrame(updateFill);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateFill();
    }

    /* Click / Enter pins a step's deliverable + decision open */
    story.querySelectorAll<HTMLButtonElement>('[data-step-toggle]').forEach((toggle) => {
      const step = toggle.closest<HTMLElement>('.method-step');
      if (!step) return;
      toggle.addEventListener('click', () => {
        const pinned = step.classList.toggle('is-pinned');
        toggle.setAttribute('aria-expanded', String(pinned));
      });
    });
  }
</script>
