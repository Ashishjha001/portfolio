---
/**
 * ClusterArt — cohesive abstract SVG identity per topic cluster.
 * Lightweight inline SVG (viewBox 0 0 100 100, numeric coords).
 * Decorative: aria-hidden.
 */

interface Props {
  cluster: string;
  class?: string;
}

const { cluster, class: className } = Astro.props;

const A = 'var(--signal)';
const AS = 'color-mix(in srgb, var(--signal) 34%, transparent)';
const AF = 'color-mix(in srgb, var(--signal) 14%, transparent)';
const IF = 'color-mix(in srgb, var(--ink) 10%, transparent)';
const AM = 'color-mix(in srgb, var(--amber) 55%, transparent)';

const s = (v: string) => JSON.stringify(v);

const el = (tag: string, attrs: string[]) => `<${tag} ${attrs.join(' ')}/>`;

const R = (
  x: number,
  y: number,
  w: number,
  h: number,
  rx: number,
  stroke: string,
  sw: string,
  fill = 'none',
) =>
  el('rect', [
    `x="${x}"`,
    `y="${y}"`,
    `width="${w}"`,
    `height="${h}"`,
    `rx="${rx}"`,
    `fill="${fill}"`,
    `stroke=${s(stroke)}`,
    `stroke-width=${s(sw)}`,
  ]);

const C = (cx: number, cy: number, r: number, stroke: string, sw: string, fill = 'none') =>
  el('circle', [
    `cx="${cx}"`,
    `cy="${cy}"`,
    `r="${r}"`,
    `fill=${s(fill)}`,
    `stroke=${s(stroke)}`,
    `stroke-width=${s(sw)}`,
  ]);

const P = (d: string, stroke: string, sw: string, dash?: string) =>
  el(
    'path',
    [`d=${s(d)}`, 'fill="none"', `stroke=${s(stroke)}`, `stroke-width=${s(sw)}`].concat(
      dash ? [`stroke-dasharray=${s(dash)}`] : [],
    ),
  );

const hlines = (count: number, y0: number, step: number, x1: number) => {
  let out = '';
  for (let i = 0; i < count; i++) {
    out += P(`M 12 ${y0 + i * step} H ${x1}`, IF, '1.2');
  }
  return out;
};

function art(kind: string): string {
  switch (kind) {
    case 'measurement':
      return [
        R(8, 18, 26, 46, 4, AS, '1.5'),
        R(38, 30, 24, 46, 4, AS, '1.5'),
        R(66, 14, 26, 52, 4, A, '1.5'),
        P('M 34 40 C 36 40, 36 54, 38 54', A, '1.5'),
        P('M 62 52 C 64 52, 64 38, 66 38', A, '1.5'),
        C(21, 34, 2.4, A, '0', A),
        C(50, 44, 2.4, A, '0', A),
        C(79, 28, 2.4, A, '0', A),
        P('M 10 78 H 90', IF, '1.5', '6 5'),
      ].join('');
    case 'growth':
      return [
        P('M 8 82 C 30 78, 42 62, 55 52 S 78 30, 92 16', A, '2'),
        C(24, 75, 3, AS, '1.5'),
        C(46, 58, 3, AS, '1.5'),
        C(68, 36, 3, A, '1.5'),
        C(92, 16, 3.5, A, '1.5', AF),
        P('M 14 70 C 26 66, 34 50, 47 42', AS, '1.2', '4 4'),
        P('M 8 90 H 92', IF, '1.5'),
      ].join('');
    case 'demo-funnel':
      return [
        P('M 8 20 H 92', AS, '2'),
        P('M 14 42 H 86', AS, '2'),
        P('M 24 64 H 76', A, '2'),
        C(50, 84, 3.4, A, '1.5', AF),
        P('M 50 26 L 50 38', A, '1.5', '3 3'),
        P('M 50 48 L 50 60', A, '1.5', '3 3'),
        P('M 50 70 L 50 79', A, '1.5', '3 3'),
      ].join('');
    case 'seo':
      return [
        R(10, 16, 52, 12, 6, A, '2'),
        C(16, 22, 1.8, A, '1.5'),
        P('M 21.5 22 H 46', AS, '1.5'),
        R(10, 38, 80, 10, 3, AF, '0', AF),
        R(18, 54, 64, 8, 3, IF, '1.5'),
        R(18, 68, 48, 8, 3, IF, '1.5'),
        C(86, 20, 3, AS, '1.5'),
        C(86, 20, 1.4, A, '0', A),
      ].join('');
    case 'ai-search':
      return [
        R(8, 14, 30, 14, 8, A, '1.5'),
        R(44, 14, 26, 14, 8, AS, '1.5'),
        el('ellipse', [
          'cx="50"',
          'cy="72"',
          'rx="34"',
          'ry="16"',
          'fill="none"',
          `stroke=${s(AS)}`,
          'stroke-width="1.2"',
          'stroke-dasharray="5 4"',
        ]),
        C(26, 56, 2.6, A, '1.2', AF),
        C(50, 46, 2.6, A, '1.2', AF),
        C(74, 56, 2.6, A, '1.2', AF),
        P('M 20 28 C 22 42, 24 46, 26 52', AS, '1.2'),
        P('M 56 28 C 54 40, 52 42, 50 43', AS, '1.2'),
        P('M 68 28 C 71 42, 73 46, 74 52', AS, '1.2'),
      ].join('');
    case 'performance':
      return [
        C(50, 50, 36, IF, '1.5'),
        C(50, 50, 24, AS, '1.5'),
        C(50, 50, 12, A, '2'),
        C(50, 50, 3.2, A, '0', A),
        P('M 10 86 C 28 80, 40 66, 47 56', AM, '1.5', '4 4'),
      ].join('');
    case 'research':
      return [
        hlines(4, 20, 18, 88),
        R(16, 24, 18, 10, 2, AF, '0', AF),
        R(42, 42, 18, 10, 2, AS, '1.5'),
        R(62, 60, 18, 10, 2, A, '1.5', AF),
        C(88, 22, 2.2, A, '1.5'),
      ].join('');
    case 'playbooks':
      return [
        R(14, 16, 72, 12, 3, A, '1.8'),
        R(20, 34, 66, 12, 3, AS, '1.8'),
        R(26, 52, 60, 12, 3, AS, '1.8'),
        R(32, 70, 54, 12, 3, A, '1.8', AF),
        P('M 8 22 L 14 22', A, '2'),
      ].join('');
    default:
      return [hlines(3, 30, 20, 88), C(82, 34, 3, AS, '1.5')].join('');
  }
}

function clusterKind(cluster: string | undefined): string {
  const c = (cluster ?? '').toLowerCase();
  if (c.includes('measurement') || c.includes('lead-source') || c.includes('utm'))
    return 'measurement';
  if (c.includes('demo')) return 'demo-funnel';
  if (c.includes('growth') || c.includes('conversion')) return 'growth';
  if (c.includes('ai search') || c.includes('aeo') || c.includes('geo') || c.includes('ai-search'))
    return 'ai-search';
  if (c.includes('performance') || c.includes('paid')) return 'performance';
  if (c.includes('seo')) return 'seo';
  if (c.includes('research') || c.includes('framework')) return 'research';
  if (c.includes('playbook')) return 'playbooks';
  return 'generic';
}
---

<svg
  class={className ?? 'cluster-art'}
  viewBox="0 0 100 100"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  set:html={art(clusterKind(cluster))}
/>
