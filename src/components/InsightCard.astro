---
/** Premium, full-link editorial card used across the Insights library. */
import LearnArrow from './LearnArrow.astro';

interface Props {
  href: string;
  category: string;
  typeLabel: string;
  title: string;
  excerpt: string;
  date: Date;
  dateLabel: string;
  readingMinutes: number;
  index?: number;
  image: string;
  imagePosition?: string;
}

const {
  href,
  category,
  typeLabel,
  title,
  excerpt,
  date,
  dateLabel,
  readingMinutes,
  index = 0,
  image,
  imagePosition = '50% 50%',
} = Astro.props;

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---

<article class="dd-card insight-card dd-stagger" style={`--card-i: ${index};`}>
  <a href={href} aria-label={`Read insight: ${title}`}>
    <div class="insight-card__art">
      <img
        src={image}
        alt=""
        width="1120"
        height="1120"
        loading="lazy"
        decoding="async"
        sizes="(max-width: 639px) calc(100vw - 2.5rem), (max-width: 1099px) 50vw, 33vw"
        style={`object-position: ${imagePosition};`}
      />
    </div>
    <div class="insight-card__body">
      <div class="insight-card__meta">
        <span class="dd-card__badge">{category}</span>
        <span>{typeLabel}</span>
      </div>
      <h3 class="insight-card__title">{title}</h3>
      <p class="insight-card__excerpt">{excerpt}</p>
      <div class="insight-card__foot">
        <span class="insight-card__date">
          <span class="visually-hidden">{dateLabel} </span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true"> · </span>{readingMinutes} min read
        </span>
        <span class="dd-card__arrow" aria-hidden="true">
          Read <LearnArrow />
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .insight-card {
    min-width: 0;
  }

  .insight-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .insight-card:focus-within {
    outline: 2px solid var(--signal);
    outline-offset: 4px;
  }

  .insight-card a:focus-visible {
    outline: none;
  }

  .insight-card__title {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-display);
    margin: 0;
    font-size: clamp(1.12rem, 1.45vw, 1.3rem);
    font-weight: 600;
    line-height: 1.22;
  }

  @media (max-width: 639px) {
    .insight-card__title {
      font-size: clamp(1.2rem, 5.4vw, 1.42rem);
    }
  }
</style>
