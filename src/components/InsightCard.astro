---
/**
 * InsightCard: editorial card for supporting insights.
 * Cluster art via ClusterArt (decorative inline SVG), full-card
 * click, semantic <article>, dates + reading time preserved.
 * Valid HTML: no block elements inside <a> via span wrappers,
 * the anchor wraps flow content directly.
 */
import ClusterArt from './ClusterArt.astro';
import LearnArrow from './LearnArrow.astro';

interface Props {
  href: string;
  cluster?: string;
  category: string;
  typeLabel: string;
  title: string;
  excerpt: string;
  date: Date;
  dateLabel: string;
  readingMinutes: number;
  index?: number;
}

const {
  href,
  cluster,
  category,
  typeLabel,
  title,
  excerpt,
  date,
  dateLabel,
  readingMinutes,
  index = 0,
} = Astro.props;

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---

<article class="dd-card insight-card dd-stagger" style={`--card-i: ${index};`}>
  <a href={href} aria-label={`Read insight: ${title}`}>
    <span class="insight-card__art">
      <ClusterArt cluster={cluster ?? category} />
    </span>
    <span class="insight-card__body">
      <span class="insight-card__meta">
        <span class="dd-card__badge">{category}</span>
        <span>{typeLabel}</span>
      </span>
      <span class="insight-card__title">{title}</span>
      <span class="insight-card__excerpt">{excerpt}</span>
      <span class="insight-card__foot">
        <span>
          {dateLabel}
          {formatDate(date)} · {readingMinutes} min read
        </span>
        <span class="dd-card__arrow" aria-hidden="true">
          Read <LearnArrow />
        </span>
      </span>
    </span>
  </a>
</article>

<style>
  .insight-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .insight-card:hover,
  .insight-card:focus-within {
    transform: translateY(-4px);
    border-color: var(--signal);
    box-shadow: 0 16px 34px -20px rgba(20, 24, 31, 0.32);
  }

  .insight-card:focus-within {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .insight-card a:focus-visible {
    outline: none;
  }

  /* Title renders as display:block spans styled as headings: valid
     inline-content flow inside the anchor, clamped safely. */
  .insight-card__title {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
