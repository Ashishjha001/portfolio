---
const poster = '/media/hero/search-panels-poster.webp';
---

<div class="hero-media" data-hero-media aria-hidden="true">
  <img
    class="hero-media__poster"
    src={poster}
    alt=""
    width="880"
    height="650"
    decoding="async"
    fetchpriority="high"
  />
  <video
    id="hero-animation"
    class="hero-media__video"
    data-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={poster}
    aria-hidden="true"
    tabindex="-1"
  >
    <source
      src="/media/hero/search-panels-mobile.mp4"
      media="(max-width: 767px)"
      type="video/mp4"
    />
    <source src="/media/hero/search-panels.mp4" type="video/mp4" />
  </video>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-hero-media]').forEach((media) => {
    const video = media.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;
    let pending = false;
    let blocked = false;
    const play = () => {
      if (document.hidden) {
        video.pause();
        return;
      }
      if (pending || !video.paused) return;
      pending = true;
      video.muted = true;
      void video
        .play()
        .then(() => {
          blocked = false;
        })
        .catch(() => {
          blocked = true;
        })
        .finally(() => {
          pending = false;
          if (document.hidden) video.pause();
        });
    };
    video.addEventListener('playing', () => media.classList.add('is-video-ready'));
    video.addEventListener('error', () => media.classList.remove('is-video-ready'));
    document.addEventListener('visibilitychange', play);
    const retry = () => {
      if (blocked) play();
    };
    document.addEventListener('pointerup', retry, { passive: true });
    document.addEventListener('keydown', retry);
    window.addEventListener('pageshow', play);
    play();
  });
</script>
<style>
  .hero-media {
    position: absolute;
    inset: 0 0 70px;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-media__poster,
  .hero-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-media__video {
    opacity: 0;
  }
  .is-video-ready .hero-media__video {
    opacity: 1;
  }
  .is-video-ready .hero-media__poster {
    opacity: 0;
  }
  @media (max-width: 767px) {
    .hero-media {
      inset: 0 0 45px;
    }
  }
</style>
