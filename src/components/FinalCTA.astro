---
interface Props {
  heading?: string;
  body?: string;
  label?: string;
}

const {
  heading = 'Find your next growth move.',
  body = 'Tell us the problem. Get a written scope with inputs, timing, fee and evidence limits.',
  label = 'Discuss your project',
} = Astro.props;
---

<section class="section section--green">
  <div class="shell cta-band">
    <h2 data-reveal>{heading}</h2>
    <div class="cta-band__action" data-reveal style="--reveal-delay:120ms">
      <p>{body}</p>
      <a class="button button--primary" href="/contact/" data-event="cta_primary_click">{label}</a>
    </div>
  </div>
</section>
