---
interface Props {
  heading?: string;
  body?: string;
  label?: string;
}

const {
  heading = 'Build the baseline before you fund the fix.',
  body = 'We review the question for fit. You then receive a written scope covering inputs, timing, fee and the evidence this work can provide.',
  label = 'Request a visibility diagnostic',
} = Astro.props;
---

<section class="section section--green">
  <div class="shell cta-band">
    <h2 data-reveal>{heading}</h2>
    <div class="cta-band__action" data-reveal style="--reveal-delay:120ms">
      <p>{body}</p>
      <a class="button button--primary" href="/contact/" data-event="cta_primary_click">{label}</a>
    </div>
  </div>
</section>
