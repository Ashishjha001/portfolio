---
/* transitions.dev pattern 24 — learn-more hover: chevron slides and its
   arms spread into an open arrow. Pure CSS, reduced-motion guarded. */
---

<span class="t-learn-chevron" aria-hidden="true">
  <svg
    width="16"
    height="16"
    viewBox="0 0 20 16"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path class="t-learn-arm t-learn-arm-top" d="M7 1 L13 8 L7 15"></path>
    <path class="t-learn-arm t-learn-arm-bot" d="M1 1 L7 8 L1 15"></path>
  </svg>
</span>
