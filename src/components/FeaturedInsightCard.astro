---
/**
 * FeaturedInsightCard: large editorial card for a cluster's
 * foundational guide (pillar). Same card system as InsightCard,
 * horizontal art + body layout on desktop.
 */
import ClusterArt from './ClusterArt.astro';
import LearnArrow from './LearnArrow.astro';

interface Props {
  href: string;
  cluster?: string;
  category: string;
  typeLabel: string;
  title: string;
  excerpt: string;
  date: Date;
  dateLabel: string;
  readingMinutes: number;
}

const { href, cluster, category, typeLabel, title, excerpt, date, dateLabel, readingMinutes } =
  Astro.props;

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---

<article class="dd-card insight-card featured-insight dd-stagger" style="--card-i: 0;">
  <a href={href} aria-label={`Read the foundational guide: ${title}`}>
    <span class="insight-card__art">
      <ClusterArt cluster={cluster ?? category} />
    </span>
    <span class="insight-card__body">
      <span class="insight-card__meta">
        <span class="dd-card__badge">{category}</span>
        <span>{typeLabel}</span>
      </span>
      <span class="insight-card__title">{title}</span>
      <p class="insight-card__excerpt">{excerpt}</p>
      <span class="insight-card__foot">
        <span>
          {dateLabel}
          {formatDate(date)} · {readingMinutes} min read
        </span>
        <span class="dd-card__arrow" aria-hidden="true">
          Read the guide <LearnArrow />
        </span>
      </span>
    </span>
  </a>
</article>

<style>
  .featured-insight a {
    display: grid;
    grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .featured-insight:focus-within {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .featured-insight a:focus-visible {
    outline: none;
  }

  @media (max-width: 860px) {
    .featured-insight a {
      grid-template-columns: 1fr;
    }
  }
</style>
