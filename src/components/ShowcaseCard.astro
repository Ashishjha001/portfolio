---
/* transitions.dev pattern 19: card hover tilt with cursor-tracked glare.
   Outer .t-tilt is the flat hit area; inner .t-tilt-card rotates.
   Tilt JS is wired globally in BaseLayout (pointer-only, skips touch,
   flattens under prefers-reduced-motion). */
import LearnArrow from './LearnArrow.astro';

interface Props {
  href: string;
  index: string;
  title: string;
  body: string;
  label: string;
  tone: string;
}

const { href, index, title, body, label, tone } = Astro.props;
const staggerIndex = Math.max(0, Number(index) - 1);
---

<a class="showcase__item t-tilt" href={href} data-tone={tone} data-tilt>
  <div class="showcase__reveal dd-stagger" style={`--card-i:${staggerIndex}`}>
    <div class="showcase__surface t-tilt-card">
      <div class="showcase__visual" aria-hidden="true">
        <span class="showcase__matrix"></span>
        <span class="showcase__orbit"></span>
        <span class="showcase__beam"></span>
        <div class="showcase__icon"><slot /></div>
        <span class="showcase__index mono">{index}</span>
      </div>
      <div class="showcase__content">
        <div>
          <span class="showcase__kicker mono">{label}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </div>
        <span class="showcase__link">
          See {title}
          <LearnArrow />
        </span>
      </div>
    </div>
  </div>
</a>
