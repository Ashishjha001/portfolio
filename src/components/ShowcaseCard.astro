---
import { ArrowUpRight } from 'lucide-astro';
interface Props {
  href: string;
  index: string;
  title: string;
  body: string;
  label: string;
  tone: string;
  imageSrc: string;
  imagePosition?: string;
  group?: string;
}
const {
  href,
  title,
  body,
  label,
  imageSrc,
  imagePosition = '50% 50%',
  group = 'all',
} = Astro.props;
---

<a class="capability-card" href={href} data-service-group={group}>
  <div class="capability-card__art" aria-hidden="true">
    <img
      src={imageSrc}
      alt=""
      width="1120"
      height="1120"
      loading="lazy"
      decoding="async"
      style={`object-position:${imagePosition}`}
    />
    <span class="capability-card__icon"><slot /></span>
  </div>
  <div class="capability-card__copy">
    <span class="capability-card__label">{label}</span>
    <div class="capability-card__heading">
      <h3>{title}</h3><span class="capability-card__arrow" aria-hidden="true"
        ><ArrowUpRight size={22} /></span
      >
    </div>
    <p>{body}</p>
  </div>
</a>
<style>
  .capability-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .capability-card[hidden] {
    display: none;
  }
  .capability-card__art {
    position: relative;
    height: clamp(150px, 14vw, 200px);
    overflow: hidden;
    background: var(--deep-green);
  }
  .capability-card__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }
  .capability-card__icon {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--deep-green);
    background: var(--warm-white);
    border-radius: 10px;
  }
  .capability-card__icon :global(svg) {
    width: 21px;
    height: 21px;
  }
  .capability-card__copy {
    padding: 1.25rem 1.35rem 1.5rem;
  }
  .capability-card__label {
    color: var(--green);
    font-size: 0.73rem;
    font-weight: 600;
  }
  .capability-card__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: 0.6rem;
  }
  .capability-card h3 {
    margin: 0;
    font: 600 clamp(1.2rem, 1.7vw, 1.55rem)/1.2 var(--font-body);
    letter-spacing: -0.03em;
  }
  .capability-card__arrow {
    display: grid;
    place-items: center;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--green);
    background: var(--green-pale);
    transition:
      background 200ms,
      color 200ms;
  }
  .capability-card p {
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 40ch;
  }
  .capability-card:hover,
  .capability-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--green);
    box-shadow: 0 12px 30px -24px var(--deep-green);
  }
  .capability-card:hover img,
  .capability-card:focus-visible img {
    transform: scale(1.04);
  }
  .capability-card:hover .capability-card__arrow,
  .capability-card:focus-visible .capability-card__arrow {
    background: var(--green);
    color: var(--warm-white);
  }
  .capability-card:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .capability-card__art {
      height: 170px;
    }
    .capability-card h3 {
      font-size: 1.35rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .capability-card,
    .capability-card img,
    .capability-card__arrow {
      transition: none;
      transform: none;
    }
  }
</style>
