---
import LedgerVisualMotion from './LedgerVisualMotion.astro';

interface Props {
  id?: string;
}

const { id = 'homepage-decision-map' } = Astro.props;

const nodes = [
  { x: 24, y: 290, width: 154, kicker: '01 / question', lines: ['Buyer', 'question'] },
  {
    x: 208,
    y: 152,
    width: 176,
    kicker: '02 / discovery',
    lines: ['Google / AI', 'answer surfaces'],
  },
  { x: 414, y: 270, width: 146, kicker: '03 / evidence', lines: ['Cited', 'sources'] },
  {
    x: 590,
    y: 106,
    width: 164,
    kicker: '04 / owned',
    lines: ['DataDecision', 'website'],
  },
  {
    x: 784,
    y: 248,
    width: 174,
    kicker: '05 / capture',
    lines: ['Form / referral', 'capture'],
  },
  { x: 988, y: 152, width: 94, kicker: '06 / record', lines: ['CRM'] },
  {
    x: 1102,
    y: 44,
    width: 90,
    kicker: '07 / action',
    lines: ['Pipeline', 'decision'],
  },
];

const paths = [
  'M 178 338 C 194 338, 194 200, 208 200',
  'M 384 200 C 402 200, 398 318, 414 318',
  'M 560 318 C 578 318, 574 154, 590 154',
  'M 754 154 C 772 154, 768 296, 784 296',
  'M 958 296 C 974 296, 972 200, 988 200',
  'M 1082 200 C 1096 200, 1088 92, 1102 92',
];

const stageTimes = [0, 1150, 2200, 3250, 4300, 5350, 6400];
const connectorTimes = [350, 1400, 2450, 3500, 4550, 5600];

const mobileNodes = [
  ['Buyer question', 'Intent enters the observation frame'],
  ['Google / AI answer surfaces', 'Discovery occurs across sampled surfaces'],
  ['Cited sources', 'Visible sources provide an evidence trail'],
  ['DataDecision website', 'Owned context receives the visit'],
  ['Form / referral capture', 'Consent and source detail are recorded'],
  ['CRM', 'The enquiry becomes an accountable record'],
  ['Pipeline decision', 'Evidence supports the next commercial action'],
];
---

<figure id={id} class="decision-map ledger-visual" data-ledger-visual data-sequence-duration="7000">
  <div class="decision-map__header">
    <span class="evidence-label">Decision path / system view</span>
    <div class="ledger-visual__actions">
      <span class="decision-map__legend"><i aria-hidden="true"></i> Observable connection</span>
      <button class="ledger-visual__replay" type="button" data-visual-replay aria-controls={id}
        >Replay path</button
      >
    </div>
    <span class="sr-only" aria-live="polite" data-visual-status>Path animation ready.</span>
  </div>

  <svg
    class="decision-map__desktop"
    viewBox="0 0 1216 410"
    role="img"
    aria-labelledby={`${id}-title ${id}-description`}
    data-motion-svg
  >
    <title id={`${id}-title`}>From buyer question to pipeline decision</title>
    <desc id={`${id}-description`}>
      A seven-stage journey from a buyer question through Google and AI answer surfaces, cited
      sources, the DataDecision website, form or referral capture, CRM and a pipeline decision.
    </desc>
    <defs>
      <marker
        id={`${id}-arrow`}
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 8 4 L 0 8 Z" class="decision-map__arrow"></path>
      </marker>
    </defs>

    <path class="decision-map__datum" d="M 24 388 H 1192" pathLength="1"></path>
    <text class="decision-map__datum-label" x="24" y="402">OBSERVATION → CAPTURE → DECISION</text>

    {
      paths.map((path, index) => (
        <g data-connector-start={connectorTimes[index]} data-connector-duration="700">
          <path
            class="decision-map__path"
            d={path}
            pathLength="1"
            marker-end={`url(#${id}-arrow)`}
            data-visual-path
          />
          <circle class="decision-map__signal" r="4" aria-hidden="true" data-visual-signal />
        </g>
      ))
    }

    {
      nodes.map((node, index) => (
        <g class="decision-map__node" data-activate-at={stageTimes[index]}>
          <rect
            class="decision-map__node-body"
            x={node.x}
            y={node.y}
            width={node.width}
            height="96"
          />
          <line
            class="decision-map__node-rule"
            x1={node.x}
            x2={node.x + node.width}
            y1={node.y + 25}
            y2={node.y + 25}
          />
          <text class="decision-map__kicker" x={node.x + 12} y={node.y + 17}>
            {node.kicker}
          </text>
          <text class="decision-map__label" x={node.x + 12} y={node.y + 54}>
            {node.lines.map((line, lineIndex) => (
              <tspan x={node.x + 12} dy={lineIndex === 0 ? 0 : 19}>
                {line}
              </tspan>
            ))}
          </text>
        </g>
      ))
    }
  </svg>

  <ol class="decision-map__mobile" aria-label="From buyer question to pipeline decision">
    {
      mobileNodes.map(([heading, body], index) => (
        <li data-activate-at={stageTimes[index]}>
          <span class="decision-map__mobile-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <strong>{heading}</strong>
            <span>{body}</span>
          </div>
          {index < connectorTimes.length && (
            <span
              class="decision-map__mobile-flow"
              aria-hidden="true"
              data-connector-start={connectorTimes[index]}
              data-connector-duration="700"
            >
              <i data-visual-signal />
            </span>
          )}
        </li>
      ))
    }
  </ol>

  <figcaption>
    <span class="evidence-label">Reading note</span>
    The path shows where discovery evidence can become a decision record. It does not claim that every
    visit or citation can be attributed end to end.
  </figcaption>
</figure>
<LedgerVisualMotion />

<style>
  .decision-map {
    margin: 0;
    border-block: 2px solid var(--ink);
    background: var(--paper-bright);
  }

  .decision-map__header,
  .decision-map figcaption {
    display: flex;
    padding: 0.8rem 0.9rem;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .decision-map__header {
    border-bottom: 1px solid var(--rule);
  }

  .decision-map__legend {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .decision-map__legend i {
    width: 1.8rem;
    height: 1px;
    background: var(--green);
  }

  .decision-map__desktop {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .decision-map__datum {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .decision-map__datum-label,
  .decision-map__kicker {
    fill: var(--graphite);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .decision-map__path {
    fill: none;
    stroke: var(--green);
    stroke-linecap: square;
    stroke-width: 1.5;
  }

  .decision-map__arrow,
  .decision-map__signal {
    fill: var(--green);
  }

  .decision-map__node-body {
    fill: var(--paper-bright);
    stroke: var(--ink);
    stroke-width: 1;
    transition:
      fill 220ms ease,
      stroke 220ms ease;
  }

  .decision-map__node-rule {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .decision-map__label {
    fill: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
  }

  .decision-map__mobile {
    display: none;
  }

  .decision-map figcaption {
    border-top: 1px solid var(--rule);
    color: var(--graphite);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .decision-map figcaption .evidence-label {
    flex: 0 0 auto;
    color: var(--green-dark);
  }

  .decision-map.has-motion .decision-map__node {
    opacity: 0.28;
    transition: opacity 220ms ease;
  }

  .decision-map.has-motion .decision-map__node.is-active {
    opacity: 1;
  }

  .decision-map.has-motion .decision-map__node.is-active .decision-map__node-body {
    fill: var(--green-pale);
    stroke: var(--green-dark);
  }

  .decision-map__signal {
    opacity: 0;
    transition: opacity 100ms linear;
  }

  @media (max-width: 680px) {
    .decision-map__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .decision-map__desktop {
      display: none;
    }

    .decision-map__mobile {
      display: block;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .decision-map__mobile li {
      position: relative;
      display: grid;
      min-height: 6.5rem;
      padding: 1rem 0.9rem 1.5rem;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.8rem;
      border-bottom: 1px solid var(--rule);
      transition:
        background 220ms ease,
        border-color 220ms ease,
        opacity 220ms ease;
    }

    .decision-map__mobile li:not(:last-child)::after {
      position: absolute;
      bottom: -0.32rem;
      left: 1.72rem;
      z-index: 1;
      width: 0.58rem;
      height: 0.58rem;
      border-right: 1px solid var(--green);
      border-bottom: 1px solid var(--green);
      background: var(--paper-bright);
      content: '';
      transform: rotate(45deg);
    }

    .decision-map__mobile-flow {
      --connector-progress: 1;
      position: absolute;
      bottom: -0.72rem;
      left: 1.76rem;
      z-index: 2;
      width: 1px;
      height: 1.45rem;
      background: var(--green);
      transform: scaleY(var(--connector-progress));
      transform-origin: top;
    }

    .decision-map__mobile-flow i {
      position: absolute;
      top: calc(var(--connector-progress) * 100%);
      left: 50%;
      width: 0.38rem;
      height: 0.38rem;
      border-radius: 50%;
      background: var(--green);
      opacity: 0;
      transform: translate(-50%, -50%);
    }

    .decision-map__mobile-index {
      color: var(--green-dark);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
    }

    .decision-map__mobile strong,
    .decision-map__mobile span {
      display: block;
    }

    .decision-map__mobile strong {
      font-family: var(--font-display);
      font-size: 1.15rem;
      line-height: 1.2;
    }

    .decision-map__mobile div > span {
      margin-top: 0.35rem;
      color: var(--graphite);
      font-size: 0.74rem;
      line-height: 1.45;
    }

    .decision-map figcaption {
      align-items: flex-start;
      flex-direction: column;
    }

    .decision-map.has-motion .decision-map__mobile li {
      border-left: 2px solid transparent;
      opacity: 0.32;
    }

    .decision-map.has-motion .decision-map__mobile li.is-active {
      border-left-color: var(--green-dark);
      background: color-mix(in srgb, var(--green-pale) 46%, var(--paper-bright));
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .decision-map *,
    .decision-map *::before,
    .decision-map *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0ms !important;
    }
  }
</style>
