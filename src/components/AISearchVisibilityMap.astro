---
import LedgerVisualMotion from './LedgerVisualMotion.astro';

interface Props {
  id?: string;
  observationLabel?: string;
}

const { id = 'ai-search-visibility-map', observationLabel = 'Date recorded per run' } = Astro.props;

const rows = [
  { index: '01', y: 92 },
  { index: '02', y: 198 },
  { index: '03', y: 304 },
  { index: '04', y: 410 },
];
---

<figure
  id={id}
  class="visibility-map ledger-visual"
  data-ledger-visual
  data-sequence-duration="7000"
>
  <div class="visibility-map__header">
    <span class="evidence-label">Observation schema / four approved surfaces</span>
    <div class="ledger-visual__actions">
      <span class="visibility-map__scope">Sample frame fixed before collection</span>
      <button class="ledger-visual__replay" type="button" data-visual-replay aria-controls={id}
        >Replay path</button
      >
    </div>
    <span class="sr-only" aria-live="polite" data-visual-status>Path animation ready.</span>
  </div>

  <svg
    class="visibility-map__desktop"
    viewBox="0 0 1120 550"
    role="img"
    aria-labelledby={`${id}-title ${id}-description`}
    data-motion-svg
  >
    <title id={`${id}-title`}>Sampled AI-search visibility observation map</title>
    <desc id={`${id}-description`}>
      Four approved answer surfaces connect to separately dated observation records, visible
      citation records and public source nodes. The records describe a defined sample and are not
      universal rankings.
    </desc>
    <defs>
      <marker
        id={`${id}-arrow`}
        viewBox="0 0 8 8"
        refX="7"
        refY="4"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 0 L 8 4 L 0 8 Z" class="visibility-map__arrow"></path>
      </marker>
    </defs>

    <g class="visibility-map__columns" aria-hidden="true">
      <text x="30" y="38">ANSWER SURFACE</text>
      <text x="294" y="38">DATED OBSERVATION</text>
      <text x="638" y="38">VISIBLE CITATION</text>
      <text x="902" y="38">PUBLIC SOURCE</text>
      <line x1="30" x2="1090" y1="52" y2="52"></line>
    </g>

    {
      rows.map((row, index) => {
        const centerY = row.y + 35;
        const firstPath = `M 228 ${centerY} H 294`;
        const secondPath = `M 532 ${centerY} H 638`;
        const thirdPath = `M 816 ${centerY} H 902`;
        const rowStart = index * 1700;
        const stageBase = index * 4;

        return (
          <g class="visibility-map__row">
            {[firstPath, secondPath, thirdPath].map((path, pathIndex) => (
              <g
                data-connector-start={rowStart + 150 + pathIndex * 450}
                data-connector-duration="350"
              >
                <path
                  class="visibility-map__path"
                  d={path}
                  pathLength="1"
                  marker-end={`url(#${id}-arrow)`}
                  data-visual-path
                />
                <circle
                  class="visibility-map__signal"
                  r="3.5"
                  aria-hidden="true"
                  data-visual-signal
                />
              </g>
            ))}

            <g class="visibility-map__node" data-activate-at={rowStart} data-stage={stageBase}>
              <rect x="30" y={row.y} width="198" height="70" />
              <text class="visibility-map__kicker" x="44" y={row.y + 20}>
                SURFACE {row.index}
              </text>
              <text class="visibility-map__label" x="44" y={row.y + 48}>
                Approved answer surface
              </text>
            </g>

            <g
              class="visibility-map__node visibility-map__node--observation"
              data-activate-at={rowStart + 500}
              data-stage={stageBase + 1}
            >
              <rect x="294" y={row.y} width="238" height="70" />
              <text class="visibility-map__kicker" x="308" y={row.y + 20}>
                OBSERVATION {row.index}
              </text>
              <text class="visibility-map__label" x="308" y={row.y + 47}>
                {observationLabel}
              </text>
            </g>

            <g
              class="visibility-map__node"
              data-activate-at={rowStart + 950}
              data-stage={stageBase + 2}
            >
              <rect x="638" y={row.y} width="178" height="70" />
              <text class="visibility-map__kicker" x="652" y={row.y + 20}>
                CITATION {row.index}
              </text>
              <text class="visibility-map__label" x="652" y={row.y + 47}>
                Visible citation record
              </text>
            </g>

            <g
              class="visibility-map__node"
              data-activate-at={rowStart + 1400}
              data-stage={stageBase + 3}
            >
              <rect x="902" y={row.y} width="188" height="70" />
              <text class="visibility-map__kicker" x="916" y={row.y + 20}>
                SOURCE {row.index}
              </text>
              <text class="visibility-map__label" x="916" y={row.y + 47}>
                Public source node
              </text>
            </g>
          </g>
        );
      })
    }

    <g class="visibility-map__boundary">
      <rect x="30" y="500" width="1060" height="34"></rect>
      <text x="46" y="522">SAMPLED + DATED OBSERVATIONS</text>
      <text x="1074" y="522" text-anchor="end">NOT A UNIVERSAL RANKING</text>
    </g>
  </svg>

  <ol class="visibility-map__mobile" aria-label="Four sampled answer-surface records">
    {
      rows.map((row, index) => {
        const rowStart = index * 1700;

        return (
          <li>
            <div class="visibility-map__mobile-head">
              <span class="evidence-label">Record {row.index} / sampled</span>
              <span>{observationLabel}</span>
            </div>
            <dl>
              <div data-activate-at={rowStart}>
                <dt>Surface</dt>
                <dd>Approved answer surface</dd>
              </div>
              <div data-activate-at={rowStart + 500}>
                <dt>Observation</dt>
                <dd>Dated run record</dd>
              </div>
              <div data-activate-at={rowStart + 950}>
                <dt>Citation</dt>
                <dd>Visible citation record</dd>
              </div>
              <div data-activate-at={rowStart + 1400}>
                <dt>Source</dt>
                <dd>Public source node</dd>
              </div>
            </dl>
          </li>
        );
      })
    }
  </ol>

  <figcaption>
    <span class="evidence-label">Evidence boundary</span>
    Each row is a record structure, not a claimed result. Findings belong to the agreed query set, access
    conditions and collection window.
  </figcaption>
</figure>
<LedgerVisualMotion />

<style>
  .visibility-map {
    margin: 0;
    border-block: 2px solid var(--ink);
    background: var(--paper-bright);
  }

  .visibility-map__header,
  .visibility-map figcaption {
    display: flex;
    padding: 0.8rem 0.9rem;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .visibility-map__header {
    border-bottom: 1px solid var(--rule);
  }

  .visibility-map__scope {
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .visibility-map__desktop {
    width: 100%;
    height: auto;
  }

  .visibility-map__columns text,
  .visibility-map__kicker,
  .visibility-map__boundary text {
    fill: var(--graphite);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .visibility-map__columns line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .visibility-map__path {
    fill: none;
    stroke: var(--green);
    stroke-width: 1.4;
  }

  .visibility-map__signal {
    fill: var(--green);
    opacity: 0;
    transition: opacity 100ms linear;
  }

  .visibility-map__arrow {
    fill: var(--green);
  }

  .visibility-map__node rect {
    fill: var(--paper-bright);
    stroke: var(--ink);
    stroke-width: 1;
    transition:
      fill 220ms ease,
      stroke 220ms ease;
  }

  .visibility-map__label {
    fill: var(--ink);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
  }

  .visibility-map__boundary rect {
    fill: var(--amber-pale);
    stroke: var(--amber);
    stroke-width: 1;
  }

  .visibility-map__boundary text {
    fill: var(--amber);
  }

  .visibility-map__mobile {
    display: none;
  }

  .visibility-map figcaption {
    border-top: 1px solid var(--rule);
    color: var(--graphite);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .visibility-map figcaption .evidence-label {
    flex: 0 0 auto;
    color: var(--amber);
  }

  .visibility-map.has-motion .visibility-map__node {
    opacity: 0.26;
    transition: opacity 220ms ease;
  }

  .visibility-map.has-motion .visibility-map__node.is-active {
    opacity: 1;
  }

  .visibility-map.has-motion .visibility-map__node.is-active rect {
    fill: var(--green-pale);
    stroke: var(--green-dark);
  }

  @media (max-width: 680px) {
    .visibility-map__header,
    .visibility-map figcaption {
      align-items: flex-start;
      flex-direction: column;
    }

    .visibility-map__desktop {
      display: none;
    }

    .visibility-map__mobile {
      display: block;
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .visibility-map__mobile > li {
      padding: 1rem 0.9rem 1.15rem;
      border-bottom: 1px solid var(--rule);
    }

    .visibility-map__mobile-head {
      display: flex;
      padding-bottom: 0.7rem;
      gap: 0.75rem;
      align-items: flex-start;
      justify-content: space-between;
      border-bottom: 1px solid var(--rule);
    }

    .visibility-map__mobile-head > span:last-child {
      color: var(--graphite);
      font-family: var(--font-mono);
      font-size: 0.58rem;
      line-height: 1.4;
      text-align: right;
      text-transform: uppercase;
    }

    .visibility-map__mobile dl {
      display: grid;
      margin: 0;
      grid-template-columns: 1fr 1fr;
    }

    .visibility-map__mobile dl > div {
      min-width: 0;
      padding: 0.75rem 0.6rem 0.25rem 0;
      transition:
        background 220ms ease,
        opacity 220ms ease;
    }

    .visibility-map__mobile dl > div:nth-child(even) {
      padding-left: 0.7rem;
      border-left: 1px solid var(--rule);
    }

    .visibility-map__mobile dt {
      color: var(--green-dark);
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .visibility-map__mobile dd {
      margin: 0.25rem 0 0;
      font-family: var(--font-display);
      font-size: 0.98rem;
      font-weight: 600;
      line-height: 1.2;
    }

    .visibility-map.has-motion .visibility-map__mobile dl > div {
      opacity: 0.28;
    }

    .visibility-map.has-motion .visibility-map__mobile dl > div.is-active {
      background: color-mix(in srgb, var(--green-pale) 50%, var(--paper-bright));
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .visibility-map *,
    .visibility-map *::before,
    .visibility-map *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0ms !important;
    }
  }
</style>
