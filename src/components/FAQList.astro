---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details data-event="faq_expand">
        <summary>{item.question}</summary>
        <div class="faq-list__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>
