---
import { topics } from '../data/topicArchitecture';
import { TrendingUp, Target, Search, Sparkles } from 'lucide-astro';
import LearnArrow from './LearnArrow.astro';

interface Props {
  heading?: string;
  current?: string;
  compact?: boolean;
}

const { heading = 'Four ways into the same growth system.', current } = Astro.props;

/* Per-area identity: distinct icon + abstract wash + accent. */
const areaMeta: Record<string, { icon: typeof TrendingUp; wash: string; note: string }> = {
  growth: {
    icon: TrendingUp,
    wash: 'radial-gradient(120% 90% at 12% 100%, color-mix(in srgb, var(--signal) 10%, transparent), transparent 55%)',
    note: 'Rising path, connected nodes',
  },
  'performance-marketing': {
    icon: Target,
    wash: 'radial-gradient(110% 100% at 90% 100%, color-mix(in srgb, var(--amber) 12%, transparent), transparent 60%)',
    note: 'Target and conversion path',
  },
  seo: {
    icon: Search,
    wash: 'radial-gradient(120% 100% at 10% 0%, color-mix(in srgb, var(--signal) 9%, transparent), transparent 58%)',
    note: 'Search window, page hierarchy',
  },
  'ai-search': {
    icon: Sparkles,
    wash: 'radial-gradient(130% 110% at 92% 0%, color-mix(in srgb, var(--mint-accent) 14%, transparent), transparent 58%)',
    note: 'Query, citation network, answer orbit',
  },
};
const fallbackMeta = areaMeta.seo!;
---

<section class="strategic-areas-v2" aria-labelledby="strategic-areas-heading">
  <div class="shell">
    <div class="strategic-areas-v2__head">
      <p class="eyebrow">Strategic areas</p>
      <h2 id="strategic-areas-heading">{heading}</h2>
    </div>
    <div class="area-grid">
      {
        topics.map((topic, i) => {
          const meta = areaMeta[topic.slug] ?? fallbackMeta;
          const Icon = meta!.icon;
          return (
            <a
              class:list={['dd-card', 'area-card', 'dd-stagger']}
              style={`--area-wash: ${meta.wash}; --card-i: ${i};`}
              href={`/${topic.slug}/`}
              aria-current={current === topic.slug ? 'page' : undefined}
              data-reveal-ignore
            >
              <span class="area-card__num" aria-hidden="true">
                {topic.index}
              </span>
              <span class="area-card__icon">
                <Icon strokeWidth={1.75} aria-hidden="true" />
              </span>
              <h3>{topic.label}</h3>
              <p>{topic.description}</p>
              <span class="dd-card__arrow">
                Explore <LearnArrow />
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .strategic-areas-v2 {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .strategic-areas-v2__head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .strategic-areas-v2__head h2 {
    max-width: 26ch;
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
  }
</style>
