---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Capabilities',
    label: 'Services',
    links: [
      { href: '/services/', label: 'All services' },
      { href: '/services/ai-search-visibility/', label: 'AI-search visibility' },
      { href: '/services/measurement-foundation/', label: 'Measurement foundation' },
      { href: '/methodology/', label: 'Methodology' },
      { href: '/contact/', label: 'Request a diagnostic' },
    ],
  },
  {
    heading: 'Evidence',
    label: 'Evidence and resources',
    links: [
      { href: '/work/', label: 'Work ledger' },
      { href: '/insights/', label: 'Insights' },
      { href: '/tools/', label: 'Free tools' },
      { href: '/downloads/ai-visibility-baseline-template.csv', label: 'Baseline template' },
      { href: '/about/', label: 'About' },
    ],
  },
  {
    heading: 'Trust',
    label: 'Legal and access',
    links: [
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
      { href: '/cookies/', label: 'Cookies' },
      { href: '/accessibility/', label: 'Accessibility' },
      { href: 'mailto:contact@datadecision.consulting', label: 'contact@datadecision.consulting' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-grid__brand">
      <a class="brand brand--footer" href="/">
        <span class="brand__word">DataDecision<small>Growth you can prove.</small></span>
      </a>
      <h2>Measurement-first AI-search visibility for B2B SaaS.</h2>
      <p class="small measure">
        Focused on AI-search visibility, measurement foundations and scoped implementation.
      </p>
    </div>
    {
      columns.map((column) => (
        <nav class="footer-nav" aria-label={column.label}>
          <h3>{column.heading}</h3>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="shell footer-bottom">
    <span>© {year} DataDecision. All rights reserved.</span>
    <span>Growth you can prove.</span>
  </div>
</footer>
