---
import { entityDefinition } from '../data/entityDefinition';
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Capabilities',
    label: 'Services',
    links: [
      { href: '/services/', label: 'All services' },
      { href: '/growth/', label: 'Growth' },
      { href: '/performance-marketing/', label: 'Performance marketing' },
      { href: '/seo/', label: 'SEO' },
      { href: '/ai-search/', label: 'AI search, AEO and GEO' },
      { href: '/contact/', label: 'Request a diagnostic' },
    ],
  },
  {
    heading: 'Evidence',
    label: 'Evidence and resources',
    links: [
      { href: '/work/', label: 'Work ledger' },
      { href: '/research/', label: 'Research' },
      { href: '/insights/', label: 'Insights' },
      { href: '/playbooks/', label: 'Playbooks' },
      { href: '/tools/', label: 'Free tools' },
      { href: '/methodology/', label: 'Methodology' },
      { href: '/concepts/', label: 'Canonical concepts' },
      { href: '/proof/', label: 'Proof architecture' },
    ],
  },
  {
    heading: 'Trust',
    label: 'Legal and access',
    links: [
      { href: '/why-datadecision/', label: 'Why Data Decision Consulting' },
      { href: '/ai-search-observatory/', label: 'AI observatory' },
      { href: '/scorecard/', label: 'Authority scorecard' },
      { href: '/paths/', label: 'Where to start' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
      { href: '/cookies/', label: 'Cookies' },
      { href: '/accessibility/', label: 'Accessibility' },
      { href: '/about/', label: 'About Data Decision Consulting' },
      { href: 'mailto:contact@datadecision.consulting', label: 'contact@datadecision.consulting' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-grid__brand">
      <a class="brand brand--footer" href="/">
        <span class="brand__word">Data Decision Consulting<small>Growth you can prove.</small></span
        >
      </a>
      <h2>{entityDefinition.description}</h2>
      <p class="small measure">{entityDefinition.oneLineFocus}</p>
    </div>
    {
      columns.map((column) => (
        <nav class="footer-nav" aria-label={column.label}>
          <h3>{column.heading}</h3>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="shell footer-bottom">
    <span>© {year} Data Decision Consulting. All rights reserved.</span>
    <span>Growth you can prove.</span>
  </div>
</footer>
