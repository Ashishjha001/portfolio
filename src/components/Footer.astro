---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Services',
    label: 'Services',
    links: [
      { href: '/services/', label: 'All services' },
      { href: '/services/seo/', label: 'SEO services (B2B SaaS)' },
      { href: '/services/ai-search-visibility/', label: 'AI search visibility' },
      { href: '/services/measurement-foundation/', label: 'GA4 & attribution' },
      { href: '/services/google-ads-management/', label: 'Google Ads management' },
      { href: '/services/meta-ads-management/', label: 'Meta Ads management' },
      { href: '/services/website-development-seo/', label: 'Website development' },
      { href: '/services/market-research/', label: 'Market research' },
      { href: '/contact/', label: 'Request a diagnostic' },
    ],
  },
  {
    heading: 'Locations',
    label: 'Locations served remotely',
    links: [
      { href: '/locations/', label: 'All locations' },
      { href: '/locations/surat/', label: 'Surat manufacturers & exporters' },
    ],
  },
  {
    heading: 'Evidence',
    label: 'Evidence and resources',
    links: [
      { href: '/work/', label: 'Work ledger' },
      { href: '/research/', label: 'Research' },
      { href: '/insights/', label: 'Insights' },
      { href: '/playbooks/', label: 'Playbooks' },
      { href: '/tools/', label: 'Free tools' },
      { href: '/methodology/', label: 'Methodology' },
      { href: '/concepts/', label: 'Canonical concepts' },
      { href: '/proof/', label: 'Proof architecture' },
    ],
  },
  {
    heading: 'Trust',
    label: 'Legal and access',
    links: [
      { href: '/why-datadecision/', label: 'Why Data Decision Consulting' },
      { href: '/ai-search-observatory/', label: 'AI observatory' },
      { href: '/scorecard/', label: 'Authority scorecard' },
      { href: '/paths/', label: 'Where to start' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
      { href: '/cookies/', label: 'Cookies' },
      { href: '/accessibility/', label: 'Accessibility' },
      { href: '/about/', label: 'About Data Decision Consulting' },
      { href: 'mailto:contact@datadecision.consulting', label: 'contact@datadecision.consulting' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-grid__brand">
      <a class="brand brand--footer" href="/">
        <span class="brand__word">Data Decision Consulting<small>Growth you can prove.</small></span
        >
      </a>
    </div>
    <div class="footer-grid__links">
      {
        columns.map((column) => (
          <nav class="footer-nav" aria-label={column.label}>
            <details>
              <summary>
                <span>{column.heading}</span>
                <span class="footer-nav__toggle" aria-hidden="true">
                  +
                </span>
              </summary>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
        ))
      }
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} Data Decision Consulting. All rights reserved.</span>
  </div>
</footer>

<script>
  const footerDesktop = window.matchMedia('(min-width: 720px)');

  const syncFooterNavigation = () => {
    document.querySelectorAll<HTMLDetailsElement>('.footer-nav details').forEach((group) => {
      group.open = footerDesktop.matches;
    });
  };

  syncFooterNavigation();
  footerDesktop.addEventListener('change', syncFooterNavigation);
</script>
