---
const endpoint = 'https://api.web3forms.com/submit';
const accessKey = '220c5ddb-418c-40bd-82f1-1766f5d8b393';
---

<form
  id="diagnostic-form"
  class="contact-form"
  action={endpoint || undefined}
  method="post"
  novalidate
  data-endpoint={endpoint}
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New Data Decision Consulting diagnostic request" />
  <input type="hidden" name="from_name" value="Data Decision Consulting website" />
  <input type="hidden" name="started_at" id="started-at" value="" />
  <input type="hidden" name="utm_source" id="utm-source" value="" />
  <input type="hidden" name="utm_medium" id="utm-medium" value="" />
  <input type="hidden" name="utm_campaign" id="utm-campaign" value="" />
  <input type="hidden" name="referrer" id="referrer" value="" />
  <div class="honeypot" hidden>
    <label for="company-fax">Leave this field empty</label>
    <input id="company-fax" name="company_fax" type="text" tabindex="-1" autocomplete="off" />
    <input name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="selected_service" id="selected-service" value="general-enquiry" />

  <p class="form-brief-line" data-brief-line hidden>
    <span class="evidence-label">Selected service:</span>
    <span data-brief-name></span>
  </p>
  <div class="form-grid">
    <div class="form-field form-field--full">
      <label for="service-selection">Service <span class="small">(change if needed)</span></label>
      <select id="service-selection" name="service_selection" data-service-select>
        <option value="general-enquiry">General enquiry</option>
        <option value="growth-strategy-measurement">Growth Strategy &amp; Measurement</option>
        <option value="web-seo-ai-visibility">SEO &amp; AI-Search Visibility (B2B SaaS)</option>
        <option value="paid-acquisition-performance">Paid Acquisition &amp; Performance</option>
        <option value="conversion-lifecycle-growth">Conversion &amp; Lifecycle Growth</option>
        <option value="ai-agent-development">AI Agent Development</option>
        <option value="ai-gpt-integrations">AI &amp; GPT Integrations</option>
      </select>
    </div>
    <div class="form-field">
      <label for="email">Work email <span aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="form-field">
      <label for="company">Company or website <span aria-hidden="true">*</span></label>
      <input id="company" name="company" type="text" autocomplete="organization" required />
    </div>
    <div class="form-field form-field--full">
      <label for="problem">What do you want to understand? <span aria-hidden="true">*</span></label>
      <textarea id="problem" name="problem" required aria-describedby="problem-help"></textarea>
      <small id="problem-help">
        The decision, dashboard disagreement or visibility question you need answered.
      </small>
    </div>
    <div class="form-field form-field--full">
      <label for="stack"
        >Analytics and CRM you use today <span class="small">(optional)</span></label
      >
      <input
        id="stack"
        name="stack"
        type="text"
        aria-describedby="stack-help"
        placeholder="GA4, Search Console, HubSpot, or not sure yet"
      />
      <small id="stack-help">Anything you have helps. "Not sure" is a fine answer.</small>
    </div>
    <div class="form-field form-field--full">
      <label class="form-check" for="consent">
        <input id="consent" name="consent" type="checkbox" required />
        <span
          >I agree that Data Decision Consulting may use this information to respond to my enquiry,
          as described in the <a href="/privacy/">Privacy Notice</a>.</span
        >
      </label>
    </div>
  </div>

  <div id="form-errors" class="form-status" role="alert" tabindex="-1"></div>
  <div class="button-row">
    <button class="button button--primary" type="submit">Send diagnostic brief</button>
    <p class="small">Ashish personally reviews each brief.</p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#diagnostic-form');
  const status = document.querySelector<HTMLElement>('#form-errors');
  const startedAt = Date.now();

  if (form && status) {
    const params = new URLSearchParams(window.location.search);
    const values: Record<string, string> = {
      'started-at': new Date(startedAt).toISOString(),
      'utm-source': params.get('utm_source') || '',
      'utm-medium': params.get('utm_medium') || '',
      'utm-campaign': params.get('utm_campaign') || '',
      referrer: document.referrer,
    };

    Object.entries(values).forEach(([id, value]) => {
      const input = document.getElementById(id) as HTMLInputElement | null;
      if (input) input.value = value;
    });

    /* Selected service: read ?service= from the URL, keep editable dropdown in sync */
    const serviceLabels: Record<string, string> = {
      'growth-strategy-measurement': 'Growth Strategy & Measurement',
      'web-seo-ai-visibility': 'SEO & AI-Search Visibility (B2B SaaS)',
      'paid-acquisition-performance': 'Paid Acquisition & Performance',
      'conversion-lifecycle-growth': 'Conversion & Lifecycle Growth',
      'ai-agent-development': 'AI Agent Development',
      'ai-gpt-integrations': 'AI & GPT Integrations',
    };
    const serviceSelect = document.getElementById('service-selection') as HTMLSelectElement | null;
    const hiddenService = document.getElementById('selected-service') as HTMLInputElement | null;
    const briefLine = document.querySelector<HTMLElement>('[data-brief-line]');
    const briefName = document.querySelector<HTMLElement>('[data-brief-name]');

    const syncService = (slug: string) => {
      const label = serviceLabels[slug];
      if (!serviceSelect || !hiddenService) return;
      if (!label) return;
      serviceSelect.value = slug;
      hiddenService.value = slug;
      if (briefLine && briefName) {
        briefName.textContent = label;
        briefLine.hidden = false;
      }
    };

    const initialService = params.get('service');
    if (initialService && serviceLabels[initialService]) {
      syncService(initialService);
    }

    serviceSelect?.addEventListener('change', () => {
      const slug = serviceSelect.value;
      if (hiddenService) hiddenService.value = slug;
      if (!briefLine || !briefName) return;
      if (slug === 'general-enquiry' || !serviceLabels[slug]) {
        briefLine.hidden = true;
      } else {
        briefName.textContent = serviceLabels[slug];
        briefLine.hidden = false;
      }
    });

    let started = false;
    form.addEventListener('input', () => {
      if (!started) {
        started = true;
        window.ddTrack?.('lead_form_started', {
          path: window.location.pathname,
          form_id: form.id,
          service: serviceSelect?.value || 'general-enquiry',
        });
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.dataset.visible = 'false';

      if (!form.checkValidity()) {
        form.reportValidity();
        window.ddTrack?.('lead_form_validation_error', {
          path: window.location.pathname,
          form_id: form.id,
          error_type: 'required_or_invalid_field',
        });
        status.textContent = 'Please complete the required fields and correct any invalid values.';
        status.dataset.tone = 'error';
        status.dataset.visible = 'true';
        status.focus();
        return;
      }

      const data = new FormData(form);
      if (String(data.get('company_fax') || '').trim()) return;
      if (Date.now() - startedAt < 2500) {
        status.textContent = 'Please take a moment to review your brief before sending it.';
        status.dataset.tone = 'error';
        status.dataset.visible = 'true';
        status.focus();
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        window.ddTrack?.('lead_form_submit_error', {
          path: window.location.pathname,
          form_id: form.id,
          error_type: 'missing_endpoint',
        });
        status.textContent =
          'Form delivery is temporarily unavailable. Please email contact@datadecision.consulting instead.';
        status.dataset.tone = 'error';
        status.dataset.visible = 'true';
        status.focus();
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) {
        submit.disabled = true;
        submit.dataset.state = 'sending';
        submit.textContent = 'Sending brief…';
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as { success?: boolean };
        if (!response.ok || result.success !== true) {
          throw new Error(`Submission failed with ${response.status}`);
        }
        form.reset();
        status.textContent =
          'Thanks, your brief has been sent. Ashish will review it and reply by email.';
        status.dataset.tone = 'success';
        status.dataset.visible = 'true';
        window.ddTrack?.('lead_form_submitted', {
          path: window.location.pathname,
          form_id: form.id,
          service: String(data.get('selected_service') || 'general-enquiry'),
        });
      } catch {
        window.ddTrack?.('lead_form_submit_error', {
          path: window.location.pathname,
          form_id: form.id,
          error_type: 'delivery_failure',
        });
        status.replaceChildren(
          document.createTextNode('We couldn’t send your brief. Please try again or email '),
        );
        const emailLink = document.createElement('a');
        emailLink.href = 'mailto:contact@datadecision.consulting';
        emailLink.textContent = 'contact@datadecision.consulting';
        status.append(emailLink, '.');
        status.dataset.tone = 'error';
        status.dataset.visible = 'true';
      } finally {
        if (submit) {
          submit.disabled = false;
          delete submit.dataset.state;
          submit.textContent = 'Send diagnostic brief';
        }
        status.focus();
      }
    });
  }
</script>
