---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}

const { title, description, path, updated } = Astro.props;
---

<BaseLayout title={`${title} | DataDecision`} description={description} path={path}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy">
      <p class="eyebrow">Site policy</p><h1>{title}</h1><p class="lede">{description}</p>
    </div>
    <aside class="page-hero__aside">
      <div class="folio"><span>Last updated</span><span>{updated}</span></div>
      <p class="lede">Clear terms for using the website and contacting DataDecision.</p>
    </aside>
  </header>
  <div class="shell article-shell">
    <aside class="article-meta">
      <dl>
        <div><dt>Updated</dt><dd>{updated}</dd></div><div><dt>Owner</dt><dd>DataDecision</dd></div>
      </dl>
    </aside><article class="prose"><slot /></article><aside class="article-aside">
      <div class="article-aside__box">
        <p class="evidence-label">Questions</p><p>
          Email contact@datadecision.consulting if you need clarification about this policy.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
