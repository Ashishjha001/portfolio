---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCTA from '../components/FinalCTA.astro';

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const { data } = entry;
const articleUrl = `/insights/${entry.id}/`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(
    date,
  );
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.publishedDate.toISOString(),
    dateModified: data.updatedDate.toISOString(),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@type': 'Organization', name: 'DataDecision' },
    mainEntityOfPage: `https://datadecision.consulting${articleUrl}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://datadecision.consulting/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Insights',
        item: 'https://datadecision.consulting/insights/',
      },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---

<BaseLayout
  title={`${data.title} — DataDecision`}
  description={data.description}
  path={articleUrl}
  type="article"
  schema={schema}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Insights', href: '/insights/' },
      { label: data.title },
    ]}
  />
  <header class="shell page-hero page-hero--compact">
    <div class="page-hero__copy">
      <p class="eyebrow">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
    </div>
    <aside class="page-hero__aside">
      <div class="folio"><span>Research note</span><span>{data.readingMinutes} min read</span></div>
      <dl class="evidence-list">
        <div class="evidence-line">
          <dt class="evidence-label">Published</dt>
          <dd>
            <strong>{formatDate(data.publishedDate)}</strong><small>Public release date</small>
          </dd>
        </div>
        <div class="evidence-line">
          <dt class="evidence-label">Updated</dt>
          <dd>
            <strong>{formatDate(data.updatedDate)}</strong><small
              >Technical claims checked on this date</small
            >
          </dd>
        </div>
        <div class="evidence-line">
          <dt class="evidence-label">Byline</dt>
          <dd>
            <strong>{data.author}</strong><small
              >Organizational authorship; founder identity pending publication approval</small
            >
          </dd>
        </div>
      </dl>
    </aside>
  </header>
  <div class="shell article-shell">
    <aside class="article-meta" aria-label="Article metadata">
      <dl>
        <div><dt>Category</dt><dd>{data.category}</dd></div>
        <div><dt>Updated</dt><dd>{formatDate(data.updatedDate)}</dd></div>
        {
          data.methodologyVersion && (
            <div>
              <>
                <dt>Method</dt>
                <dd>{data.methodologyVersion}</dd>
              </>
            </div>
          )
        }
        <div><dt>Evidence</dt><dd>{data.sources.length} primary sources</dd></div>
      </dl>
    </aside>
    <article class="prose"><slot /></article>
    <aside class="article-aside">
      <div class="article-aside__box">
        <p class="evidence-label">Reading rule</p>
        <p>
          Keep dates, samples and limitations attached when citing this note. Platform behavior
          changes.
        </p>
        <a class="text-link" href="/methodology/">Read the method</a>
      </div>
    </aside>
  </div>
  <FinalCTA heading="Need the baseline run for you?" />
</BaseLayout>
