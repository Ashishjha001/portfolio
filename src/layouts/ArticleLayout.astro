---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCTA from '../components/FinalCTA.astro';

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const { data } = entry;
const articleUrl = `/insights/${entry.id}/`;
const canonicalUrl = `https://datadecision.consulting${articleUrl}`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(
    date,
  );

const clusterEntries = data.cluster
  ? (await getCollection('insights'))
      .filter((candidate) => candidate.data.cluster === data.cluster)
      .sort((a, b) => {
        if (a.data.pillar !== b.data.pillar) return a.data.pillar ? -1 : 1;
        return a.data.title.localeCompare(b.data.title);
      })
  : [];
const pillarEntry = clusterEntries.find((candidate) => candidate.data.pillar);
const relatedEntries = clusterEntries.filter(
  (candidate) => candidate.id !== entry.id && !candidate.data.pillar,
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.publishedDate.toISOString(),
    dateModified: data.updatedDate.toISOString(),
    author: {
      '@type': 'Organization',
      name: data.author,
      url: 'https://datadecision.consulting/about/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'DataDecision',
      url: 'https://datadecision.consulting/',
    },
    mainEntityOfPage: canonicalUrl,
    url: canonicalUrl,
    image: 'https://datadecision.consulting/og-default.png',
    articleSection: data.cluster ?? data.category,
    isPartOf: data.cluster
      ? {
          '@type': 'CollectionPage',
          name: data.cluster,
          url: 'https://datadecision.consulting/insights/',
        }
      : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://datadecision.consulting/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Insights',
        item: 'https://datadecision.consulting/insights/',
      },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={`${data.seoTitle ?? data.title} — DataDecision`}
  description={data.description}
  path={articleUrl}
  type="article"
  schema={schema}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.publishedDate.toISOString()} />
    <meta property="article:modified_time" content={data.updatedDate.toISOString()} />
    <meta property="article:section" content={data.cluster ?? data.category} />
  </Fragment>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Insights', href: '/insights/' },
      { label: data.title },
    ]}
  />
  <header class="shell page-hero page-hero--compact article-hero">
    <div class="page-hero__copy">
      <p class="eyebrow">{data.cluster ?? data.category}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
    </div>
    <aside class="page-hero__aside">
      <div class="folio">
        <span>{data.pillar ? 'Foundational guide' : 'Research note'}</span>
        <span>{data.readingMinutes} min read</span>
      </div>
      <dl class="evidence-list">
        <div class="evidence-line">
          <dt class="evidence-label">Published</dt>
          <dd>
            <strong>{formatDate(data.publishedDate)}</strong><small>Public release date</small>
          </dd>
        </div>
        <div class="evidence-line">
          <dt class="evidence-label">Updated</dt>
          <dd>
            <strong>{formatDate(data.updatedDate)}</strong><small
              >Technical claims checked on this date</small
            >
          </dd>
        </div>
        <div class="evidence-line">
          <dt class="evidence-label">Publisher</dt>
          <dd>
            <strong>{data.author}</strong><small>Organizational publisher</small>
          </dd>
        </div>
      </dl>
    </aside>
  </header>
  <div class="shell article-shell">
    <aside class="article-meta" aria-label="Article metadata">
      <dl>
        <div><dt>Cluster</dt><dd>{data.cluster ?? data.category}</dd></div>
        <div><dt>Published</dt><dd>{formatDate(data.publishedDate)}</dd></div>
        <div><dt>Updated</dt><dd>{formatDate(data.updatedDate)}</dd></div>
        {
          data.methodologyVersion && (
            <div>
              <dt>Method</dt>
              <dd>{data.methodologyVersion}</dd>
            </div>
          )
        }
        <div><dt>Sources</dt><dd>{data.sources.length} official references</dd></div>
      </dl>
    </aside>
    <article class="prose">
      <slot />
      {
        data.sources.length > 0 && (
          <section class="article-sources" aria-labelledby="article-sources-heading">
            <p class="eyebrow">Primary references</p>
            <h2 id="article-sources-heading">Sources</h2>
            <ul>
              {data.sources.map((source) => (
                <li>
                  <a href={source.url}>{source.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        data.cluster && pillarEntry && (
          <section class="cluster-explore" aria-labelledby="cluster-explore-heading">
            <p class="eyebrow">{data.cluster}</p>
            <h2 id="cluster-explore-heading">
              Continue exploring Measurement &amp; Lead-Source Truth
            </h2>
            {pillarEntry.id === entry.id ? (
              <div class="cluster-foundation" aria-current="page">
                <span class="evidence-label">Foundational guide / current article</span>
                <strong>{pillarEntry.data.title}</strong>
              </div>
            ) : (
              <a class="cluster-foundation" href={`/insights/${pillarEntry.id}/`}>
                <span class="evidence-label">Foundational guide</span>
                <strong>{pillarEntry.data.title}</strong>
                <span>Start with the complete reconciliation framework.</span>
              </a>
            )}
            {relatedEntries.length > 0 && (
              <ul class="cluster-links">
                {relatedEntries.map((candidate) => (
                  <li>
                    <a href={`/insights/${candidate.id}/`}>{candidate.data.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }
    </article>
    <aside class="article-aside">
      <div class="article-aside__box">
        <p class="evidence-label">Reading rule</p>
        <p>Use each system for the question it can answer, then reconcile the joins.</p>
        <a class="text-link" href="/services/measurement-foundation/">Measurement foundation</a>
      </div>
    </aside>
  </div>
  <FinalCTA
    heading="Need to reconcile your marketing data?"
    body="Request a measurement brief. We will confirm the question, required inputs and evidence boundary before scoping the work."
    label="Request a measurement brief"
  />
</BaseLayout>
