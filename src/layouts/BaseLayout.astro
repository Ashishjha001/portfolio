---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationSchema, websiteSchema, entityDefinition } from '../data/entityDefinition';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? Astro.url.origin).toString();
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin).toString();
const schemaItems = schema
  ? Array.isArray(schema)
    ? [organizationSchema, websiteSchema, ...schema]
    : [organizationSchema, websiteSchema, schema]
  : [organizationSchema, websiteSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduced-motion');
      }
    </script>
    <!-- Google Tag Manager: loads only on the production host; the runtime
         guard below keeps localhost, previews and staging completely clean. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        var host = window.location.hostname;
        if (host !== 'datadecision.consulting' && host !== 'www.datadecision.consulting') {
          return;
        }
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-NJPG9FPZ');
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F7F3EA" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon-datadecision.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Data Decision Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {
      schemaItems.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    {
      /* No GTM <noscript> fallback in this experimental build: static frames
         cannot runtime-check the host, so they could fire on localhost. */
    }
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <Footer />
    <button class="to-top" type="button" aria-label="Back to top" data-to-top hidden>↑</button>
    <script is:inline>
      window.dataDecisionEvents = window.dataDecisionEvents || [];
      window.ddTrack = function (name, detail) {
        const event = { name, detail: detail || {}, timestamp: new Date().toISOString() };
        window.dataDecisionEvents.push(event);
        window.dispatchEvent(new CustomEvent('datadecision:event', { detail: event }));
      };
      document.addEventListener('click', function (event) {
        const target = event.target.closest('[data-event]');
        if (!target) return;
        window.ddTrack(target.dataset.event, {
          label: target.textContent.trim(),
          path: window.location.pathname,
        });
      });
      document.addEventListener(
        'toggle',
        function (event) {
          const target = event.target;
          if (target instanceof HTMLDetailsElement && target.open && target.dataset.event) {
            window.ddTrack(target.dataset.event, {
              label: target.querySelector('summary')?.textContent?.trim() || '',
              path: window.location.pathname,
            });
          }
        },
        true,
      );

      /* Scroll progress spine (paused while the tab is hidden) */
      (function () {
        var bar = document.querySelector('.scroll-progress__bar');
        if (!bar) return;
        var frame;
        var update = function () {
          frame = undefined;
          var doc = document.documentElement;
          var max = doc.scrollHeight - window.innerHeight;
          var value = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          bar.style.transform = 'scaleX(' + value + ')';
        };
        var onScroll = function () {
          if (!frame && !document.hidden) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) update();
        });
        update();
      })();

      /* Hero arrival: start the one-shot network sequence after first paint */
      (function () {
        var hero = document.querySelector('.hero');
        if (!hero) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (reduced.matches) {
          hero.classList.add('is-arrived');
          return;
        }
        var start = function () {
          requestAnimationFrame(function () {
            hero.classList.add('is-arrived');
          });
        };
        if (document.readyState === 'complete') start();
        else window.addEventListener('load', start, { once: true });
      })();

      /* Diagnostic numerals count up once, on view; final values stay in markup */
      (function () {
        var card = document.querySelector('.scope-card');
        if (!card) return;
        var nums = card.querySelectorAll('[data-count]');
        if (!nums.length) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (reduced.matches || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(
          function (entries) {
            if (!entries[0].isIntersecting) return;
            io.disconnect();
            Array.prototype.forEach.call(nums, function (el) {
              var target = parseInt(el.getAttribute('data-count'), 10);
              var pad = parseInt(el.getAttribute('data-pad') || '0', 10);
              var out = el.querySelector('.scope-num__value');
              if (!out) return;
              var t0 = null;
              var step = function (ts) {
                if (t0 === null) t0 = ts;
                var progress = Math.min((ts - t0) / 800, 1);
                var eased = 1 - Math.pow(1 - progress, 3);
                out.textContent = String(Math.round(eased * target)).padStart(pad, '0');
                if (progress < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            });
          },
          { threshold: 0.4 },
        );
        io.observe(card);
      })();

      /* Header surface state: keep the fixed bar legible over light sections */
      (function () {
        var header = document.querySelector('[data-site-header]');
        if (!header) return;
        var frame;
        var update = function () {
          frame = undefined;
          header.classList.toggle('is-scrolled', window.scrollY > 24);
        };
        var onScroll = function () {
          if (!frame) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      })();

      /* Reveal-on-scroll: IO handles the normal case; a rAF sweep is the
         safety net for fast flings that jump tall wrappers past the
         viewport between two IO frames. */
      (function () {
        var items = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        if (!items.length) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (reduced.matches) {
          items.forEach(function (item) {
            item.classList.add('is-revealed');
          });
          return;
        }
        var pending = new Set(items);
        var isMobile = window.matchMedia('(max-width: 767px)').matches;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting || entry.boundingClientRect.bottom < 0) {
                reveal(entry.target);
              }
            });
          },
          {
            threshold: 0.05,
            rootMargin: isMobile ? '0px 0px 4% 0px' : '0px 0px -6% 0px',
          },
        );
        var reveal = function (el) {
          if (!pending.has(el)) return;
          pending.delete(el);
          el.classList.add('is-revealed');
          observer.unobserve(el);
          if (!pending.size) detach();
        };
        items.forEach(function (item) {
          observer.observe(item);
        });
        var frame;
        var sweep = function () {
          frame = undefined;
          if (!pending.size) return;
          var limit = window.innerHeight * 0.96;
          Array.from(pending).forEach(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.top < limit || rect.bottom < 0) reveal(el);
          });
        };
        var onScroll = function () {
          if (!frame) frame = requestAnimationFrame(sweep);
        };
        var detach = function () {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
          observer.disconnect();
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
      })();

      const mobileCta = document.querySelector('[data-mobile-cta]');
      if (mobileCta) {
        let ctaFrame;
        const updateMobileCta = () => {
          mobileCta.hidden = window.scrollY < Math.min(window.innerHeight * 0.75, 640);
          ctaFrame = undefined;
        };
        updateMobileCta();
        window.addEventListener(
          'scroll',
          () => {
            if (!ctaFrame) ctaFrame = requestAnimationFrame(updateMobileCta);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
